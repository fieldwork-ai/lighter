/target
**/*.rs.bk
*.pdb

# Guest build artifacts — kernels, rootfs images, and the toolchain caches that
# produce them. All reproducible from guest/, none belong in git.
/guest/build/
/guest/out/
/guest/src/
*.img
*.qcow2
Image
vmlinux
initramfs*.cpio*

# Benchmark output: the committed results live in benchmarks/results/, raw runs
# do not.
/benchmarks/raw/

# The GPU renderer's sources, tools and the libraries they produce: host/gpu/build.sh.
/host/build/
/host/out/

.DS_Store
.context/

# Release archives
/dist/

# Gate and build logs. Every gate writes here, so this is a directory rule
# rather than a list of filenames that the next gate would immediately outgrow.
.logs/
results/*-boot.log

# Benchmark scratch. Results are committed; the VMM log a run leaves behind is
# not, and neither is the fixture's installed tree.
benchmarks/results/*-boot.log

# The speed gate's own measurements, never the record.
benchmarks/results/gate-*.csv

# Raw release qualification evidence stays local, not in Git or release assets.
/docs/records/
/benchmarks/records/
/benchmarks/results/**/*.log
/benchmarks/results/**/*.gz
/benchmarks/results/**/*.jsonl
/benchmarks/results/**/*.json
!/benchmarks/results/selection.json
!/benchmarks/results/machines/*/selection.json
# Retained published CSVs are tracked explicitly; new scratch runs stay local.
/benchmarks/results/**/*.csv
/benchmarks/results/**/*.tree
/guest/rootfs/lighter-agent
/guest/rootfs/liblighter_ane_ep.so
/guest/rootfs/wheels/

# Guest-side build trees and their outputs: the plugin provider's cargo
# target, the torch extension's build directory and compiled module, and
# Python's bytecode caches. What ships is built into guest/out.
/guest/ane-ep/target/
/guest/torch-mps/build/
/guest/torch-mps/lighter_mps/*.so
__pycache__/
*.pyc
benchmarks/RESULTS.md
