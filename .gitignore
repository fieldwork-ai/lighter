/target
**/*.rs.bk
*.pdb

# Guest build artifacts — kernels, rootfs images, and the toolchain caches that
# produce them. All reproducible from guest/, none belong in git.
/guest/build/
/guest/out/
/guest/src/
*.img
*.qcow2
Image
vmlinux
initramfs*.cpio*

# Benchmark output: the committed results live in benchmarks/results/, raw runs
# do not.
/benchmarks/raw/

.DS_Store
.context/

# The gvproxy sidecar, fetched by scripts/fetch-gvproxy.sh rather than vendored.
vendor/

# Gate and build logs. Every gate writes here, so this is a directory rule
# rather than a list of filenames that the next gate would immediately outgrow.
.logs/
results/*-boot.log

# Benchmark scratch. Results are committed; the VMM log a run leaves behind is
# not, and neither is the fixture's installed tree.
benchmarks/results/*-boot.log
