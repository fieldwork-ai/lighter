+    #[test]
+    #[ignore = "requires a signed test binary and Hypervisor.framework"]
+    fn hybrid_mapping_batches_skip_live_chunks_and_include_partial_tails() {
+        let vm = Arc::new(Vm::create().unwrap());
+        let mut mem = GuestMemory::new(vm);
+        let base = 0x4000_0000;
+        let page = host_page_size() as usize;
+        let batch = BACKGROUND_CHUNKS * DEMAND_CHUNK;
+        mem.reserve_demand_region(base, 2 * batch + page).unwrap();
+        let live = base + 3 * DEMAND_CHUNK as u64;
+        PREPARE_SPANS.with(|spans| spans.borrow_mut().clear());
+        mem.write_u64(live, 0xfeed).unwrap();
+        PREPARE_SPANS.with(|spans| {
+            assert_eq!(*spans.borrow(), vec![(live, DEMAND_CHUNK)]);
+            spans.borrow_mut().clear();
+        });
+        mem.prepare_remaining(&AtomicBool::new(false)).unwrap();
+        PREPARE_SPANS.with(|spans| {
+            assert_eq!(
+                *spans.borrow(),
+                vec![
+                    (base, 3 * DEMAND_CHUNK),
+                    (base + 4 * DEMAND_CHUNK as u64, 4 * DEMAND_CHUNK),
+                    (base + batch as u64, batch),
+                    (base + 2 * batch as u64, page),
+                ]
+            );
+        });
+        assert_eq!(mem.read_u64(live).unwrap(), 0xfeed);
+        assert_eq!(mem.read_u64(base + 2 * batch as u64).unwrap(), 0);
+    }
