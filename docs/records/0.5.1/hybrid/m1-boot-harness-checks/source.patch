 	boot_start
 	if boot_await_docker "$t0"; then
-		wait "$START_PID" 2>/dev/null || true
+		wait "$BOOT_START_PID" 2>/dev/null || true
+		BOOT_START_PID=""
 		sleep 60
 		[ "$TARGET" != lighter ] || VMM_PID="$(cat "$BOOT_HOME/lighter.pid" 2>/dev/null)"
 		local idle
