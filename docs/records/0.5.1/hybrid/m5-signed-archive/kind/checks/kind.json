{
  "kind": "Cluster",
  "apiVersion": "kind.x-k8s.io/v1alpha4",
  "networking": {
    "apiServerAddress": "127.0.0.1",
    "kubeProxyMode": "iptables"
  },
  "nodes": [
    {
      "role": "control-plane",
      "extraPortMappings": [
        {
          "containerPort": 30080,
          "hostPort": 58685,
          "listenAddress": "127.0.0.1"
        },
        {
          "containerPort": 30081,
          "hostPort": 59997,
          "listenAddress": "127.0.0.1",
          "protocol": "UDP"
        }
      ],
      "extraMounts": [
        {
          "hostPath": "$HOME/git/lighter/.logs/051/hybrid-final/m5-archive-a1/kind/checks/share",
          "containerPath": "/host-fixture"
        }
      ]
    },
    {
      "role": "worker",
      "extraMounts": [
        {
          "hostPath": "$HOME/git/lighter/.logs/051/hybrid-final/m5-archive-a1/kind/checks/share",
          "containerPath": "/host-fixture"
        }
      ]
    }
  ]
}