diff --git a/ggml/src/ggml-rpc/transport.cpp b/ggml/src/ggml-rpc/transport.cpp
index 5ec15dc80..cc6964853 100644
--- a/ggml/src/ggml-rpc/transport.cpp
+++ b/ggml/src/ggml-rpc/transport.cpp
@@ -600,6 +600,10 @@ socket_t::socket_t(std::unique_ptr<impl> p) : pimpl(std::move(p)) {}
 
 socket_t::~socket_t() = default;
 
+socket_ptr socket_t::from_fd(int fd) {
+    return socket_ptr(new socket_t(std::make_unique<impl>((sockfd_t) fd)));
+}
+
 bool socket_t::send_data(const void * data, size_t size) {
     return pimpl->send_data(data, size);
 }
