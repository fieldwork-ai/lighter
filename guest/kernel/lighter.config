# Kernel configuration fragment for the lighter guest.
#
# Merged over arm64 defconfig. The goal is a monolithic kernel that boots fast
# and carries exactly what a container host needs: virtio transport, the
# filesystems Docker's storage drivers use, and the namespace/cgroup/netfilter
# machinery the engine assumes. Everything else defconfig enables for real
# hardware is dead weight in a VM — it costs build time, image size, and probe
# time on every boot.

# --- No modules -----------------------------------------------------------
# One image, nothing to load, no initramfs module dance, no module-signing
# surface. Every driver below is built in.
CONFIG_MODULES=n

# --- Page size ------------------------------------------------------------
# 4K, not 16K. Rosetta's Linux runtime requires a 4K kernel, and this is not a
# decision that can be revisited later without invalidating amd64 support.
CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM64_VA_BITS_48=y

# --- Console --------------------------------------------------------------
# PL011 is what earlycon speaks before any real driver is up. Without it a
# kernel that dies during early boot dies silently, which is the single most
# expensive way to debug a VMM.
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y

# --- virtio ---------------------------------------------------------------
# MMIO transport rather than PCI: no PCI host bridge to model, no enumeration,
# and the device set is fixed at boot from the device tree.
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_FS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_VSOCKETS=y
CONFIG_VSOCKETS_DIAG=y
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_INPUT=n
CONFIG_HW_RANDOM_VIRTIO=y

# --- Memory reclaim -------------------------------------------------------
# Free page reporting is what lets the balloon hand pages back without the
# guest first touching them; it is the mechanism behind "memory returns to
# macOS after a build finishes".
CONFIG_PAGE_REPORTING=y
CONFIG_MEMORY_BALLOON=y
# CONFIG_BALLOON_COMPACTION is not set
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y

# --- Filesystems ----------------------------------------------------------
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_OVERLAY_FS=y
CONFIG_OVERLAY_FS_REDIRECT_DIR=y
CONFIG_OVERLAY_FS_METACOPY=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_AUTOFS_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y

# --- Containers: namespaces and cgroups -----------------------------------
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_BPF=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_KEYS=y

# --- Networking core ------------------------------------------------------
# All of these are in arm64 defconfig, and all of them are stated anyway,
# because they are load-bearing: PACKET is the raw socket the DHCP client sends
# its DISCOVER on, and a kernel without it produces a link that is up, has no
# address, and reports no error anywhere.
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_NETDEVICES=y
CONFIG_IPV6=y

# --- Containers: networking -----------------------------------------------
# Docker's default bridge networking needs bridge + veth + iptables NAT; the
# engine fails at daemon start without them, not at first container.
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_VETH=y
CONFIG_MACVLAN=y
CONFIG_IPVLAN=y
CONFIG_DUMMY=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_CHAIN_NAT=y

# The bridge between the two iptables worlds. Modern distributions ship
# iptables built on nf_tables, which implements classic targets by asking
# nft_compat to load the xtables extension. Without this the rule Docker needs
# most is rejected as "Extension MASQUERADE revision 0 not supported, missing
# kernel module?" — and dockerd exits, having already created its socket, so
# the symptom downstream is a connection refused with no explanation.
CONFIG_NFT_COMPAT=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
# dockerd deletes a container's conntrack entries over netlink when it goes
# ("Failed to delete conntrack state: invalid argument" twice per container
# without this), and probes for IPsec support at every start for its overlay
# driver, a tenth of a second of failing probes without these.
CONFIG_NF_CT_NETLINK=y
CONFIG_XFRM_USER=y
CONFIG_INET_ESP=y
CONFIG_INET_AH=y
CONFIG_INET_XFRM_TUNNEL=y
CONFIG_NETFILTER_XT_MATCH_IPVS=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP_VS=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y

# --- binfmt_misc ----------------------------------------------------------
# The hook Rosetta registers through to run amd64 binaries.
CONFIG_BINFMT_MISC=y
CONFIG_BINFMT_ELF=y
CONFIG_COMPAT=n

# --- Trim the hardware we will never have ---------------------------------
# A VM has no PCI bus, no USB, no sound, no display, no wireless, no SCSI
# controller, and no ATA. Each of these is both build time and boot-time probe
# time.
CONFIG_PCI=n
CONFIG_USB_SUPPORT=n
CONFIG_SOUND=n
CONFIG_DRM=n
CONFIG_FB=n
CONFIG_WLAN=n
CONFIG_WIRELESS=n
CONFIG_BT=n
CONFIG_ATA=n
CONFIG_SCSI=n
CONFIG_MD=n
CONFIG_INPUT_MOUSEDEV=n
CONFIG_INPUT_JOYSTICK=n
CONFIG_INPUT_TABLET=n
CONFIG_INPUT_TOUCHSCREEN=n
CONFIG_MEDIA_SUPPORT=n
CONFIG_HID=n
CONFIG_I2C=n
CONFIG_SPI=n
CONFIG_MMC=n
CONFIG_MTD=n
CONFIG_STAGING=n
CONFIG_NFS_FS=n
CONFIG_XFS_FS=y
CONFIG_XFS_POSIX_ACL=y
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y

# --- Boot speed -----------------------------------------------------------
# No ramdisk driver (we use an initramfs, which is different), no kernel
# compression to decompress (we load an uncompressed Image), no probing delays.
CONFIG_BLK_DEV_RAM=n
CONFIG_RD_GZIP=y
CONFIG_RD_BZIP2=n
CONFIG_RD_LZMA=n
CONFIG_RD_XZ=n
CONFIG_RD_LZO=n
CONFIG_RD_LZ4=n
CONFIG_RD_ZSTD=n
CONFIG_BLK_DEV_INITRD=y
# btrfs pulls in the raid6 library, whose boot-time benchmark of nine
# algorithms took 0.55 s of a 0.65 s kernel boot (sixteen jiffies each at
# HZ=250). Off, it takes the first NEON implementation, which the benchmark
# was choosing within a few percent anyway.
CONFIG_RAID6_PQ_BENCHMARK=n

# --- Debuggability --------------------------------------------------------
# Keep the panic path talkative: a VMM bug usually presents as a guest that
# dies early, and the difference between a stack trace and a hang is hours.
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_DEBUG_KERNEL=y
CONFIG_PANIC_TIMEOUT=0
CONFIG_MAGIC_SYSRQ=y
# ... but not the expensive checks that would tax every benchmark we publish.
CONFIG_DEBUG_INFO=n
CONFIG_DEBUG_INFO_NONE=y
CONFIG_KALLSYMS=y
CONFIG_FTRACE=n
CONFIG_KPROBES=n
CONFIG_GCOV_KERNEL=n
CONFIG_KASAN=n
CONFIG_LOCKDEP=n
CONFIG_PROVE_LOCKING=n
CONFIG_DEBUG_PAGEALLOC=n
CONFIG_PROC_KCORE=y

# Docker's networking is iptables, and 6.18's defconfig turned the legacy
# xtables front end off. Every option here fell out of the config at that
# bump and took the compose gate with it; the required-list check in
# build-kernel.sh now watches the load-bearing ones.
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_IP6_NF_TARGET_REJECT=y
CONFIG_NF_REJECT_IPV6=y
CONFIG_NETFILTER_XT_NAT=y
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y
CONFIG_PROC_PID_CPUSET=y

# The guest is a VM whose kernel we build, and every syscall pays for what is
# turned on here: measured against OrbStack's kernel with the same container,
# `perf bench syscall basic` was 0.108 µs against 0.097 and a tmpfs create
# storm ten percent slower, before any disk or share was involved. Full
# preemption, kernel pointer authentication, zeroing every stack frame, IRQ
# time accounting and audit each take a slice of the entry path or of every
# call; none serves a container host. SVE, SME and MTE state is never
# exposed by HVF and their support only widens the context switch.
# CONFIG_PREEMPT is not set
CONFIG_PREEMPT_VOLUNTARY=y
# CONFIG_ARM64_PTR_AUTH_KERNEL is not set
# CONFIG_INIT_STACK_ALL_ZERO is not set
CONFIG_INIT_STACK_NONE=y
# CONFIG_IRQ_TIME_ACCOUNTING is not set
# CONFIG_AUDIT is not set
CONFIG_BPF_JIT_ALWAYS_ON=y
# CONFIG_ARM64_SVE is not set
# CONFIG_ARM64_SME is not set
# CONFIG_ARM64_MTE is not set
# The stream backend's redirect rule matches on the routing decision itself
# (`fib daddr oif "eth0"`): anything that would leave through the network
# device goes to the agent, and nothing bound for a container, a bridge or
# this machine does, with no list of subnets to keep in step with Docker.
CONFIG_NFT_FIB=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_NF_TPROXY_IPV4=y
CONFIG_NF_TPROXY_IPV6=y
CONFIG_NFT_TPROXY=y
CONFIG_NFT_SOCKET=y
CONFIG_NF_SOCKET_IPV4=y
CONFIG_NF_SOCKET_IPV6=y
