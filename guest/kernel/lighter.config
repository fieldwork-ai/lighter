# Kernel configuration fragment for the lighter guest.
#
# Merged over arm64 defconfig. The goal is a monolithic kernel that boots fast
# and carries exactly what a container host needs: virtio transport, the
# filesystems Docker's storage drivers use, and the namespace/cgroup/netfilter
# machinery the engine assumes. Everything else defconfig enables for real
# hardware is dead weight in a VM — it costs build time, image size, and probe
# time on every boot.

# --- No modules -----------------------------------------------------------
# One image, nothing to load, no initramfs module dance, no module-signing
# surface. Every driver below is built in.
CONFIG_MODULES=n

# --- Page size ------------------------------------------------------------
# 4K, not 16K. Rosetta's Linux runtime requires a 4K kernel, and this is not a
# decision that can be revisited later without invalidating amd64 support.
CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM64_VA_BITS_48=y

# --- Console --------------------------------------------------------------
# PL011 is what earlycon speaks before any real driver is up. Without it a
# kernel that dies during early boot dies silently, which is the single most
# expensive way to debug a VMM.
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y

# --- virtio ---------------------------------------------------------------
# MMIO transport rather than PCI: no PCI host bridge to model, no enumeration,
# and the device set is fixed at boot from the device tree.
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_FS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_VSOCKETS=y
CONFIG_VSOCKETS_DIAG=y
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_INPUT=n
CONFIG_HW_RANDOM_VIRTIO=y

# --- Memory reclaim -------------------------------------------------------
# Free page reporting is what lets the balloon hand pages back without the
# guest first touching them; it is the mechanism behind "memory returns to
# macOS after a build finishes".
CONFIG_PAGE_REPORTING=y
CONFIG_MEMORY_BALLOON=y
CONFIG_BALLOON_COMPACTION=y
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y

# --- Filesystems ----------------------------------------------------------
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_OVERLAY_FS=y
CONFIG_OVERLAY_FS_REDIRECT_DIR=y
CONFIG_OVERLAY_FS_METACOPY=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_AUTOFS_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y

# --- Containers: namespaces and cgroups -----------------------------------
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_BPF=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_KEYS=y

# --- Containers: networking -----------------------------------------------
# Docker's default bridge networking needs bridge + veth + iptables NAT; the
# engine fails at daemon start without them, not at first container.
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_VETH=y
CONFIG_MACVLAN=y
CONFIG_IPVLAN=y
CONFIG_DUMMY=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_CHAIN_NAT=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_IPVS=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP_VS=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y

# --- binfmt_misc ----------------------------------------------------------
# The hook Rosetta registers through to run amd64 binaries.
CONFIG_BINFMT_MISC=y
CONFIG_BINFMT_ELF=y
CONFIG_COMPAT=n

# --- Trim the hardware we will never have ---------------------------------
# A VM has no PCI bus, no USB, no sound, no display, no wireless, no SCSI
# controller, and no ATA. Each of these is both build time and boot-time probe
# time.
CONFIG_PCI=n
CONFIG_USB_SUPPORT=n
CONFIG_SOUND=n
CONFIG_DRM=n
CONFIG_FB=n
CONFIG_WLAN=n
CONFIG_WIRELESS=n
CONFIG_BT=n
CONFIG_ATA=n
CONFIG_SCSI=n
CONFIG_MD=n
CONFIG_INPUT_MOUSEDEV=n
CONFIG_INPUT_JOYSTICK=n
CONFIG_INPUT_TABLET=n
CONFIG_INPUT_TOUCHSCREEN=n
CONFIG_MEDIA_SUPPORT=n
CONFIG_HID=n
CONFIG_I2C=n
CONFIG_SPI=n
CONFIG_MMC=n
CONFIG_MTD=n
CONFIG_STAGING=n
CONFIG_NFS_FS=n
CONFIG_XFS_FS=n
CONFIG_BTRFS_FS=n

# --- Boot speed -----------------------------------------------------------
# No ramdisk driver (we use an initramfs, which is different), no kernel
# compression to decompress (we load an uncompressed Image), no probing delays.
CONFIG_BLK_DEV_RAM=n
CONFIG_RD_GZIP=y
CONFIG_RD_BZIP2=n
CONFIG_RD_LZMA=n
CONFIG_RD_XZ=n
CONFIG_RD_LZO=n
CONFIG_RD_LZ4=n
CONFIG_RD_ZSTD=n
CONFIG_BLK_DEV_INITRD=y

# --- Debuggability --------------------------------------------------------
# Keep the panic path talkative: a VMM bug usually presents as a guest that
# dies early, and the difference between a stack trace and a hang is hours.
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_DEBUG_KERNEL=y
CONFIG_PANIC_TIMEOUT=0
CONFIG_MAGIC_SYSRQ=y
# ... but not the expensive checks that would tax every benchmark we publish.
CONFIG_DEBUG_INFO=n
CONFIG_DEBUG_INFO_NONE=y
CONFIG_KALLSYMS=y
CONFIG_FTRACE=n
CONFIG_KPROBES=n
CONFIG_GCOV_KERNEL=n
CONFIG_KASAN=n
CONFIG_LOCKDEP=n
CONFIG_PROVE_LOCKING=n
CONFIG_DEBUG_PAGEALLOC=n
