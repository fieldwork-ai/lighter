+/* Whether this is the last skb the socket's stream will hand a reader:
+ * TCP marks it with the FIN, vsock queues a marker behind the data.
+ */
+static bool sk_psock_skb_eof(const struct sock *sk, const struct sk_buff *skb)
+{
+	if (sk_is_tcp(sk))
