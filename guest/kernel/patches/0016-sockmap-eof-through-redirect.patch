+/* The peer has shut down sending. A socket read through read_skb (a
+ * sockmap) learns of data only from the queue, so the end of the stream
+ * is queued there too, as a zero-length packet behind everything the peer
+ * sent; a socket read any other way gets nothing, and learns of the
+ * shutdown as it always did.
+ */
+static void virtio_transport_queue_eof(struct vsock_sock *vsk)
+{
+	struct virtio_vsock_sock *vvs = vsk->trans;
+	struct sock *sk = sk_vsock(vsk);
+	struct virtio_vsock_hdr *hdr;
+	struct sk_buff *skb;
+	bool wanted;
+
+	rcu_read_lock();
+	wanted = sk_psock(sk) != NULL;
+	rcu_read_unlock();
+	if (!wanted)
+		return;
+
+	skb = virtio_vsock_alloc_linear_skb(VIRTIO_VSOCK_SKB_HEADROOM, GFP_ATOMIC);
+	if (!skb)
+		return;
+	hdr = virtio_vsock_hdr(skb);
+	memset(hdr, 0, sizeof(*hdr));
+	hdr->op = cpu_to_le16(VIRTIO_VSOCK_OP_RW);
+	VIRTIO_VSOCK_SKB_CB(skb)->eof = true;
+	if (!skb_set_owner_sk_safe(skb, sk)) {
+		kfree_skb(skb);
+		return;
+	}
+
+	spin_lock_bh(&vvs->rx_lock);
+	__skb_queue_tail(&vvs->rx_queue, skb);
+	spin_unlock_bh(&vvs->rx_lock);
+	sk->sk_data_ready(sk);
+}
