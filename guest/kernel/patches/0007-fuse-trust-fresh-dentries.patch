fuse: trust a fresh positive dentry for O_EXCL, mkdir and rename targets

The driver re-looks-up a dentry it already holds, however fresh, whenever the
operation is an exclusive create, a mkdir or a rename target — in case the
server's world moved without telling it. This server tells it: every change
it learns of on the host withdraws the entry through the notification queue.
So under FUSE_LIGHTER_TRUST_DENTRIES a positive dentry still within its
lifetime is trusted for those too, and only LOOKUP_REVAL, the retry after a
stale handle, still forces a request.

Measured on an npm install of a 66,000-file tree: 150,000 lookups per
install answered "found" — mkdir -p over parents that exist, renames into
place — each a round trip for an answer the driver had.

Gated on the flag, so a stock server sees no change.

diff -ruN k-c/fs/fuse/dir.c k-d/fs/fuse/dir.c

diff --git a/fs/fuse/dir.c b/fs/fuse/dir.c
index 32e512cf4..389532229 100644
--- a/fs/fuse/dir.c
+++ b/fs/fuse/dir.c
@@ -227,10 +227,22 @@ static int fuse_dentry_revalidate(struct inode *dir, const struct qstr *name,
 		goto invalid;
 
 	inode = d_inode_rcu(entry);
+	/*
+	 * lighter: an exclusive create, a mkdir or a rename target forces a
+	 * fresh lookup of a dentry the driver already holds, in case the
+	 * server's world moved without telling it. This server tells it —
+	 * every change it learns of on the host withdraws the entry — so a
+	 * positive dentry within its lifetime is as good here as anywhere.
+	 * A package install makes a hundred and fifty thousand of these per
+	 * tree, mkdir -p over paths that exist. LOOKUP_REVAL, the retry after
+	 * a stale handle, is kept.
+	 */
 	if (inode && fuse_is_bad(inode))
 		goto invalid;
 	else if (time_before64(fuse_dentry_time(entry), get_jiffies_64()) ||
-		 (flags & (LOOKUP_EXCL | LOOKUP_REVAL | LOOKUP_RENAME_TARGET))) {
+		 (flags & LOOKUP_REVAL) ||
+		 ((flags & (LOOKUP_EXCL | LOOKUP_RENAME_TARGET)) &&
+		  !(inode && get_fuse_conn(inode)->lighter_trust_dentries))) {
 		struct fuse_entry_out outarg;
 		FUSE_ARGS(args);
 		struct fuse_forget_link *forget;
diff --git a/fs/fuse/fuse_i.h b/fs/fuse/fuse_i.h
index 9a28864f1..e7e2223ff 100644
--- a/fs/fuse/fuse_i.h
+++ b/fs/fuse/fuse_i.h
@@ -776,6 +776,10 @@ struct fuse_conn {
 	 * cached attributes instead of being sent. */
 	unsigned lighter_noop_setattr:1;
 
+	/* lighter: a positive dentry still within its lifetime is trusted for
+	 * an exclusive create, a mkdir and a rename target too. */
+	unsigned lighter_trust_dentries:1;
+
 	/*
 	 * The following bitfields are only for optimization purposes
 	 * and hence races in setting them will not cause malfunction
diff --git a/fs/fuse/inode.c b/fs/fuse/inode.c
index d5e57fb44..48123298e 100644
--- a/fs/fuse/inode.c
+++ b/fs/fuse/inode.c
@@ -1417,6 +1417,8 @@ static void process_init_reply(struct fuse_mount *fm, struct fuse_args *args,
 				fc->lighter_no_security_xattr = 1;
 			if (flags & FUSE_LIGHTER_NOOP_SETATTR)
 				fc->lighter_noop_setattr = 1;
+			if (flags & FUSE_LIGHTER_TRUST_DENTRIES)
+				fc->lighter_trust_dentries = 1;
 			if (flags & FUSE_SETXATTR_EXT)
 				fc->setxattr_ext = 1;
 			if (flags & FUSE_SECURITY_CTX)
@@ -1513,7 +1515,8 @@ static struct fuse_init_args *fuse_new_init(struct fuse_mount *fm)
 		FUSE_NO_EXPORT_SUPPORT | FUSE_HAS_RESEND | FUSE_ALLOW_IDMAP |
 		FUSE_REQUEST_TIMEOUT | FUSE_LIGHTER_CREATE |
 		FUSE_LIGHTER_CLONE_SUPPORT |
-		FUSE_LIGHTER_NO_SECURITY_XATTR | FUSE_LIGHTER_NOOP_SETATTR;
+		FUSE_LIGHTER_NO_SECURITY_XATTR | FUSE_LIGHTER_NOOP_SETATTR |
+		FUSE_LIGHTER_TRUST_DENTRIES;
 #ifdef CONFIG_FUSE_DAX
 	if (fm->fc->dax)
 		flags |= FUSE_MAP_ALIGNMENT;
diff --git a/include/uapi/linux/fuse.h b/include/uapi/linux/fuse.h
index 061e65574..0d7099473 100644
--- a/include/uapi/linux/fuse.h
+++ b/include/uapi/linux/fuse.h
@@ -516,6 +516,10 @@ struct fuse_file_lock {
  * to the mode a file has, a chown to its owner, a truncate to its size —
  * from attributes it still trusts, without a request. */
 #define FUSE_LIGHTER_NOOP_SETATTR	(1ULL << 58)
+/* lighter: the server withdraws entries it learns have changed, so a
+ * positive dentry within its lifetime need not be looked up again for
+ * O_EXCL, mkdir or a rename target. */
+#define FUSE_LIGHTER_TRUST_DENTRIES	(1ULL << 57)
 
 /**
  * CUSE INIT request/reply flags
