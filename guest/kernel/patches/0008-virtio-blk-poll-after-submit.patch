virtio-blk: poll for the completion after submitting, before relying on the interrupt

A virtio-blk request on this machine costs three vCPU exits and an
inter-CPU wake: the kick, then the interrupt the device raises when it is
done — which the driver answers with two more exits, a status read and an
acknowledgement — and then the completion redirected to the submitting CPU
by IPI. The device, meanwhile, finished the request inside the kick exit:
the used entry is in the ring before the vCPU is back in the guest.

So after submitting, look — whether or not a kick was needed, because a
device that is watching the ring suppresses the kick and answers moments
after the descriptor is published. Callbacks are disabled before the
submission, so the device raises nothing for what it completes now; the
submitting CPU spins on the used ring for a bounded time, completes what it
finds in its own context (no IPI, no interrupt, no acknowledge), and
re-arms. With the device polling too, a request costs no exit at all.
Requests the device did not finish in time — a write that had to wait for a
flush, a read from a cold image — still arrive by interrupt as before.

`virtio_blk.poll_usecs=0` restores the interrupt-only path.

Only a synchronous request is waited for. Writeback submits large
asynchronous writes that take the device longer than the window, and a
kworker spinning on each of them burned the whole window for nothing — a
third of a CPU under a tree copy. Those get one look, which re-arms
callbacks and takes whatever is already done, and then the interrupt.

diff --git a/drivers/block/virtio_blk.c b/drivers/block/virtio_blk.c
index f061420df..e4874a6dc 100644
--- a/drivers/block/virtio_blk.c
+++ b/drivers/block/virtio_blk.c
@@ -41,6 +41,11 @@ static unsigned int poll_queues;
 module_param(poll_queues, uint, 0644);
 MODULE_PARM_DESC(poll_queues, "The number of dedicated virtqueues for polling I/O");
 
+static unsigned int poll_usecs = 30;
+module_param(poll_usecs, uint, 0644);
+MODULE_PARM_DESC(poll_usecs, "After submitting, spin this long for the device to complete "
+		 "the request before relying on its interrupt (0 disables)");
+
 static int major;
 static DEFINE_IDA(vd_index_ida);
 
@@ -374,6 +379,57 @@ static void virtblk_done(struct virtqueue *vq)
 	spin_unlock_irqrestore(&vblk->vqs[qid].lock, flags);
 }
 
+/*
+ * The device may finish the request while we are still here: inside the kick
+ * itself, or — when it is watching the ring and we did not need to kick —
+ * moments after it saw the descriptor. Look for that before sleeping for an
+ * interrupt: callbacks were disabled before the submission was published, so
+ * nothing the device completes now raises one, and what is found here
+ * completes on the CPU that submitted it.
+ */
+static void virtblk_poll_after_submit(struct virtio_blk_vq *vq, bool sync)
+{
+	struct request_queue *q = NULL;
+	struct virtblk_req *vbr;
+	unsigned long flags;
+	unsigned int len;
+	bool done = false;
+	ktime_t end;
+
+	if (!poll_usecs)
+		return;
+	/*
+	 * Only a synchronous request has someone waiting for it. Writeback
+	 * submits large asynchronous writes that take the device longer than
+	 * the window, so a kworker spinning on them burned the whole window
+	 * every time for nothing — a third of a CPU under a tree copy. For
+	 * those, one look re-arms callbacks and takes whatever is already done.
+	 */
+	end = ktime_add_us(ktime_get(), sync ? poll_usecs : 0);
+
+	spin_lock_irqsave(&vq->lock, flags);
+	do {
+		virtqueue_disable_cb(vq->vq);
+		for (;;) {
+			while ((vbr = virtqueue_get_buf(vq->vq, &len)) != NULL) {
+				struct request *req = blk_mq_rq_from_pdu(vbr);
+
+				q = req->q;
+				if (likely(!blk_should_fake_timeout(req->q)))
+					blk_mq_complete_request(req);
+				done = true;
+			}
+			if (done || ktime_after(ktime_get(), end))
+				break;
+			cpu_relax();
+		}
+	} while (!virtqueue_enable_cb(vq->vq));
+
+	if (done)
+		blk_mq_start_stopped_hw_queues(q, true);
+	spin_unlock_irqrestore(&vq->lock, flags);
+}
+
 static void virtio_commit_rqs(struct blk_mq_hw_ctx *hctx)
 {
 	struct virtio_blk *vblk = hctx->queue->queuedata;
@@ -453,12 +509,18 @@ static blk_status_t virtio_queue_rq(struct blk_mq_hw_ctx *hctx,
 		return virtblk_fail_to_queue(req, err);
 	}
 
-	if (bd->last && virtqueue_kick_prepare(vblk->vqs[qid].vq))
-		notify = true;
+	if (bd->last) {
+		if (poll_usecs)
+			virtqueue_disable_cb(vblk->vqs[qid].vq);
+		if (virtqueue_kick_prepare(vblk->vqs[qid].vq))
+			notify = true;
+	}
 	spin_unlock_irqrestore(&vblk->vqs[qid].lock, flags);
 
 	if (notify)
 		virtqueue_notify(vblk->vqs[qid].vq);
+	if (bd->last)
+		virtblk_poll_after_submit(&vblk->vqs[qid], op_is_sync(req->cmd_flags));
 	return BLK_STS_OK;
 }
 
@@ -475,6 +537,7 @@ static void virtblk_add_req_batch(struct virtio_blk_vq *vq,
 {
 	struct request *req;
 	unsigned long flags;
+	bool sync = false;
 	bool kick;
 
 	spin_lock_irqsave(&vq->lock, flags);
@@ -483,6 +546,7 @@ static void virtblk_add_req_batch(struct virtio_blk_vq *vq,
 		struct virtblk_req *vbr = blk_mq_rq_to_pdu(req);
 		int err;
 
+		sync |= op_is_sync(req->cmd_flags);
 		err = virtblk_add_req(vq->vq, vbr);
 		if (err) {
 			virtblk_unmap_data(req, vbr);
@@ -491,11 +555,14 @@ static void virtblk_add_req_batch(struct virtio_blk_vq *vq,
 		}
 	}
 
+	if (poll_usecs)
+		virtqueue_disable_cb(vq->vq);
 	kick = virtqueue_kick_prepare(vq->vq);
 	spin_unlock_irqrestore(&vq->lock, flags);
 
 	if (kick)
 		virtqueue_notify(vq->vq);
+	virtblk_poll_after_submit(vq, sync);
 }
 
 static void virtio_queue_rqs(struct rq_list *rqlist)
