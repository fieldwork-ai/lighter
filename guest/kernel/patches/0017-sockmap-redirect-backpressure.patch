 #include <linux/virtio_vsock.h>
 #include <trace/events/sock.h>
 
+/* Guards every psock's paused list and paused_on: a source and its target
+ * may be torn down in either order, and one lock over both is what keeps
+ * each side's cleanup from racing the other's.
+ */
+static DEFINE_SPINLOCK(sk_psock_pause_lock);
+
+static void sk_psock_pause(struct sk_psock *from, struct sk_psock *on)
+{
+	spin_lock_bh(&sk_psock_pause_lock);
+	if (!from->paused_on && sk_psock_test_state(on, SK_PSOCK_TX_ENABLED)) {
+		from->paused_on = on;
+		list_add_tail(&from->pause_link, &on->paused);
+		sk_psock_set_state(from, SK_PSOCK_PAUSED);
+	}
+	spin_unlock_bh(&sk_psock_pause_lock);
+}
+
+/* Lifts the hold on every source paused on this psock; each reads again
+ * from its own backlog worker, which is the context that may take its
+ * socket's lock.
+ */
+static void sk_psock_unpause_all(struct sk_psock *psock)
+{
+	struct sk_psock *from, *tmp;
+
+	spin_lock_bh(&sk_psock_pause_lock);
+	list_for_each_entry_safe(from, tmp, &psock->paused, pause_link) {
+		list_del_init(&from->pause_link);
+		from->paused_on = NULL;
+		sk_psock_clear_state(from, SK_PSOCK_PAUSED);
+		sk_psock_set_state(from, SK_PSOCK_RESUME);
+		if (sk_psock_test_state(from, SK_PSOCK_TX_ENABLED))
+			schedule_delayed_work(&from->work, 0);
+	}
+	spin_unlock_bh(&sk_psock_pause_lock);
+}
+
+static void sk_psock_pause_leave(struct sk_psock *psock)
+{
+	spin_lock_bh(&sk_psock_pause_lock);
+	if (psock->paused_on) {
+		list_del_init(&psock->pause_link);
+		psock->paused_on = NULL;
+	}
+	spin_unlock_bh(&sk_psock_pause_lock);
+	sk_psock_unpause_all(psock);
+}
