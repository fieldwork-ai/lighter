fuse: whole-file clones, answered by a server that has clonefile

pnpm decides how to import every file by probing one copy_file_range
with FICLONE_FORCE: if cloning works it clones, and if it does not it
falls back to hardlinks — which on APFS cost 150 microseconds to a
clonefile's 70. This driver had no remap_file_range at all, so through
a shared directory the probe always failed and every install paid the
expensive path, fifteen thousand times.

Whole-file clones only, gated on the server declaring support: the
server replaces the destination's name with a clone of the source, so
the inode behind the caller's open file is orphaned — its pages and
attributes are dropped and the dentry invalidated, and the next path
access finds the clone. That matches how the callers that matter use
the result: probe, clone, close, read back by path.

--- a/fs/fuse/file.c
+++ b/fs/fuse/file.c
@@ -3336,6 +3336,75 @@
 	fuse_flush_time_update(inode_out);
 
 	return err;
+}
+
+/*
+ * lighter: FICLONE, answered by the server with a clonefile on the host.
+ *
+ * Whole-file clones only, because that is the shape the callers that matter
+ * actually use — pnpm probes with copy_file_range(FICLONE_FORCE) and imports
+ * every package file this way when it works, and a hardlink on APFS costs
+ * twice what a clonefile does. The server replaces the destination NAME with
+ * a clone of the source, so the inode behind the open file is orphaned: its
+ * pages and attributes are dropped and the dentry invalidated, and the next
+ * path access finds the clone. The destination's name is read without
+ * rename locking — a caller racing a rename of a file it is mid-clone gets
+ * an outcome no better defined than the race itself.
+ */
+static loff_t fuse_remap_file_range(struct file *file_in, loff_t pos_in,
+				    struct file *file_out, loff_t pos_out,
+				    loff_t len, unsigned int remap_flags)
+{
+	struct fuse_file *ff_in = file_in->private_data;
+	struct fuse_file *ff_out = file_out->private_data;
+	struct inode *inode_in = file_inode(file_in);
+	struct inode *inode_out = file_inode(file_out);
+	struct fuse_mount *fm = ff_out->fm;
+	struct fuse_conn *fc = fm->fc;
+	struct dentry *entry = file_dentry(file_out);
+	struct dentry *parent;
+	struct fuse_lighter_clone_in inarg;
+	struct fuse_lighter_clone_out outarg;
+	FUSE_ARGS(args);
+	int err;
+
+	if (!fc->lighter_clone)
+		return -EOPNOTSUPP;
+	if (remap_flags & ~REMAP_FILE_ADVISORY)
+		return -EOPNOTSUPP;
+	if (pos_in || pos_out)
+		return -EOPNOTSUPP;
+	if (len && len != i_size_read(inode_in))
+		return -EOPNOTSUPP;
+	if (!S_ISREG(inode_in->i_mode) || !S_ISREG(inode_out->i_mode))
+		return -EINVAL;
+
+	inode_lock(inode_out);
+	parent = dget_parent(entry);
+	memset(&inarg, 0, sizeof(inarg));
+	inarg.nodeid_in = ff_in->nodeid;
+	inarg.parent_out = get_fuse_inode(d_inode(parent))->nodeid;
+	args.opcode = FUSE_LIGHTER_CLONE;
+	args.nodeid = ff_out->nodeid;
+	args.in_numargs = 2;
+	args.in_args[0].size = sizeof(inarg);
+	args.in_args[0].value = &inarg;
+	args.in_args[1].size = entry->d_name.len + 1;
+	args.in_args[1].value = entry->d_name.name;
+	args.out_numargs = 1;
+	args.out_args[0].size = sizeof(outarg);
+	args.out_args[0].value = &outarg;
+	err = fuse_simple_request(fm, &args);
+	if (!err) {
+		truncate_inode_pages(inode_out->i_mapping, 0);
+		fuse_invalidate_attr(inode_out);
+		d_invalidate(entry);
+	}
+	dput(parent);
+	inode_unlock(inode_out);
+	if (err)
+		return err;
+	return outarg.size ? outarg.size : len;
 }
 
 static ssize_t fuse_copy_file_range(struct file *src_file, loff_t src_off,
@@ -3372,6 +3441,7 @@
 	.poll		= fuse_file_poll,
 	.fallocate	= fuse_file_fallocate,
 	.copy_file_range = fuse_copy_file_range,
+	.remap_file_range = fuse_remap_file_range,
 };
 
