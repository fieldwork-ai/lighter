+/*
+ * Apple silicon can run with x86's memory ordering (total store ordering)
+ * per thread: bit 1 of the implementation-defined ACTLR_EL1, advertised by
+ * bit 9 of AIDR_EL1. Rosetta asks for it with PR_SET_MEM_MODEL, and native
+ * threads never pay for it. The register is written only when the next
+ * thread's setting differs from what this CPU last had, and once per CPU to
+ * begin with, whatever the boot value was.
+ */
+#define ACTLR_EL1_TSOEN		BIT(1)
+#define AIDR_EL1_TSO		BIT(9)
+
+static bool apple_tso;
+static u64 actlr_base;
+/* 0: not yet written on this CPU; 1: default; 2: TSO. */
+static DEFINE_PER_CPU(unsigned int, tso_cur);
+
+static void tso_write(unsigned int tso)
+{
+	write_sysreg(actlr_base | (tso ? ACTLR_EL1_TSOEN : 0), actlr_el1);
+	isb();
+	__this_cpu_write(tso_cur, tso + 1);
+}
+
+static void tso_thread_switch(struct task_struct *next)
+{
+	if (!apple_tso)
+		return;
+	if (__this_cpu_read(tso_cur) == next->thread.tso + 1)
+		return;
+	tso_write(next->thread.tso);
+}
+
+static int __init apple_tso_init(void)
+{
+	u64 actlr;
+
+	if (read_cpuid_implementor() != ARM_CPU_IMP_APPLE)
+		return 0;
+	if (!(read_sysreg_s(SYS_AIDR_EL1) & AIDR_EL1_TSO)) {
+		pr_info("Apple TSO: not advertised\n");
+		return 0;
+	}
+	actlr = read_sysreg(actlr_el1);
+	actlr_base = actlr & ~ACTLR_EL1_TSOEN;
+	/*
+	 * Proved, not assumed: a hypervisor may present the bit and ignore
+	 * writes to it, and x86 code would then run with the wrong ordering.
+	 */
+	write_sysreg(actlr ^ ACTLR_EL1_TSOEN, actlr_el1);
+	isb();
+	if ((read_sysreg(actlr_el1) ^ actlr) != ACTLR_EL1_TSOEN) {
+		write_sysreg(actlr, actlr_el1);
+		isb();
+		pr_info("Apple TSO: advertised but ACTLR_EL1.TSOEN is not writable here\n");
+		return 0;
+	}
+	apple_tso = true;
+	preempt_disable();
+	tso_write(0);
+	preempt_enable();
+	pr_info("Apple TSO: available per thread (PR_SET_MEM_MODEL); boot value %s\n",
+		actlr & ACTLR_EL1_TSOEN ? "on" : "off");
+	return 0;
+}
+early_initcall(apple_tso_init);
+
+int arch_prctl_mem_model_get(struct task_struct *t)
+{
+	if (!apple_tso)
+		return -EINVAL;
+	return t->thread.tso ? PR_SET_MEM_MODEL_TSO : PR_SET_MEM_MODEL_DEFAULT;
+}
+
+int arch_prctl_mem_model_set(struct task_struct *t, unsigned long val)
+{
+	if (!apple_tso)
+		return -EINVAL;
+	if (val != PR_SET_MEM_MODEL_DEFAULT && val != PR_SET_MEM_MODEL_TSO)
+		return -EINVAL;
+	t->thread.tso = val == PR_SET_MEM_MODEL_TSO;
+	if (t == current) {
+		preempt_disable();
+		tso_write(t->thread.tso);
+		preempt_enable();
+	}
+	return 0;
+}
+
 void flush_thread(void)
 {
+	if (apple_tso && current->thread.tso) {
+		current->thread.tso = 0;
+		preempt_disable();
+		tso_write(0);
+		preempt_enable();
+	}
 	fpsimd_flush_thread();
 	tls_thread_flush();
 	flush_ptrace_hw_breakpoint(current);
@@ -754,6 +849,7 @@ struct task_struct *__switch_to(struct task_struct *prev,
 	ptrauth_thread_switch_user(next);
 	permission_overlay_switch(next);
 	gcs_thread_switch(next);
+	tso_thread_switch(next);
 
