--- a/include/uapi/linux/prctl.h
+++ b/include/uapi/linux/prctl.h
@@ -386,4 +386,15 @@ struct prctl_mm_map {
 # define PR_FUTEX_HASH_SET_SLOTS	1
 # define PR_FUTEX_HASH_GET_SLOTS	2
 
+/*
+ * Memory ordering model. For emulators of x86 on hardware that can run
+ * with x86's stronger ordering (Apple silicon's TSO mode): per thread,
+ * inherited across fork and clone, reset by exec. The values are the
+ * ones Rosetta for Linux asks for.
+ */
+#define PR_GET_MEM_MODEL			0x6d4d444c
+#define PR_SET_MEM_MODEL			0x4d4d444c
+# define PR_SET_MEM_MODEL_DEFAULT		0
+# define PR_SET_MEM_MODEL_TSO			1
+
 #endif /* _LINUX_PRCTL_H */
