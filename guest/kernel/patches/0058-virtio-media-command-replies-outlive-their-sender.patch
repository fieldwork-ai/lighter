# virtio-media: a reply is recorded before its sender is woken, and never written to a sender that has gone.
# The callback set the waiter's `done`, then its `resp_len`, then woke it through a pointer in the
# waiter's stack frame. A waiter that saw `done` in the meantime (a host that answers in microseconds:
# lighter's asynchronous decoder) read a length of 0 ("received response header is too short") and
# returned, and the callback went on writing into a frame the next command now used, which surfaced as
# "command:id 0 is not a head!" and a broken command queue: every later open or ioctl EIO, /dev/video0
# dead until reboot. A reply after a timeout did the same without any race. The reply is now kept in
# the device and the ring carries a sequence number, so a reply for a sender that timed out is dropped;
# and the ring is serialized against its callback, as virtio_ring requires.
--- a/drivers/media/virtio/virtio_media.h
+++ b/drivers/media/virtio/virtio_media.h
@@ -37,6 +37,12 @@
  *        other responses are handled by &struct virtio_media_session
  * @vlock: serializes access to the command queue.
  * @wq: waitqueue for host responses on the command queue.
+ * @cmd_lock: protects the command queue against its callback, and the four
+ *            fields below.
+ * @cmd_seq: number of the last command sent; its tokens are made from it.
+ * @cmd_token: token of the command being waited for, or %NULL.
+ * @cmd_done: whether the command being waited for has its reply.
+ * @cmd_resp_len: length of that reply.
  */
 struct virtio_media {
 	struct v4l2_device v4l2_dev;
@@ -70,6 +76,12 @@
 
 	struct mutex vlock; /* serializes command queue access */
 	wait_queue_head_t wq;
+
+	spinlock_t cmd_lock; /* see @cmd_lock */
+	unsigned long cmd_seq;
+	void *cmd_token;
+	bool cmd_done;
+	size_t cmd_resp_len;
 };
 
