+static bool virtio_media_cmd_done(struct virtio_media *vv, size_t *resp_len)
+{
+	unsigned long flags;
+	bool done;
+
+	spin_lock_irqsave(&vv->cmd_lock, flags);
+	done = vv->cmd_done;
+	*resp_len = vv->cmd_resp_len;
+	spin_unlock_irqrestore(&vv->cmd_lock, flags);
+
+	return done;
+}
