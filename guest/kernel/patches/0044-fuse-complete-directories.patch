--- a/fs/fuse/inode.c
+++ b/fs/fuse/inode.c
@@ -600,6 +600,7 @@ int fuse_reverse_inval_inode(struct fuse_conn *fc, u64 nodeid,
 	spin_unlock(&fi->lock);
 	/* lighter: the host changed it; the next refresh is the host's word */
 	clear_bit(FUSE_I_LIGHTER_WROTE, &fi->state);
+	clear_bit(FUSE_I_LIGHTER_COMPLETE, &fi->state);
 
 	fuse_invalidate_attr(inode);
 	forget_all_cached_acls(inode);
