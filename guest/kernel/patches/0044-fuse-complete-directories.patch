@@ -144,6 +144,9 @@ struct fuse_inode {
 	/** Attribute-request version last used to refresh the page cache. */
 	u64 cache_version;
 
+	/* lighter: the epoch FUSE_I_LIGHTER_COMPLETE was granted in */
+	int lighter_complete_epoch;
+
 	union {
 		/* read/write io cache (regular file only) */
 		struct {
@@ -238,6 +241,8 @@ enum {
 	FUSE_I_CACHE_IO_MODE,
 	/* lighter: the cached mtime is the guest's own, from a write */
 	FUSE_I_LIGHTER_WROTE,
+	/* lighter: a directory this guest made, whose dcache is all of it */
+	FUSE_I_LIGHTER_COMPLETE,
 };
 
