+
+/* Whether this idle entry may poll: not while backed off, unless a model is
+ * talking. Each entry spent backed off counts one off the backoff. */
+static bool __cpuidle idle_poll_allowed(void)
+{
+	u32 skip = __this_cpu_read(idle_poll_skip);
+
+	if (!skip)
+		return true;
+	if (idle_traffic_recent()) {
+		__this_cpu_inc(idle_poll_backoffs[BACKOFF_BYPASSED]);
+		return true;
+	}
+	__this_cpu_write(idle_poll_skip, skip - 1);
+	return false;
