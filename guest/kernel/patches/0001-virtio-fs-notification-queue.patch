+/*
+ * Hands one notification to FUSE.
+ *
+ * The wire format is FUSE's own: a fuse_out_header whose `unique` is zero and
+ * whose `error` field carries the notification code, exactly as a server
+ * writes it to /dev/fuse. Reusing it means the device side has nothing
+ * virtio-specific to invent, and this side has nothing to translate.
+ *
+ * Everything is bounds-checked against the length the device actually wrote,
+ * because that length is the only thing here the guest did not choose.
+ */
+static void virtio_fs_notify_one(struct fuse_conn *fc, void *buf,
+				 unsigned int len)
+{
+	struct fuse_out_header oh;
+	void *payload;
+	unsigned int plen;
+
+	if (len < sizeof(oh))
+		return;
+	memcpy(&oh, buf, sizeof(oh));
+	if (oh.unique != 0 || oh.len < sizeof(oh) || oh.len > len)
+		return;
+	payload = (char *)buf + sizeof(oh);
+	plen = oh.len - sizeof(oh);
+
+	switch (oh.error) {
+	case FUSE_NOTIFY_INVAL_INODE: {
+		struct fuse_notify_inval_inode_out out;
+
+		if (plen < sizeof(out))
+			return;
+		memcpy(&out, payload, sizeof(out));
+		fuse_reverse_inval_inode(fc, out.ino, out.off, out.len);
+		break;
+	}
+	case FUSE_NOTIFY_INVAL_ENTRY: {
+		struct fuse_notify_inval_entry_out out;
+		struct qstr name;
+
+		if (plen < sizeof(out))
+			return;
+		memcpy(&out, payload, sizeof(out));
+		if (out.namelen == 0 || out.namelen > FUSE_NAME_MAX)
+			return;
+		/* The name is NUL-terminated, and the NUL is inside the buffer. */
+		if (sizeof(out) + (size_t)out.namelen + 1 > plen)
+			return;
+		name.name = (char *)payload + sizeof(out);
+		name.len = out.namelen;
+		if (name.name[name.len] != '\0')
+			return;
+		fuse_reverse_inval_entry(fc, out.parent, 0, &name, out.flags);
+		break;
+	}
+	default:
+		break;
+	}
+}
+
+/* Gives one buffer back to the device to be filled again. */
+static int virtio_fs_notify_post(struct virtio_fs_vq *fsvq, void *buf)
+{
+	struct scatterlist sg;
+
+	sg_init_one(&sg, buf, VIRTIO_FS_NOTIFY_BUF_SIZE);
+	return virtqueue_add_inbuf(fsvq->vq, &sg, 1, buf, GFP_ATOMIC);
+}
+
+/*
+ * Consumes whatever the device has written.
+ *
+ * In a work item rather than the interrupt handler because invalidating a
+ * dentry takes inode locks and may sleep, and because there is no hurry: the
+ * guest is not waiting on any of this.
+ */
+static void virtio_fs_notify_done_work(struct work_struct *work)
+{
+	struct virtio_fs_vq *fsvq = container_of(work, struct virtio_fs_vq,
+						 done_work);
+	struct fuse_conn *fc = fsvq->fud ? fsvq->fud->fc : NULL;
+	unsigned int len;
+	void *buf;
+
+	for (;;) {
+		spin_lock(&fsvq->lock);
+		buf = virtqueue_get_buf(fsvq->vq, &len);
+		spin_unlock(&fsvq->lock);
+		if (!buf)
+			break;
+
+		/* Before the filesystem is mounted there is nothing to tell. */
+		if (fc) {
+			down_read(&fc->killsb);
+			virtio_fs_notify_one(fc, buf, len);
+			up_read(&fc->killsb);
+		}
+
+		spin_lock(&fsvq->lock);
+		if (!fsvq->connected || virtio_fs_notify_post(fsvq, buf) < 0) {
+			spin_unlock(&fsvq->lock);
+			kfree(buf);
+			continue;
+		}
+		virtqueue_kick(fsvq->vq);
+		spin_unlock(&fsvq->lock);
+	}
+}
+
+/* The notification queue queues nothing of its own. */
+static void virtio_fs_notify_dispatch_work(struct work_struct *work)
+{
+}
+
+/* Fills the notification queue so the device has somewhere to write. */
+static int virtio_fs_notify_fill(struct virtio_fs_vq *fsvq)
+{
+	unsigned int i;
+
+	for (i = 0; i < VIRTIO_FS_NOTIFY_BUFS; i++) {
+		void *buf = kmalloc(VIRTIO_FS_NOTIFY_BUF_SIZE, GFP_KERNEL);
+
+		if (!buf)
+			return -ENOMEM;
+		spin_lock(&fsvq->lock);
+		if (virtio_fs_notify_post(fsvq, buf) < 0) {
+			spin_unlock(&fsvq->lock);
+			kfree(buf);
+			break;
+		}
+		spin_unlock(&fsvq->lock);
+	}
+	spin_lock(&fsvq->lock);
+	virtqueue_kick(fsvq->vq);
+	spin_unlock(&fsvq->lock);
+	return 0;
+}
+
