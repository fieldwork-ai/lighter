fuse: a file the Mac user owns belongs to whoever asks

The server runs as the Mac user and reports that user's files as root's,
since it cannot give a Mac file to anyone else. A container running as 1000
then sees its own bind mount as root's, and only the "other" bits apply to
it: a 770 folder it cannot enter, a 660 file it cannot read. Docker Desktop
and OrbStack show such a file as owned by whoever asks, so compose files
written for them set a UID and expect it to work.

When the server has set FUSE_LIGHTER_CALLER_OWNS, an attribute flagged
FUSE_ATTR_LIGHTER_CALLER_UID or _GID belongs to its caller: stat reports the
caller's fsuid or fsgid, the permission check puts the caller in the owner's
class or the group's, and a chmod, a time set or a chown to oneself is the
owner's. The server flags only files with no owner a container recorded, so
a chown still gives a file a real owner.

Per caller, not in i_uid, because the attributes are cached for everyone:
two containers with different users on one share each see their own. i_uid
stays root, which is what the rest of the VFS sees, as before.

Gated on the flag, so a stock server sees no change.

--- a/fs/fuse/dir.c
+++ b/fs/fuse/dir.c
@@ -1472,6 +1472,36 @@ static int fuse_do_getattr(struct mnt_idmap *idmap, struct inode *inode,
 	return err;
 }
 
+/*
+ * lighter: a file the Mac user owns has no owner a container would
+ * recognize, since the server cannot give a Mac file to anyone else. Until a
+ * container records one with a chown, it belongs to whoever asks, as it does
+ * under Docker Desktop: a container running as 1000 sees its bind mount as
+ * 1000's, and its mode bits mean what they say. i_uid and i_gid stay what
+ * the server sent (root), which is what everything else in the VFS sees.
+ *
+ * Per caller rather than in the attributes, because the attributes are
+ * cached for everyone: two containers with different users on one share
+ * must each see their own.
+ */
+static bool fuse_lighter_caller_uid(struct inode *inode)
+{
+	return test_bit(FUSE_I_LIGHTER_CALLER_UID, &get_fuse_inode(inode)->state);
+}
+
+static bool fuse_lighter_caller_gid(struct inode *inode)
+{
+	return test_bit(FUSE_I_LIGHTER_CALLER_GID, &get_fuse_inode(inode)->state);
+}
+
+static void fuse_lighter_caller_owner(struct inode *inode, struct kstat *stat)
+{
+	if (fuse_lighter_caller_uid(inode))
+		stat->uid = current_fsuid();
+	if (fuse_lighter_caller_gid(inode))
+		stat->gid = current_fsgid();
+}
+
 static int fuse_update_get_attr(struct mnt_idmap *idmap, struct inode *inode,
 				struct file *file, struct kstat *stat,
 				u32 request_mask, unsigned int flags)
@@ -1525,6 +1555,8 @@ retry:
 			stat->result_mask |= STATX_BTIME;
 		}
 	}
+	if (!err && stat)
+		fuse_lighter_caller_owner(inode, stat);
 
 	return err;
 }
@@ -1705,6 +1737,31 @@ static int fuse_perm_getattr(struct inode *inode, int mask)
  * access request is sent.  Execute permission is still checked
  * locally based on file mode.
  */
+/*
+ * lighter: generic_permission() for a file that belongs to its caller. The
+ * caller is in the owner's class (or the group's), judged here; only a
+ * refusal goes on to the generic check, for the capabilities that can still
+ * grant it. There are no POSIX ACLs on this server to consult.
+ */
+static int fuse_lighter_permission(struct mnt_idmap *idmap,
+				   struct inode *inode, int mask)
+{
+	bool uid = fuse_lighter_caller_uid(inode);
+	bool gid = fuse_lighter_caller_gid(inode);
+	unsigned int mode = inode->i_mode;
+
+	if (!uid && !gid)
+		return generic_permission(idmap, inode, mask);
+	if (uid || vfsuid_eq_kuid(i_uid_into_vfsuid(idmap, inode),
+				  current_fsuid()))
+		mode >>= 6;
+	else if (gid || vfsgid_in_group_p(i_gid_into_vfsgid(idmap, inode)))
+		mode >>= 3;
+	if (!(mask & 7 & ~mode))
+		return 0;
+	return generic_permission(idmap, inode, mask);
+}
+
 static int fuse_permission(struct mnt_idmap *idmap,
 			   struct inode *inode, int mask)
 {
@@ -1738,7 +1795,7 @@ static int fuse_permission(struct mnt_idmap *idmap,
 	}
 
 	if (fc->default_permissions) {
-		err = generic_permission(idmap, inode, mask);
+		err = fuse_lighter_permission(idmap, inode, mask);
 
 		/* If permission is denied, try to refresh file
 		   attributes.  This is also needed, because the root
@@ -1746,8 +1803,8 @@ static int fuse_permission(struct mnt_idmap *idmap,
 		if (err == -EACCES && !refreshed) {
 			err = fuse_perm_getattr(inode, mask);
 			if (!err)
-				err = generic_permission(idmap,
-							 inode, mask);
+				err = fuse_lighter_permission(idmap,
+							      inode, mask);
 		}
 
 		/* Note: the opposite of the above test does not
@@ -2086,6 +2143,46 @@ int fuse_flush_times(struct inode *inode, struct fuse_file *ff)
  * vmtruncate() doesn't allow for this case, so do the rlimit checking
  * and the actual truncation by hand.
  */
+/*
+ * lighter: setattr_prepare() lets the owner chmod, set times and chown to
+ * itself, judging the owner by i_uid, which for a file that belongs to its
+ * caller is root. Judge those as the owner's here, strip set-group-ID as it
+ * would, and let it do the rest with ATTR_FORCE.
+ */
+static int fuse_lighter_setattr_prepare(struct mnt_idmap *idmap,
+					struct dentry *dentry,
+					struct iattr *attr)
+{
+	struct inode *inode = d_inode(dentry);
+	unsigned int ia_valid = attr->ia_valid;
+	int err;
+
+	if ((ia_valid & ATTR_FORCE) || !fuse_lighter_caller_uid(inode))
+		return setattr_prepare(idmap, dentry, attr);
+
+	if ((ia_valid & ATTR_UID) &&
+	    !vfsuid_eq_kuid(attr->ia_vfsuid, current_fsuid()) &&
+	    !capable_wrt_inode_uidgid(idmap, inode, CAP_CHOWN))
+		return -EPERM;
+	if ((ia_valid & ATTR_GID) &&
+	    !vfsgid_in_group_p(attr->ia_vfsgid) &&
+	    !(!fuse_lighter_caller_gid(inode) &&
+	      vfsgid_eq(attr->ia_vfsgid, i_gid_into_vfsgid(idmap, inode))) &&
+	    !capable_wrt_inode_uidgid(idmap, inode, CAP_CHOWN))
+		return -EPERM;
+	if ((ia_valid & ATTR_MODE) &&
+	    ((ia_valid & ATTR_GID) || !fuse_lighter_caller_gid(inode)) &&
+	    !in_group_or_capable(idmap, inode, (ia_valid & ATTR_GID) ?
+				 attr->ia_vfsgid :
+				 i_gid_into_vfsgid(idmap, inode)))
+		attr->ia_mode &= ~S_ISGID;
+
+	attr->ia_valid |= ATTR_FORCE;
+	err = setattr_prepare(idmap, dentry, attr);
+	attr->ia_valid &= ~ATTR_FORCE;
+	return err;
+}
+
 int fuse_do_setattr(struct mnt_idmap *idmap, struct dentry *dentry,
 		    struct iattr *attr, struct file *file)
 {
@@ -2108,7 +2205,7 @@ int fuse_do_setattr(struct mnt_idmap *idmap, struct dentry *dentry,
 	if (!fc->default_permissions)
 		attr->ia_valid |= ATTR_FORCE;
 
-	err = setattr_prepare(idmap, dentry, attr);
+	err = fuse_lighter_setattr_prepare(idmap, dentry, attr);
 	if (err)
 		return err;
 
