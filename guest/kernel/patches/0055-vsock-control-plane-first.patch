# vsock/virtio: the control plane's packets go first. A packet the transmit ring cannot take waits in
# the driver's send queue, behind every packet queued before it, so a guest pushing streams into a
# slow host peer kept Docker's replies, the memory reports and DNS behind its whole backlog. The
# control plane's connections (the Docker and control sockets the host dials, guest ports 2375 and
# 2376; DNS, the memory reports and the time the guest dials, host ports 2379, 2381 and 2382) now
# have a queue of their own, drained first, and go straight onto the ring whenever it is empty. Each
# connection's packets stay in one queue, so its order is kept; the host's outbox (lighter-vmm's
# vsock `Outbox`) is laid out the same way.
diff --git a/net/vmw_vsock/virtio_transport.c b/net/vmw_vsock/virtio_transport.c
--- a/net/vmw_vsock/virtio_transport.c
+++ b/net/vmw_vsock/virtio_transport.c
@@ -46,6 +46,8 @@
 
 	struct work_struct send_pkt_work;
 	struct sk_buff_head send_pkt_queue;
+	/* lighter: the control plane's packets, sent before any stream's. */
+	struct sk_buff_head send_ctrl_queue;
 
 	atomic_t queued_replies;
 
@@ -159,6 +161,31 @@
 	return 0;
 }
 
+/* lighter: the machine's control plane — the Docker socket and the agent's
+ * control socket (guest ports the host dials), and DNS, the memory reports
+ * and the time (host ports the guest dials) — waits for no stream. A packet
+ * queues here only while the transmit ring is full, and then behind every
+ * stream's packet queued before it: a guest pushing streams into a slow host
+ * peer delayed Docker's replies and the memory reports by its whole backlog.
+ * Each connection's packets stay in one queue, so its own order is kept;
+ * the host's outbox is laid out the same way.
+ */
+static bool virtio_transport_is_control(const struct sk_buff *skb)
+{
+	const struct virtio_vsock_hdr *hdr = virtio_vsock_hdr((struct sk_buff *)skb);
+	u32 src = le32_to_cpu(hdr->src_port), dst = le32_to_cpu(hdr->dst_port);
+
+	return src == 2375 || src == 2376 ||
+	       dst == 2379 || dst == 2381 || dst == 2382;
+}
+
+static struct sk_buff_head *
+virtio_transport_send_queue(struct virtio_vsock *vsock, const struct sk_buff *skb)
+{
+	return virtio_transport_is_control(skb) ? &vsock->send_ctrl_queue
+						: &vsock->send_pkt_queue;
+}
+
 static void
 virtio_transport_send_pkt_work(struct work_struct *work)
 {
@@ -180,15 +207,17 @@
 		bool reply;
 		int ret;
 
-		skb = virtio_vsock_skb_dequeue(&vsock->send_pkt_queue);
+		skb = virtio_vsock_skb_dequeue(&vsock->send_ctrl_queue);
 		if (!skb)
+			skb = virtio_vsock_skb_dequeue(&vsock->send_pkt_queue);
+		if (!skb)
 			break;
 
 		reply = virtio_vsock_skb_reply(skb);
 
 		ret = virtio_transport_send_skb(skb, vq, vsock, GFP_KERNEL);
 		if (ret < 0) {
-			virtio_vsock_skb_queue_head(&vsock->send_pkt_queue, skb);
+			virtio_vsock_skb_queue_head(virtio_transport_send_queue(vsock, skb), skb);
 			break;
 		}
 
@@ -266,13 +295,18 @@
 	 * on the virtqueue using virtio_transport_send_skb_fast_path.
 	 * If this fails we simply put the packet on the intermediate
 	 * queue and schedule the worker.
+	 *
+	 * lighter: a control packet needs only its own queue empty to go
+	 * straight on; a stream's packet waits while either queue holds one.
 	 */
-	if (!skb_queue_empty_lockless(&vsock->send_pkt_queue) ||
+	if (!skb_queue_empty_lockless(&vsock->send_ctrl_queue) ||
+	    (!virtio_transport_is_control(skb) &&
+	     !skb_queue_empty_lockless(&vsock->send_pkt_queue)) ||
 	    virtio_transport_send_skb_fast_path(vsock, skb)) {
 		if (virtio_vsock_skb_reply(skb))
 			atomic_inc(&vsock->queued_replies);
 
-		virtio_vsock_skb_queue_tail(&vsock->send_pkt_queue, skb);
+		virtio_vsock_skb_queue_tail(virtio_transport_send_queue(vsock, skb), skb);
 		queue_work(virtio_vsock_workqueue, &vsock->send_pkt_work);
 	}
 
@@ -295,6 +329,7 @@
 	}
 
 	cnt = virtio_transport_purge_skbs(vsk, &vsock->send_pkt_queue);
+	cnt += virtio_transport_purge_skbs(vsk, &vsock->send_ctrl_queue);
 
 	if (cnt) {
 		struct virtqueue *rx_vq = vsock->vqs[VSOCK_VQ_RX];
@@ -976,6 +1011,7 @@
 	mutex_unlock(&vsock->tx_lock);
 
 	virtio_vsock_skb_queue_purge(&vsock->send_pkt_queue);
+	virtio_vsock_skb_queue_purge(&vsock->send_ctrl_queue);
 
 	/* Delete virtqueues and flush outstanding callbacks if any */
 	vdev->config->del_vqs(vdev);
@@ -1011,6 +1047,7 @@
 	mutex_init(&vsock->rx_lock);
 	mutex_init(&vsock->event_lock);
 	skb_queue_head_init(&vsock->send_pkt_queue);
+	skb_queue_head_init(&vsock->send_ctrl_queue);
 	INIT_WORK(&vsock->rx_work, virtio_transport_rx_work);
 	INIT_DELAYED_WORK(&vsock->rx_refill_work, virtio_vsock_rx_refill_work);
 	INIT_DELAYED_WORK(&vsock->rx_pool_trim_work, virtio_vsock_rx_pool_trim_work);
