fuse: answer security and ACL attribute reads locally for a server that has none

The kernel asks the filesystem for security.capability before every chmod,
chown and truncate, to know whether to strip privileges, and for the POSIX ACL
attributes on permission checks. On a shared macOS directory none of those can
exist, and the server has been answering ENODATA from a table — but each one
was still a round trip through the virtqueue, an interrupt and two context
switches: about a quarter of a million per package install, one request in
eight, and on a small host most of the guest's kernel time.

A server that sets FUSE_LIGHTER_NO_SECURITY_XATTR at init has declared that
no such attribute exists, ever; getxattr for one is ENODATA without a request.
user.* and trusted.* still go to the server, so an attribute someone set on
the Mac still reads.

Gated on the flag, so a stock server sees no change.

diff -ruN k/fs/fuse/fuse_i.h k-b/fs/fuse/fuse_i.h
--- a/fs/fuse/fuse_i.h	2026-09-02 10:04:32
+++ b/fs/fuse/fuse_i.h	2026-09-02 10:05:01
@@ -732,6 +732,10 @@
 	/* lighter: the server answers FUSE_LIGHTER_CLONE. */
 	unsigned lighter_clone:1;
 
+	/* lighter: the server has no security.* or POSIX ACL attributes, so
+	 * the kernel answers those itself instead of asking. */
+	unsigned lighter_no_security_xattr:1;
+
 	/*
 	 * The following bitfields are only for optimization purposes
 	 * and hence races in setting them will not cause malfunction
diff -ruN k/fs/fuse/inode.c k-b/fs/fuse/inode.c
--- a/fs/fuse/inode.c	2026-09-02 10:04:32
+++ b/fs/fuse/inode.c	2026-09-02 10:05:01
@@ -1319,6 +1319,8 @@
 				fc->lighter_create = 1;
 			if (flags & FUSE_LIGHTER_CLONE_SUPPORT)
 				fc->lighter_clone = 1;
+			if (flags & FUSE_LIGHTER_NO_SECURITY_XATTR)
+				fc->lighter_no_security_xattr = 1;
 			if (flags & FUSE_SETXATTR_EXT)
 				fc->setxattr_ext = 1;
 			if (flags & FUSE_SECURITY_CTX)
@@ -1406,7 +1408,8 @@
 		FUSE_SECURITY_CTX | FUSE_CREATE_SUPP_GROUP |
 		FUSE_HAS_EXPIRE_ONLY | FUSE_DIRECT_IO_ALLOW_MMAP |
 		FUSE_NO_EXPORT_SUPPORT | FUSE_HAS_RESEND | FUSE_ALLOW_IDMAP |
-		FUSE_LIGHTER_CREATE | FUSE_LIGHTER_CLONE_SUPPORT;
+		FUSE_LIGHTER_CREATE | FUSE_LIGHTER_CLONE_SUPPORT |
+		FUSE_LIGHTER_NO_SECURITY_XATTR;
 #ifdef CONFIG_FUSE_DAX
 	if (fm->fc->dax)
 		flags |= FUSE_MAP_ALIGNMENT;
diff -ruN k/fs/fuse/xattr.c k-b/fs/fuse/xattr.c
--- a/fs/fuse/xattr.c	2026-09-02 10:04:31
+++ b/fs/fuse/xattr.c	2026-09-02 10:05:01
@@ -60,6 +60,18 @@
 	if (fm->fc->no_getxattr)
 		return -EOPNOTSUPP;
 
+	/*
+	 * lighter: security.capability is asked for before every chmod, chown
+	 * and truncate (to decide whether to strip privileges) and on every
+	 * exec; the POSIX ACL names on permission checks. A server that has
+	 * declared it holds none is answered here, and a package install
+	 * makes a quarter of a million fewer requests.
+	 */
+	if (fm->fc->lighter_no_security_xattr &&
+	    (!strncmp(name, XATTR_SECURITY_PREFIX, XATTR_SECURITY_PREFIX_LEN) ||
+	     !strncmp(name, "system.posix_acl_", 17)))
+		return -ENODATA;
+
 	memset(&inarg, 0, sizeof(inarg));
 	inarg.size = size;
 	args.opcode = FUSE_GETXATTR;
diff -ruN k/include/uapi/linux/fuse.h k-b/include/uapi/linux/fuse.h
--- a/include/uapi/linux/fuse.h	2026-09-02 10:04:32
+++ b/include/uapi/linux/fuse.h	2026-09-02 10:05:01
@@ -485,6 +485,9 @@
  * destination's name. What pnpm and cp -c ask for before falling back to
  * hardlinks or copies, at less than half a hardlink's cost. */
 #define FUSE_LIGHTER_CLONE_SUPPORT	(1ULL << 61)
+/* lighter: no security.* or system.posix_acl_* attribute exists on the
+ * server, ever; getxattr for one is ENODATA without a request. */
+#define FUSE_LIGHTER_NO_SECURITY_XATTR	(1ULL << 59)
 
 /**
  * CUSE INIT request/reply flags
