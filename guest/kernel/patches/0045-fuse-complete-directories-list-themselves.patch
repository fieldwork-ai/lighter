--- a/fs/fuse/readdir.c
+++ b/fs/fuse/readdir.c
@@ -637,6 +637,111 @@ static int fuse_readdir_cached(struct file *file, struct dir_context *ctx)
 	return res == FOUND_SOME ? 0 : UNCACHED;
 }
 
+/*
+ * lighter: a complete directory lists itself (see fuse_lookup() in dir.c). A
+ * build or a search lists every directory of a tree it has just made, and
+ * each listing was a READDIR to the host: fifteen thousand over node_modules
+ * straight after the install, on the M1, the last round trips of that read.
+ *
+ * The listing is a snapshot of the dcache taken when the stream starts (at
+ * opendir or rewinddir), kept on the open file and read with positions of its
+ * own. POSIX lets a stream reflect the directory as it was then; what it must
+ * not do is mix those positions with the server's, which a shared cache torn
+ * down mid-stream would, so this stream never reads anything else, and a
+ * directory no longer complete is asked of the server at its next rewind.
+ */
+struct fuse_lighter_dirent {
+	u64 ino;
+	u16 namelen;
+	u8 type;
+	char name[];
+};
+
+static size_t fuse_lighter_reclen(size_t namelen)
+{
+	return ALIGN(sizeof(struct fuse_lighter_dirent) + namelen, 8);
+}
+
+static int fuse_lighter_snapshot(struct file *file)
+{
+	struct fuse_file *ff = file->private_data;
+	struct dentry *dir = file->f_path.dentry;
+	struct dentry *d;
+	size_t need, used;
+	char *buf;
+
+again:
+	need = 0;
+	spin_lock(&dir->d_lock);
+	hlist_for_each_entry(d, &dir->d_children, d_sib) {
+		if (!(d->d_flags & DCACHE_DENTRY_CURSOR) && simple_positive(d))
+			need += fuse_lighter_reclen(d->d_name.len);
+	}
+	spin_unlock(&dir->d_lock);
+
+	buf = kvmalloc(need ?: 8, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+
+	used = 0;
+	spin_lock(&dir->d_lock);
+	hlist_for_each_entry(d, &dir->d_children, d_sib) {
+		struct fuse_lighter_dirent *de;
+		size_t reclen;
+
+		if (d->d_flags & DCACHE_DENTRY_CURSOR)
+			continue;
+		spin_lock_nested(&d->d_lock, DENTRY_D_LOCK_NESTED);
+		if (!simple_positive(d)) {
+			spin_unlock(&d->d_lock);
+			continue;
+		}
+		reclen = fuse_lighter_reclen(d->d_name.len);
+		if (used + reclen > need) {	/* it grew: count again */
+			spin_unlock(&d->d_lock);
+			spin_unlock(&dir->d_lock);
+			kvfree(buf);
+			goto again;
+		}
+		de = (struct fuse_lighter_dirent *)(buf + used);
+		de->ino = d_inode(d)->i_ino;
+		de->type = fs_umode_to_dtype(d_inode(d)->i_mode);
+		de->namelen = d->d_name.len;
+		memcpy(de->name, d->d_name.name, d->d_name.len);
+		used += reclen;
+		spin_unlock(&d->d_lock);
+	}
+	spin_unlock(&dir->d_lock);
+
+	kvfree(ff->readdir.lighter_snap);
+	ff->readdir.lighter_snap = buf;
+	ff->readdir.lighter_snap_len = used;
+	return 0;
+}
+
+static int fuse_lighter_readdir(struct file *file, struct dir_context *ctx)
+{
+	struct fuse_file *ff = file->private_data;
+	char *buf = ff->readdir.lighter_snap;
+	size_t off = 0;
+	loff_t pos;
+
+	if (!dir_emit_dots(file, ctx))
+		return 0;
+	/* Entry i is at position i + 2, after the dots. */
+	for (pos = 2; off < ff->readdir.lighter_snap_len; pos++) {
+		struct fuse_lighter_dirent *de = (void *)(buf + off);
+
+		off += fuse_lighter_reclen(de->namelen);
+		if (pos < ctx->pos)
+			continue;
+		if (!dir_emit(ctx, de->name, de->namelen, de->ino, de->type))
+			return 0;
+		ctx->pos = pos + 1;
+	}
+	return 0;
+}
+
 int fuse_readdir(struct file *file, struct dir_context *ctx)
 {
 	struct fuse_file *ff = file->private_data;
@@ -646,6 +751,15 @@ int fuse_readdir(struct file *file, struct dir_context *ctx)
 	if (fuse_is_bad(inode))
 		return -EIO;
 
+	if (ctx->pos == 0) {
+		kvfree(ff->readdir.lighter_snap);
+		ff->readdir.lighter_snap = NULL;
+		if (fuse_dir_complete(inode) && !fuse_lighter_snapshot(file))
+			return fuse_lighter_readdir(file, ctx);
+	} else if (ff->readdir.lighter_snap) {
+		return fuse_lighter_readdir(file, ctx);
+	}
+
 	err = UNCACHED;
 	if (ff->open_flags & FOPEN_CACHE_DIR)
 		err = fuse_readdir_cached(file, ctx);
