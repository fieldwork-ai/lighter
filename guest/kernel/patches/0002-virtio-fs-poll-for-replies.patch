+/*
+ * Whether a completed request may be ended right here.
+ *
+ * Background and async requests end through paths that take `fc->bg_lock` or
+ * call back into the filesystem, and the context that submitted a request may
+ * already hold either — `flush_bg_queue` calls into the transport with that
+ * lock held. They are handed to a worker instead, which is the same escape the
+ * interrupt path already uses for requests that may block.
+ */
+static bool virtio_fs_may_end_here(struct fuse_req *req)
+{
+	return !test_bit(FR_BACKGROUND, &req->flags) &&
+	       !test_bit(FR_ASYNC, &req->flags) &&
+	       !req->args->may_block;
+}
+
+/* Hands a completed request to a worker, as the interrupt path does. */
+static void virtio_fs_end_later(struct virtio_fs_vq *fsvq, struct fuse_req *req)
+{
+	struct virtio_fs_req_work *w;
+
+	w = kzalloc(sizeof(*w), GFP_NOFS | __GFP_NOFAIL);
+	INIT_WORK(&w->done_work, virtio_fs_complete_req_work);
+	w->fsvq = fsvq;
+	w->req = req;
+	schedule_work(&w->done_work);
+}
+
+/*
+ * Spins for a short while collecting replies, and ends them here.
+ *
+ * Callbacks are disabled for the duration so the device does not raise an
+ * interrupt nobody needs; `virtqueue_enable_cb` at the end reports whether
+ * anything slipped in while they were off, which is the one race this has.
+ */
+static void virtio_fs_poll_for_replies(struct virtio_fs_vq *fsvq)
+{
+	struct virtqueue *vq = fsvq->vq;
+	struct fuse_pqueue *fpq;
+	struct fuse_req *req, *next;
+	unsigned int len;
+	unsigned int token;
+	ktime_t deadline;
+	LIST_HEAD(reqs);
+
+	if (!poll_usecs || !fsvq->fud)
+		return;
+	fpq = &fsvq->fud->pq;
+
+	/*
+	 * The spin takes no lock. `fsvq->lock` is the same lock every other
+	 * thread needs to *submit*, so a loop that grabs it to ask "anything
+	 * yet?" starves the queue it is waiting on — and the answer is no
+	 * almost every time. With sixteen threads doing file system work at
+	 * once it was the difference between 75 and 43 microseconds a create.
+	 *
+	 * `virtqueue_poll` against an index captured up front is the lock-free
+	 * form of the same question. Callbacks stay off for the duration so the
+	 * device does not raise an interrupt nobody is waiting for.
+	 */
+	spin_lock(&fsvq->lock);
+	token = virtqueue_enable_cb_prepare(vq);
+	virtqueue_disable_cb(vq);
+	spin_unlock(&fsvq->lock);
+
+	deadline = ktime_add_us(ktime_get(), poll_usecs);
+	while (!virtqueue_poll(vq, token)) {
+		if (ktime_after(ktime_get(), deadline))
+			break;
+		cpu_relax();
+	}
+
+	spin_lock(&fsvq->lock);
+	while ((req = virtqueue_get_buf(vq, &len)) != NULL) {
+		spin_lock(&fpq->lock);
+		list_move_tail(&req->list, &reqs);
+		spin_unlock(&fpq->lock);
+	}
+	spin_unlock(&fsvq->lock);
+
+	spin_lock(&fsvq->lock);
+	if (!virtqueue_enable_cb(vq)) {
+		while ((req = virtqueue_get_buf(vq, &len)) != NULL) {
+			spin_lock(&fpq->lock);
+			list_move_tail(&req->list, &reqs);
+			spin_unlock(&fpq->lock);
+		}
+	}
+	spin_unlock(&fsvq->lock);
+
+	list_for_each_entry_safe(req, next, &reqs, list) {
+		list_del_init(&req->list);
+		if (virtio_fs_may_end_here(req))
+			virtio_fs_request_complete(req, fsvq);
+		else
+			virtio_fs_end_later(fsvq, req);
+	}
+}
