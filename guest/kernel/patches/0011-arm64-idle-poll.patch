arm64: poll before WFI in a guest

On hardware WFI is free to leave and an IPI wakes a core in under a
microsecond. Under a hypervisor WFI parks the host thread, and waking it
again costs the sender a trap to inject the interrupt and the receiver a
scheduler round trip on the host. Measured with `perf bench sched pipe`
pinned to two vCPUs in this guest: 19 µs a round trip, against 1.4 µs
with both ends on one vCPU — and OrbStack's guest does the two-vCPU trip
in 1.2 µs, with its host idle. Every cross-CPU wakeup of an installer's
thread pool paid that, which is where a package install's wall time went
while its CPU time matched.

So an idle core first spins for a bounded time with TIF_POLLING_NRFLAG
set, which arm64 did not define: the scheduler's `set_nr_if_polling` then
wakes it by writing TIF_NEED_RESCHED and sends no IPI at all. The window
adapts per CPU as the haltpoll governor's does (grow when a wakeup follows
soon after giving up, halve after a long sleep), capped at
`idle.poll_ns` (200 µs, 0 disables), so a really idle guest stops
spinning within a few rounds. The upstream arm64 haltpoll series is not in
6.18 or 7.0; this is the part of it that matters here, in the arch idle
entry rather than a cpuidle driver, because the guest has no cpuidle
driver and needs none.

Clear polling and test NEED_RESCHED together before WFI: the waker may
have suppressed its IPI just before polling timed out, or work may already
be pending at polling entry. In either case sleeping loses that wakeup.

After polling with interrupts enabled, return through the generic idle loop
before WFI so it can reprogram timers queued by an interrupt. A per-CPU
flag skips polling on the next iteration after a timeout.

The window grows only on a wakeup from outside: at idle entry the CPU
reads the timer its clock event device has programmed, and a block that
ends at that time was the timer, which says nothing about how soon the
next event from a device or another CPU will come, and whose time was
known, so spinning until it fires gains nothing over WFI. And past the
resting size (`idle.poll_local_ns`, 200 µs) it grows only on a wakeup
that traffic on a container's stream to an accelerator brought, counted
where sockmap moves it on sockets the guest agent marks (patch 0032): a
container talking to the Mac's GPU raises the cap to 5 ms so its client's
threads stay awake between the messages of a token, and a wakeup from
inside the guest, a thread pool's hand-off, earns no more than the
resting window. Without both, a guest that ticks every four milliseconds,
or one busy enough to wake every few, keeps the 5 ms cap grown for as
long as the stream is open: a detector holds its stream for its
lifetime, and the M1 spun a full host core for its idle home server.

--- a/arch/arm64/include/asm/thread_info.h
+++ b/arch/arm64/include/asm/thread_info.h
@@ -71,6 +71,7 @@
 #define TIF_SECCOMP		11	/* syscall secure computing */
 #define TIF_SYSCALL_EMU		12	/* syscall emulation active */
 #define TIF_PATCH_PENDING	13	/* pending live patching update */
+#define TIF_POLLING_NRFLAG	14	/* idle is polling for TIF_NEED_RESCHED */
 #define TIF_MEMDIE		18	/* is terminating due to OOM killer */
 #define TIF_FREEZE		19
 #define TIF_RESTORE_SIGMASK	20
@@ -98,6 +99,7 @@
 #define _TIF_SECCOMP		(1 << TIF_SECCOMP)
 #define _TIF_SYSCALL_EMU	(1 << TIF_SYSCALL_EMU)
 #define _TIF_PATCH_PENDING	(1 << TIF_PATCH_PENDING)
+#define _TIF_POLLING_NRFLAG	(1 << TIF_POLLING_NRFLAG)
 #define _TIF_UPROBE		(1 << TIF_UPROBE)
 #define _TIF_SINGLESTEP		(1 << TIF_SINGLESTEP)
 #define _TIF_32BIT		(1 << TIF_32BIT)
--- a/arch/arm64/kernel/idle.c
+++ b/arch/arm64/kernel/idle.c
@@ -5,6 +5,14 @@
 
 #include <linux/cpu.h>
 #include <linux/irqflags.h>
+#include <linux/minmax.h>
+#include <linux/moduleparam.h>
+#include <linux/percpu.h>
+#include <linux/sched/clock.h>
+#include <linux/sched/idle.h>
+#include <linux/cpumask.h>
+#include <linux/tick.h>
+#include <linux/timekeeping.h>
 
 #include <asm/barrier.h>
 #include <asm/cpuidle.h>
@@ -33,13 +41,175 @@
 }
 
 /*
+ * Polling before WFI, for a guest.
+ *
+ * On hardware WFI is free to leave and an IPI wakes a core in under a
+ * microsecond. Under a hypervisor WFI parks the host thread, and waking it
+ * again costs the sender a trap to inject the interrupt and the receiver a
+ * scheduler round trip on the host: fifteen to twenty microseconds a wakeup,
+ * paid on every cross-CPU wakeup of a thread pool. So a core that goes idle
+ * first spins for a bounded time with TIF_POLLING_NRFLAG set, in which case
+ * a waker only writes TIF_NEED_RESCHED and sends nothing, and the wakeup is a
+ * cache line rather than a trap.
+ *
+ * How long to spin adapts per CPU the way the haltpoll governor does: a
+ * wakeup that arrives soon after the CPU gave up polling doubles the window,
+ * a long sleep halves it, so a machine that is really idle stops spinning
+ * within a few rounds and costs the host nothing.
+ *
+ * Two things a wakeup must be to count as soon. Not the CPU's own timer:
+ * that says nothing about when the next event will come, and its time is
+ * known at idle entry, so spinning until it fires gains nothing over WFI.
+ * And, for any window past the resting size, a wakeup that traffic on a
+ * container's stream to an accelerator brought: a container talking to the
+ * Mac's GPU raises the cap to 5 ms so its client's threads stay awake
+ * between the messages of a token, and a wakeup from inside the guest, a
+ * thread pool's hand-off, earns no more than the resting window. Without
+ * both, a guest that ticks every four milliseconds, or one busy enough to
+ * wake every few, keeps a 5 ms cap grown for as long as the stream is
+ * open, one host core spun per idle vCPU; a detector holds its stream for
+ * its lifetime. The traffic is counted where sockmap moves it, on sockets
+ * the guest agent marks (net/core/skmsg.c).
+ */
+static unsigned int idle_poll_ns = 200000;
+module_param_named(poll_ns, idle_poll_ns, uint, 0644);
+static unsigned int idle_poll_grow_start_ns = 50000;
+module_param_named(poll_grow_start_ns, idle_poll_grow_start_ns, uint, 0644);
+/* The most a wakeup from inside the guest earns. */
+static unsigned int idle_poll_local_ns = 200000;
+module_param_named(poll_local_ns, idle_poll_local_ns, uint, 0644);
+
+static DEFINE_PER_CPU(u32, idle_poll_limit_ns);
+static DEFINE_PER_CPU(bool, idle_poll_halt_next);
+DEFINE_PER_CPU(unsigned long, idle_poll_traffic);
+
+/* Bytes on accelerator streams so far, every CPU's count summed. */
+static u64 __cpuidle idle_traffic(void)
+{
+	u64 total = 0;
+	int cpu;
+
+	for_each_possible_cpu(cpu)
+		total += per_cpu(idle_poll_traffic, cpu);
+	return total;
+}
+
+/* A wakeup this close to the programmed timer is the timer. */
+#define IDLE_TIMER_SLACK_NS	50000
+
+/*
+ * The next timer interrupt this CPU has programmed, as its clock event
+ * device holds it, KTIME_MAX with none. Read at idle entry, after the tick
+ * was stopped or kept, so it is the timer WFI would wake to.
+ */
+static u64 __cpuidle idle_next_timer_ns(void)
+{
+	u64 next;
+
+	instrumentation_begin();
+	next = ktime_to_ns(tick_nohz_get_next_hrtimer());
+	instrumentation_end();
+	return next;
+}
+
+static bool __cpuidle idle_timer_due(u64 next_timer_ns)
+{
+	u64 now;
+
+	instrumentation_begin();
+	now = ktime_get_mono_fast_ns();
+	instrumentation_end();
+	return now + IDLE_TIMER_SLACK_NS >= next_timer_ns;
+}
+
+static void __cpuidle idle_poll_adjust(u64 block_ns, bool timer_due,
+				       bool traffic)
+{
+	u32 limit = __this_cpu_read(idle_poll_limit_ns);
+	u32 cap = idle_poll_ns;
+
+	if (timer_due || block_ns > idle_poll_ns) {
+		limit /= 2;
+	} else {
+		if (!traffic)
+			cap = min(cap, idle_poll_local_ns);
+		if (limit > cap)
+			limit = max(limit / 2, cap);
+		else if (limit < idle_poll_grow_start_ns)
+			limit = idle_poll_grow_start_ns;
+		else
+			limit = min_t(u64, (u64)limit * 2, cap);
+	}
+	__this_cpu_write(idle_poll_limit_ns, limit);
+}
+
+/* Returns true if a wakeup arrived while polling, so WFI is not needed. */
+static bool __cpuidle idle_poll(u64 *start)
+{
+	u32 limit = __this_cpu_read(idle_poll_limit_ns);
+
+	*start = local_clock_noinstr();
+	if (!limit)
+		return false;
+
+	raw_local_irq_enable();
+	if (!current_set_polling_and_test()) {
+		unsigned int count = 0;
+
+		while (!need_resched()) {
+			cpu_relax();
+			if (count++ < 200)
+				continue;
+			count = 0;
+			if (local_clock_noinstr() - *start > limit)
+				goto out;
+		}
+	}
+out:
+	raw_local_irq_disable();
+	/* A waker observing polling sends no IPI. Clear, order, then test
+	 * NEED_RESCHED so work arriving at the deadline also prevents WFI.
+	 */
+	return current_clr_polling_and_test();
+}
+
+/*
  * This is our default idle handler.
  */
 void __cpuidle arch_cpu_idle(void)
 {
+	u64 start, next_timer, traffic;
+
+	if (!idle_poll_ns) {
+		cpu_do_idle();
+		return;
+	}
+
+	next_timer = idle_next_timer_ns();
+	traffic = idle_traffic();
+	if (__this_cpu_read(idle_poll_limit_ns) &&
+	    !__this_cpu_read(idle_poll_halt_next)) {
+		bool woke = idle_poll(&start);
+
+		__this_cpu_write(idle_poll_halt_next, !woke);
+		if (woke)
+			idle_poll_adjust(local_clock_noinstr() - start,
+					 idle_timer_due(next_timer),
+					 idle_traffic() != traffic);
+		/* Polling enabled IRQs: an interrupt may have queued a timer
+		 * without setting NEED_RESCHED. Return through do_idle() to
+		 * reprogram the stopped tick before the next iteration's WFI.
+		 */
+		return;
+	}
+	__this_cpu_write(idle_poll_halt_next, false);
+	start = local_clock_noinstr();
+
 	/*
 	 * This should do all the clock switching and wait for interrupt
 	 * tricks
 	 */
 	cpu_do_idle();
+	idle_poll_adjust(local_clock_noinstr() - start, idle_timer_due(next_timer),
+			 idle_traffic() != traffic);
 }
