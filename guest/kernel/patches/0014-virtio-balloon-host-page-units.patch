+	BUILD_BUG_ON((VIRTIO_BALLOON_PAGES_PER_PAGE << VIRTIO_BALLOON_UNIT_MAX_ORDER) >
+		     VIRTIO_BALLOON_ARRAY_PFNS_MAX);
 
