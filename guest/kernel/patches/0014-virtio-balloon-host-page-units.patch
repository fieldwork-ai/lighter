+	for (num_pfns = 0; num_pfns < num;) {
+		/* The largest unit that fits what is still asked for. */
+		while (order > VIRTIO_BALLOON_UNIT_MIN_ORDER &&
+		       (VIRTIO_BALLOON_PAGES_PER_PAGE << order) > num - num_pfns)
+			order--;
+		page = alloc_pages(balloon_mapping_gfp_mask() |
+				   __GFP_NOMEMALLOC | __GFP_NORETRY |
+				   __GFP_NOWARN | __GFP_COMP, order);
 
 		if (!page) {
+			/* Nothing that large is free: a smaller unit, then. */
+			if (order > VIRTIO_BALLOON_UNIT_MIN_ORDER) {
+				order--;
+				continue;
+			}
