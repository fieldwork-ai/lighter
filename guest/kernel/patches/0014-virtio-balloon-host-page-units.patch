--- a/drivers/virtio/virtio_balloon.c
+++ b/drivers/virtio/virtio_balloon.c
@@ -25,6 +25,20 @@
  * page units.
  */
 #define VIRTIO_BALLOON_PAGES_PER_PAGE (unsigned int)(PAGE_SIZE >> VIRTIO_BALLOON_PFN_SHIFT)
+/*
+ * lighter: the balloon inflates in units of a host page. On Apple silicon
+ * the host page is 16 KiB and the guest's is 4 KiB, and a balloon that
+ * hands back single guest pages hands back almost nothing the host can
+ * release: only an aligned run of four is a host page, and a fragmented
+ * guest yields few. Measured: three quarters of a gigabyte inflated, the
+ * host's footprint unmoved, the guest's cache gone. So each unit is an
+ * order-2 compound page — sixteen aligned kilobytes, always releasable —
+ * and the balloon's accounting stays in 4 KiB pfns as the device expects.
+ * Balloon page migration is off in this kernel; a compound page does not
+ * migrate through the single-page path.
+ */
+#define VIRTIO_BALLOON_UNIT_ORDER 2
+#define VIRTIO_BALLOON_PFNS_PER_UNIT (VIRTIO_BALLOON_PAGES_PER_PAGE << VIRTIO_BALLOON_UNIT_ORDER)
 #define VIRTIO_BALLOON_ARRAY_PFNS_MAX 256
 /* Maximum number of (4k) pages to deflate on OOM notifications. */
 #define VIRTIO_BALLOON_OOM_NR_PAGES 256
@@ -228,13 +242,13 @@
 {
 	unsigned int i;
 
-	BUILD_BUG_ON(VIRTIO_BALLOON_PAGES_PER_PAGE > VIRTIO_BALLOON_ARRAY_PFNS_MAX);
+	BUILD_BUG_ON(VIRTIO_BALLOON_PFNS_PER_UNIT > VIRTIO_BALLOON_ARRAY_PFNS_MAX);
 
 	/*
 	 * Set balloon pfns pointing at this page.
 	 * Note that the first pfn points at start of the page.
 	 */
-	for (i = 0; i < VIRTIO_BALLOON_PAGES_PER_PAGE; i++)
+	for (i = 0; i < VIRTIO_BALLOON_PFNS_PER_UNIT; i++)
 		pfns[i] = cpu_to_virtio32(vb->vdev,
 					  page_to_balloon_pfn(page) + i);
 }
@@ -250,13 +264,16 @@
 	num = min(num, ARRAY_SIZE(vb->pfns));
 
 	for (num_pfns = 0; num_pfns < num;
-	     num_pfns += VIRTIO_BALLOON_PAGES_PER_PAGE) {
-		page = balloon_page_alloc();
+	     num_pfns += VIRTIO_BALLOON_PFNS_PER_UNIT) {
+		page = alloc_pages(balloon_mapping_gfp_mask() |
+				   __GFP_NOMEMALLOC | __GFP_NORETRY |
+				   __GFP_NOWARN | __GFP_COMP,
+				   VIRTIO_BALLOON_UNIT_ORDER);
 
 		if (!page) {
 			dev_info_ratelimited(&vb->vdev->dev,
 					     "Out of puff! Can't get %u pages\n",
-					     VIRTIO_BALLOON_PAGES_PER_PAGE);
+					     VIRTIO_BALLOON_PFNS_PER_UNIT);
 			/* Sleep for at least 1/5 of a second before retry. */
 			msleep(200);
 			break;
@@ -273,11 +290,12 @@
 		balloon_page_enqueue(&vb->vb_dev_info, page);
 
 		set_page_pfns(vb, vb->pfns + vb->num_pfns, page);
-		vb->num_pages += VIRTIO_BALLOON_PAGES_PER_PAGE;
+		vb->num_pages += VIRTIO_BALLOON_PFNS_PER_UNIT;
 		if (!virtio_has_feature(vb->vdev,
 					VIRTIO_BALLOON_F_DEFLATE_ON_OOM))
-			adjust_managed_page_count(page, -1);
-		vb->num_pfns += VIRTIO_BALLOON_PAGES_PER_PAGE;
+			adjust_managed_page_count(page,
+						  -(1 << VIRTIO_BALLOON_UNIT_ORDER));
+		vb->num_pfns += VIRTIO_BALLOON_PFNS_PER_UNIT;
 	}
 
 	num_allocated_pages = vb->num_pfns;
@@ -297,9 +315,10 @@
 	list_for_each_entry_safe(page, next, pages, lru) {
 		if (!virtio_has_feature(vb->vdev,
 					VIRTIO_BALLOON_F_DEFLATE_ON_OOM))
-			adjust_managed_page_count(page, 1);
+			adjust_managed_page_count(page,
+						  1 << VIRTIO_BALLOON_UNIT_ORDER);
 		list_del(&page->lru);
-		put_page(page); /* balloon reference */
+		put_page(page); /* balloon reference; the whole compound unit */
 	}
 }
 
@@ -317,13 +336,13 @@
 	/* We can't release more pages than taken */
 	num = min(num, (size_t)vb->num_pages);
 	for (vb->num_pfns = 0; vb->num_pfns < num;
-	     vb->num_pfns += VIRTIO_BALLOON_PAGES_PER_PAGE) {
+	     vb->num_pfns += VIRTIO_BALLOON_PFNS_PER_UNIT) {
 		page = balloon_page_dequeue(vb_dev_info);
 		if (!page)
 			break;
 		set_page_pfns(vb, vb->pfns + vb->num_pfns, page);
 		list_add(&page->lru, &pages);
-		vb->num_pages -= VIRTIO_BALLOON_PAGES_PER_PAGE;
+		vb->num_pages -= VIRTIO_BALLOON_PFNS_PER_UNIT;
 	}
 
 	num_freed_pages = vb->num_pfns;
@@ -472,7 +491,7 @@
 	 * Aligned up to guest page size to avoid inflating and deflating
 	 * balloon endlessly.
 	 */
-	target = ALIGN(num_pages, VIRTIO_BALLOON_PAGES_PER_PAGE);
+	target = ALIGN(num_pages, VIRTIO_BALLOON_PFNS_PER_UNIT);
 	return target - vb->num_pages;
 }
 
