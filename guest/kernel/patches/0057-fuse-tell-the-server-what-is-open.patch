fuse: tell the server which files are open, in batches

With no_open the server never hears of an open, so it cannot keep a file
reachable while something has it open: a Mac program that deletes a file
the guest is reading, or saves over it (a temporary renamed into place),
takes it away, and the guest's next read fails or, worse, reads another
file. OrbStack, Docker Desktop and Apple's virtiofs keep it, because
their servers hold a descriptor per open.

Answering OPEN to learn of them costs a blocking round trip per open and
another per release (virtio-fs releases synchronously): ripgrep over a
warm tree, which otherwise sends nothing to the server at all, took 7.7
times as long. A request per open sent without waiting still cost a warm
walk 15% and made a copy twice as long. So the driver reports in batches
instead: an inode's first open and its last close are collected for up
to a tick and sent as one FUSE_LIGHTER_NOTICES request of {nodeid,
delta} entries, and an open whose last close arrives within the tick
cancels out. Files opened and closed at once, which is nearly all of
them, are never mentioned; the server hears of the ones that stay open,
and holds each until its close. Measured against not reporting at all,
interleaved: warm grep -r over 20,000 files 107-114 against 110-112 ms,
open+close 0.79 against 0.80 us, cp -a unchanged.

A tick is 4 ms at this kernel's 250 Hz. A 1 ms hrtimer was measured too
and costs a warm walk 5-10%: the flush it schedules wakes a worker every
millisecond while files are opening, though nearly every batch has
emptied itself by then. A Mac-side delete within the tick after an open
finds the file unprotected, and the guest's read gets ESTALE, never
another file's bytes; in 160 tries at 0 to 12 ms after the open, one
did.

Gated on FUSE_LIGHTER_OPEN_NOTICE, an init flag no other server sets, so
an unpatched server keeps the stock behavior bit for bit.

diff --git a/fs/fuse/file.c b/fs/fuse/file.c
index 6b0809e84..10e9ba8df 100644
--- a/fs/fuse/file.c
+++ b/fs/fuse/file.c
@@ -209,6 +209,158 @@ static void fuse_link_write_file(struct file *file)
 	spin_unlock(&fi->lock);
 }
 
+/*
+ * lighter: with no_open the server never hears of an open, so it cannot keep
+ * a file reachable while something has it open: a Mac program that deletes
+ * the file, or saves over it, takes it away from a reader in the guest.
+ *
+ * So the driver tells it which files are open — but not one request per
+ * open, which costs a read-heavy workload more than everything else it
+ * sends (ripgrep over a warm tree sends nothing else at all). Changes are
+ * collected for up to a tick and sent as one batch, and an open whose last
+ * close arrives first cancels out: a file opened and closed within the tick
+ * is never mentioned. The server learns of the files that stay open, which
+ * are the only ones there is anything to protect.
+ */
+#define FUSE_LIGHTER_NOTICE_BATCH 128
+
+struct fuse_lighter_notices {
+	spinlock_t lock;
+	unsigned int n;
+	struct fuse_lighter_notice e[FUSE_LIGHTER_NOTICE_BATCH];
+	struct delayed_work work;
+	struct fuse_mount *fm;
+};
+
+struct fuse_lighter_batch {
+	struct fuse_args args;
+	unsigned int n;
+	struct fuse_lighter_notice e[];
+};
+
+static void fuse_lighter_batch_end(struct fuse_args *args, int error)
+{
+	kfree(container_of(args, struct fuse_lighter_batch, args));
+}
+
+/* With the lock held: the pending changes, or NULL if there are none. */
+static struct fuse_lighter_batch *fuse_lighter_take(struct fuse_lighter_notices *ln)
+{
+	struct fuse_lighter_batch *b;
+
+	if (!ln->n)
+		return NULL;
+	b = kzalloc(struct_size(b, e, ln->n), GFP_ATOMIC);
+	if (!b)
+		return NULL;
+	b->n = ln->n;
+	memcpy(b->e, ln->e, ln->n * sizeof(ln->e[0]));
+	ln->n = 0;
+	return b;
+}
+
+static void fuse_lighter_send(struct fuse_mount *fm, struct fuse_lighter_batch *b)
+{
+	b->args.opcode = FUSE_LIGHTER_NOTICES;
+	b->args.nodeid = FUSE_ROOT_ID;
+	b->args.in_numargs = 1;
+	b->args.in_args[0].size = b->n * sizeof(b->e[0]);
+	b->args.in_args[0].value = b->e;
+	b->args.force = true;
+	b->args.nocreds = true;
+	b->args.end = fuse_lighter_batch_end;
+	if (fuse_simple_background(fm, &b->args, GFP_KERNEL | __GFP_NOFAIL))
+		kfree(b);
+}
+
+static void fuse_lighter_flush(struct work_struct *work)
+{
+	struct fuse_lighter_notices *ln =
+		container_of(to_delayed_work(work), struct fuse_lighter_notices, work);
+	struct fuse_lighter_batch *b;
+
+	spin_lock(&ln->lock);
+	b = fuse_lighter_take(ln);
+	spin_unlock(&ln->lock);
+	if (b)
+		fuse_lighter_send(ln->fm, b);
+}
+
+int fuse_lighter_notices_start(struct fuse_mount *fm)
+{
+	struct fuse_lighter_notices *ln = kzalloc(sizeof(*ln), GFP_KERNEL);
+
+	if (!ln)
+		return -ENOMEM;
+	spin_lock_init(&ln->lock);
+	INIT_DELAYED_WORK(&ln->work, fuse_lighter_flush);
+	ln->fm = fm;
+	fm->fc->lighter_notices = ln;
+	return 0;
+}
+
+void fuse_lighter_notices_stop(struct fuse_conn *fc)
+{
+	struct fuse_lighter_notices *ln = fc->lighter_notices;
+
+	if (!ln)
+		return;
+	fc->lighter_notices = NULL;
+	cancel_delayed_work_sync(&ln->work);
+	kfree(ln);
+}
+
+static void fuse_lighter_note(struct fuse_conn *fc, u64 nodeid, s64 delta)
+{
+	struct fuse_lighter_notices *ln = fc->lighter_notices;
+	struct fuse_lighter_batch *full = NULL;
+	bool arm = false;
+	unsigned int i;
+
+	if (!ln)
+		return;
+	spin_lock(&ln->lock);
+	for (i = 0; i < ln->n; i++)
+		if (ln->e[i].nodeid == nodeid)
+			break;
+	if (i < ln->n) {
+		ln->e[i].delta += delta;
+		if (!ln->e[i].delta)
+			ln->e[i] = ln->e[--ln->n];
+	} else {
+		if (ln->n == FUSE_LIGHTER_NOTICE_BATCH)
+			full = fuse_lighter_take(ln);
+		if (ln->n < FUSE_LIGHTER_NOTICE_BATCH) {
+			ln->e[ln->n].nodeid = nodeid;
+			ln->e[ln->n].delta = delta;
+			arm = ++ln->n == 1;
+		}
+	}
+	spin_unlock(&ln->lock);
+	if (full)
+		fuse_lighter_send(ln->fm, full);
+	if (arm)
+		queue_delayed_work(system_wq, &ln->work, 1);
+}
+
+static void fuse_lighter_opened(struct inode *inode, struct fuse_file *ff)
+{
+	struct fuse_conn *fc = ff->fm->fc;
+
+	if (!fc->lighter_notices || !fc->no_open || !S_ISREG(inode->i_mode))
+		return;
+	ff->lighter_open = true;
+	if (atomic_inc_return(&get_fuse_inode(inode)->lighter_opens) == 1)
+		fuse_lighter_note(fc, get_node_id(inode), 1);
+}
+
+static void fuse_lighter_closed(struct inode *inode, struct fuse_file *ff)
+{
+	if (ff->lighter_open &&
+	    atomic_dec_and_test(&get_fuse_inode(inode)->lighter_opens))
+		fuse_lighter_note(ff->fm->fc, get_node_id(inode), -1);
+}
+
 int fuse_finish_open(struct inode *inode, struct file *file)
 {
 	struct fuse_file *ff = file->private_data;
@@ -227,6 +379,8 @@ int fuse_finish_open(struct inode *inode, struct file *file)
 	if ((file->f_mode & FMODE_WRITE) && fc->writeback_cache)
 		fuse_link_write_file(file);
 
+	fuse_lighter_opened(inode, ff);
+
 	return 0;
 }
 
@@ -401,6 +555,7 @@ static int fuse_release(struct inode *inode, struct file *file)
 	if (fc->writeback_cache)
 		write_inode_now(inode, 1);
 
+	fuse_lighter_closed(inode, file->private_data);
 	fuse_release_common(file, false);
 
 	/* return value is ignored by VFS */
diff --git a/fs/fuse/fuse_i.h b/fs/fuse/fuse_i.h
