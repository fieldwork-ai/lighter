+	/* lighter: files open on this inode, with FUSE_LIGHTER_OPEN_NOTICE */
+	atomic_t lighter_opens;
+
 	/** Number of lookups on this inode */
 	u64 nlookup;
 
@@ -267,6 +270,9 @@ struct fuse_file {
 	/** File handle used by userspace */
 	u64 fh;
 
+	/* lighter: counted in its inode's lighter_opens */
+	bool lighter_open;
+
 	/** Node id of this file */
 	u64 nodeid;
 
@@ -749,6 +755,9 @@ struct fuse_conn {
 	/* lighter: an attribute can name its caller as owner or group. */
 	unsigned lighter_caller_owns:1;
 
+	/* lighter: open-file notices, batched; NULL unless the server asked. */
+	struct fuse_lighter_notices *lighter_notices;
+
 	/*
 	 * The following bitfields are only for optimization purposes
 	 * and hence races in setting them will not cause malfunction
@@ -1137,6 +1146,10 @@ extern const struct file_operations fuse_dev_operations;
 
 extern const struct dentry_operations fuse_dentry_operations;
 
+/* lighter: open-file notices (file.c) */
+int fuse_lighter_notices_start(struct fuse_mount *fm);
+void fuse_lighter_notices_stop(struct fuse_conn *fc);
+
 /**
  * Get a filled in inode
  */
diff --git a/fs/fuse/inode.c b/fs/fuse/inode.c
index 1448dc595..79c448fb0 100644
--- a/fs/fuse/inode.c
+++ b/fs/fuse/inode.c
@@ -1511,6 +1511,8 @@ static void process_init_reply(struct fuse_args *args, int error)
 				fc->lighter_trust_dentries = 1;
 			if (flags & FUSE_LIGHTER_CALLER_OWNS)
 				fc->lighter_caller_owns = 1;
+			if (flags & FUSE_LIGHTER_OPEN_NOTICE)
+				fuse_lighter_notices_start(fm);
 			if (flags & FUSE_SETXATTR_EXT)
 				fc->setxattr_ext = 1;
 			if (flags & FUSE_SECURITY_CTX)
@@ -1609,7 +1611,8 @@ static struct fuse_init_args *fuse_new_init(struct fuse_mount *fm)
 		FUSE_REQUEST_TIMEOUT | FUSE_LIGHTER_CREATE |
 		FUSE_LIGHTER_CLONE_SUPPORT |
 		FUSE_LIGHTER_NO_SECURITY_XATTR | FUSE_LIGHTER_NOOP_SETATTR |
-		FUSE_LIGHTER_TRUST_DENTRIES | FUSE_LIGHTER_CALLER_OWNS;
+		FUSE_LIGHTER_TRUST_DENTRIES | FUSE_LIGHTER_CALLER_OWNS |
+		FUSE_LIGHTER_OPEN_NOTICE;
 #ifdef CONFIG_FUSE_DAX
 	if (fm->fc->dax)
 		flags |= FUSE_MAP_ALIGNMENT;
@@ -2204,6 +2207,7 @@ void fuse_conn_destroy(struct fuse_mount *fm)
 {
 	struct fuse_conn *fc = fm->fc;
 
+	fuse_lighter_notices_stop(fc);
 	if (fc->destroy)
 		fuse_send_destroy(fm);
 
diff --git a/include/uapi/linux/fuse.h b/include/uapi/linux/fuse.h
index c32b729b0..8808ece3e 100644
--- a/include/uapi/linux/fuse.h
+++ b/include/uapi/linux/fuse.h
@@ -397,6 +397,13 @@ struct fuse_file_lock {
  * skip its pre-create LOOKUP and still set FMODE_CREATED honestly. */
 #define FOPEN_LIGHTER_CREATED	(1 << 15)
 
+/* lighter: one entry of FUSE_LIGHTER_NOTICES — an inode's open files changed
+ * by delta (+1 its first open, -1 its last close) since the last batch. */
+struct fuse_lighter_notice {
+	uint64_t	nodeid;
+	int64_t	delta;
+};
+
 /**
  * INIT request/reply flags
  *
@@ -523,6 +530,9 @@ struct fuse_file_lock {
 /* lighter: an attribute flagged FUSE_ATTR_LIGHTER_CALLER_UID or _GID has no
  * owner of its own here, and belongs to whoever asks. */
 #define FUSE_LIGHTER_CALLER_OWNS	(1ULL << 56)
+/* lighter: with no_open, the driver reports which regular files are open, in
+ * batches (FUSE_LIGHTER_NOTICES), so the server can keep them reachable. */
+#define FUSE_LIGHTER_OPEN_NOTICE	(1ULL << 55)
 
 /**
  * CUSE INIT request/reply flags
@@ -690,6 +700,7 @@ enum fuse_opcode {
 	FUSE_COPY_FILE_RANGE	= 47,
 	/* lighter's dialect: numbered far above anything mainline assigns. */
 	FUSE_LIGHTER_CLONE	= 62000,
+	FUSE_LIGHTER_NOTICES	= 62003,
 	FUSE_SETUPMAPPING	= 48,
 	FUSE_REMOVEMAPPING	= 49,
 	FUSE_SYNCFS		= 50,
