 /* Returns true if a wakeup arrived while polling, so WFI is not needed. */
+/* Per CPU: how each poll ended (timed out; woken with an interrupt taken on
+ * this CPU during it; woken with none, the case polling exists for), and the
+ * nanoseconds each kind spent. */
+enum { POLLED_TIMEOUT, POLLED_IRQ, POLLED_REMOTE, POLLED_KINDS };
+static DEFINE_PER_CPU(u64, idle_polled_n[POLLED_KINDS]);
+static DEFINE_PER_CPU(u64, idle_polled_ns[POLLED_KINDS]);
+
+static int idle_polled_get(char *buffer, const struct kernel_param *kp)
+{
+	int cpu, len = 0;
+
+	for_each_possible_cpu(cpu)
+		len += sysfs_emit_at(buffer, len, "%llu/%llu/%llu/%llu/%llu/%llu ",
+				     per_cpu(idle_polled_n[POLLED_TIMEOUT], cpu),
+				     per_cpu(idle_polled_ns[POLLED_TIMEOUT], cpu),
+				     per_cpu(idle_polled_n[POLLED_IRQ], cpu),
+				     per_cpu(idle_polled_ns[POLLED_IRQ], cpu),
+				     per_cpu(idle_polled_n[POLLED_REMOTE], cpu),
+				     per_cpu(idle_polled_ns[POLLED_REMOTE], cpu));
+	len += sysfs_emit_at(buffer, len, "\n");
+	return len;
+}
+
+static const struct kernel_param_ops idle_polled_ops = {
+	.get = idle_polled_get,
+};
+module_param_cb(polled, &idle_polled_ops, NULL, 0444);
+
+/* Books a finished poll and, every poll_epoch, decides whether to go on. */
+static void __cpuidle idle_poll_account(unsigned int kind, u64 spent_ns, u64 now)
+{
+	u32 limit = __this_cpu_read(idle_poll_limit_ns);
+	/* While a model is talking, the reply it waits for arrives as an
+	 * interrupt, and a CPU already awake takes it without the host waking
+	 * a parked thread first: 8% of a token loop's rate. Then an interrupt
+	 * is a catch too, and a timeout no reason to shrink. */
+	bool traffic = idle_traffic_recent();
+	bool hit = kind == POLLED_REMOTE || (kind == POLLED_IRQ && traffic);
+	u32 n, hits;
+	u64 spent;
+
+	__this_cpu_inc(idle_polled_n[kind]);
+	__this_cpu_add(idle_polled_ns[kind], spent_ns);
+	__this_cpu_write(idle_poll_block_grow, hit);
+	if (kind == POLLED_TIMEOUT && !traffic)
+		__this_cpu_write(idle_poll_limit_ns, limit / 2);
+
+	n = __this_cpu_inc_return(idle_poll_epoch_n);
+	hits = __this_cpu_read(idle_poll_epoch_hits) + hit;
+	spent = __this_cpu_read(idle_poll_epoch_ns) + spent_ns;
+	__this_cpu_write(idle_poll_epoch_hits, hits);
+	__this_cpu_write(idle_poll_epoch_ns, spent);
+	if (n < idle_poll_epoch)
+		return;
+	if (!hits || spent > (u64)hits * idle_poll_cost_ns) {
+		u64 backoff = __this_cpu_read(idle_poll_backoff_ns);
+
+		backoff = backoff ? min_t(u64, backoff * 2, idle_poll_backoff_max_ns) :
+				    min_t(u64, 10 * NSEC_PER_MSEC, idle_poll_backoff_max_ns);
+		__this_cpu_write(idle_poll_backoff_ns, backoff);
+		__this_cpu_write(idle_poll_off_until, now + backoff);
+	} else {
+		__this_cpu_write(idle_poll_backoff_ns, 0);
+	}
+	__this_cpu_write(idle_poll_epoch_n, 0);
+	__this_cpu_write(idle_poll_epoch_hits, 0);
+	__this_cpu_write(idle_poll_epoch_ns, 0);
+}
