+#define FOPEN_LIGHTER_CREATED	(1 << 15)
 
 /**
  * INIT request/reply flags
@@ -495,6 +499,11 @@ struct fuse_file_lock {
 #define FUSE_ALLOW_IDMAP	(1ULL << 40)
 #define FUSE_OVER_IO_URING	(1ULL << 41)
 #define FUSE_REQUEST_TIMEOUT	(1ULL << 42)
+/* lighter: the server speaks lighter's create dialect. FUSE_CREATE without a
+ * prior LOOKUP is handled for existing files too, FOPEN_LIGHTER_CREATED is
+ * truthful, and the server pushes invalidations for whatever it changes
+ * underneath the driver. */
+#define FUSE_LIGHTER_CREATE	(1ULL << 60)
 
 /**
  * CUSE INIT request/reply flags
