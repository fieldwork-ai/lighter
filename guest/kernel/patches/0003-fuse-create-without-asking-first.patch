fuse: skip the LOOKUP a create pays for an answer CREATE already gives

Opening a file with O_CREAT costs this driver two round trips before the
CREATE itself: a LOOKUP whose only purpose is to learn "no such file" —
which for a package install is the answer every single time — and, after
the create, a GETATTR of the parent directory the driver invalidated
with its own hands.

Both questions have answers the driver already holds. The LOOKUP exists
so FMODE_CREATED can be set truthfully and so a directory or symlink in
the way is discovered before committing; but a server that creates with
O_EXCL first knows whether it created, says so in the open reply
(FOPEN_LIGHTER_CREATED), refuses a directory with EISDIR — the answer
open(2) gives anyway — and turns a trailing symlink into ELOOP, on
which the driver falls back to the ordinary lookup path so the VFS can
walk it. The parent invalidation exists in case the server's view of
the directory moved; but this change was ours, the server pushes an
invalidation when anyone else's shows up, and the attribute timeout
already bounds the drift for host-side changes — so the driver
advances mtime and ctime in place instead.

Gated on FUSE_LIGHTER_CREATE, an init flag no other server sets, so an
unpatched server keeps the stock behavior bit for bit.

diff --git a/fs/fuse/dir.c b/fs/fuse/dir.c
index a013fad84..2c4471c01 100644
--- a/fs/fuse/dir.c
+++ b/fs/fuse/dir.c
@@ -131,6 +131,24 @@ void fuse_invalidate_attr(struct inode *inode)
 
 static void fuse_dir_changed(struct inode *dir)
 {
+	struct fuse_conn *fc = get_fuse_conn(dir);
+
+	/*
+	 * lighter: this change is one we made ourselves, so the attributes in
+	 * hand are the freshest anyone has. Advance the times locally instead
+	 * of paying a GETATTR on the next walk through this directory; the
+	 * server pushes an invalidation if anything changes underneath us,
+	 * and size/nlink drift no further than the attribute timeout — the
+	 * same promise a host-side change already has.
+	 */
+	if (fc->lighter_create) {
+		struct timespec64 now = current_time(dir);
+
+		inode_set_mtime_to_ts(dir, now);
+		inode_set_ctime_to_ts(dir, now);
+		inode_maybe_inc_iversion(dir, false);
+		return;
+	}
 	fuse_invalidate_attr(dir);
 	inode_maybe_inc_iversion(dir, false);
 }
@@ -699,6 +717,16 @@ static int fuse_create_open(struct mnt_idmap *idmap, struct inode *dir,
 	    fuse_invalid_attr(&outentry.attr))
 		goto out_free_ff;
 
+	/*
+	 * lighter: when the LOOKUP was skipped, whether this open CREATED the
+	 * file is the server's answer, not our assumption. FMODE_CREATED
+	 * zeroes acc_mode in do_open(), so claiming it for a file that
+	 * already existed would skip the permission check on it.
+	 */
+	if (opcode == FUSE_CREATE && fm->fc->lighter_create &&
+	    !(outopenp->open_flags & FOPEN_LIGHTER_CREATED))
+		file->f_mode &= ~FMODE_CREATED;
+
 	ff->fh = outopenp->fh;
 	ff->nodeid = outentry.nodeid;
 	ff->open_flags = outopenp->open_flags;
@@ -712,7 +740,15 @@ static int fuse_create_open(struct mnt_idmap *idmap, struct inode *dir,
 		goto out_err;
 	}
 	kfree(forget);
-	d_instantiate(entry, inode);
+	/*
+	 * lighter: with the LOOKUP skipped the dentry is still in lookup;
+	 * d_add() hashes it and wakes waiters, so the next walk to this name
+	 * hits the dcache instead of paying the LOOKUP later.
+	 */
+	if (d_in_lookup(entry))
+		d_add(entry, inode);
+	else
+		d_instantiate(entry, inode);
 	entry->d_time = epoch;
 	fuse_change_entry_timeout(entry, &outentry);
 	fuse_dir_changed(dir);
@@ -754,7 +790,19 @@ static int fuse_atomic_open(struct inode *dir, struct dentry *entry,
 		return -EIO;
 
 	if (d_in_lookup(entry)) {
-		struct dentry *res = fuse_lookup(dir, entry, 0);
+		struct dentry *res;
+
+		/*
+		 * lighter: for O_CREAT the CREATE reply carries everything a
+		 * LOOKUP would have said, so asking first is a wasted round
+		 * trip — two thirds of the requests a package install makes.
+		 * The one shape CREATE cannot express, a trailing symlink the
+		 * VFS must walk itself, comes back as ELOOP and takes the
+		 * ordinary path below.
+		 */
+		if (fc->lighter_create && (flags & O_CREAT) && !fc->no_create)
+			goto create;
+		res = fuse_lookup(dir, entry, 0);
 		if (res || d_really_is_positive(entry))
 			return finish_no_open(file, res);
 	}
@@ -762,6 +810,7 @@ static int fuse_atomic_open(struct inode *dir, struct dentry *entry,
 	if (!(flags & O_CREAT))
 		return finish_no_open(file, NULL);
 
+create:
 	/* Only creates */
 	file->f_mode |= FMODE_CREATED;
 
@@ -772,8 +821,17 @@ static int fuse_atomic_open(struct inode *dir, struct dentry *entry,
 	if (err == -ENOSYS) {
 		fc->no_create = 1;
 		goto mknod;
-	} else if (err == -EEXIST)
+	} else if (err == -EEXIST) {
 		fuse_invalidate_entry(entry);
+	} else if (err == -ELOOP && d_in_lookup(entry)) {
+		struct dentry *res;
+
+		file->f_mode &= ~FMODE_CREATED;
+		res = fuse_lookup(dir, entry, 0);
+		if (IS_ERR(res))
+			return PTR_ERR(res);
+		return finish_no_open(file, res);
+	}
 	return err;
 
 mknod:
diff --git a/fs/fuse/fuse_i.h b/fs/fuse/fuse_i.h
index c288f28f6..34d615741 100644
--- a/fs/fuse/fuse_i.h
+++ b/fs/fuse/fuse_i.h
@@ -759,6 +759,12 @@ struct fuse_conn {
 	 */
 	unsigned handle_killpriv_v2:1;
 
+	/*
+	 * lighter: FUSE_CREATE may be sent without a prior LOOKUP, and the
+	 * reply says whether the file was created (FOPEN_LIGHTER_CREATED).
+	 */
+	unsigned lighter_create:1;
+
 	/*
 	 * The following bitfields are only for optimization purposes
 	 * and hence races in setting them will not cause malfunction
diff --git a/fs/fuse/inode.c b/fs/fuse/inode.c
index e9ed693fc..9b9bd6ee8 100644
--- a/fs/fuse/inode.c
+++ b/fs/fuse/inode.c
@@ -1409,6 +1409,8 @@ static void process_init_reply(struct fuse_mount *fm, struct fuse_args *args,
 				fc->handle_killpriv_v2 = 1;
 				fm->sb->s_flags |= SB_NOSEC;
 			}
+			if (flags & FUSE_LIGHTER_CREATE)
+				fc->lighter_create = 1;
 			if (flags & FUSE_SETXATTR_EXT)
 				fc->setxattr_ext = 1;
 			if (flags & FUSE_SECURITY_CTX)
@@ -1503,7 +1505,7 @@ static struct fuse_init_args *fuse_new_init(struct fuse_mount *fm)
 		FUSE_SECURITY_CTX | FUSE_CREATE_SUPP_GROUP |
 		FUSE_HAS_EXPIRE_ONLY | FUSE_DIRECT_IO_ALLOW_MMAP |
 		FUSE_NO_EXPORT_SUPPORT | FUSE_HAS_RESEND | FUSE_ALLOW_IDMAP |
-		FUSE_REQUEST_TIMEOUT;
+		FUSE_REQUEST_TIMEOUT | FUSE_LIGHTER_CREATE;
 #ifdef CONFIG_FUSE_DAX
 	if (fm->fc->dax)
 		flags |= FUSE_MAP_ALIGNMENT;
