--- a/net/vmw_vsock/virtio_transport_common.c
+++ b/net/vmw_vsock/virtio_transport_common.c
@@ -80,6 +80,49 @@ static bool virtio_transport_can_zcopy(const struct virtio_transport *t_ops,
 	return true;
 }
 
+/* Pages a kernel caller offers by reference (skb_send_sock from a sockmap
+ * redirect) go into the packet as fragments, by reference: no copy, and no
+ * completion to report. Each bvec segment is one fragment of the caller's
+ * skb and becomes one of ours, so a span of a compound page stays one
+ * fragment where the generic splice helper would cut it into pages and run
+ * out of fragments. Takes what fits and says so through the header's
+ * length; the bytes taken are charged to the socket as the zero-copy path
+ * charges its pages.
+ */
+static int virtio_transport_take_pages(struct sk_buff *skb,
+				       struct iov_iter *iter, size_t len)
+{
+	int i = skb_shinfo(skb)->nr_frags;
+	const struct bio_vec *bv;
+	size_t taken = 0, skip;
+
+	if (!iter || !iov_iter_is_bvec(iter))
+		return -EINVAL;
+
+	bv = iter->bvec;
+	skip = iter->iov_offset;
+	while (taken < len && taken < iter->count && i < MAX_SKB_FRAGS) {
+		size_t part = min(len - taken, (size_t)bv->bv_len - skip);
+
+		if (!sendpage_ok(bv->bv_page))
+			return -EIO;
+		get_page(bv->bv_page);
+		skb_fill_page_desc(skb, i++, bv->bv_page, bv->bv_offset + skip,
+				   part);
+		taken += part;
+		skip = 0;
+		bv++;
+	}
+	if (!taken)
+		return -EMSGSIZE;
+	iov_iter_advance(iter, taken);
+	skb_len_add(skb, taken);
+	refcount_add(taken, &skb->sk->sk_wmem_alloc);
+	if (taken != len)
+		virtio_vsock_hdr(skb)->len = cpu_to_le32(taken);
+	return 0;
+}
+
