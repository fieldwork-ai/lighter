#!/bin/sh
# PID 1 in the lighter guest.
#
# Not openrc, not systemd. There are four things to do in a fixed order, none of
# them conditional on hardware we might or might not have, and a service manager
# here would add a second of boot and a layer of indirection over a sequence
# that fits on one screen.
#
# The order matters:
#   1. pseudo-filesystems, because everything below reads them
#   2. the data disk, because dockerd's storage driver needs it mounted first
#   3. dockerd, which takes a moment to come up
#   4. the agent, which must not advertise a socket dockerd is not answering yet
set -eu

# The kernel hands init an environment of exactly HOME and TERM — there is no
# PATH. busybox's shell falls back to a default for its own lookups, but never
# exports one, so every child process inherits an environment with no PATH at
# all. dockerd then starts, fails to find containerd, and reports "executable
# file not found in $PATH" about a binary sitting in /usr/bin.
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export HOME=/root

# The kernel's initial 1024/4096 descriptor limits are too small for a
# connection burst through the agent and Docker's splice-pipe proxy. Set
# both limits before any engine or agent inherits them; descriptors are
# allocated on demand, not reserved by raising this ceiling.
ulimit -n 65536 || echo "INIT nofile=65536 failed"

# No `busybox --install -s` here, and it matters. Alpine already ships every
# applet symlink, and busybox resolves its own path through /proc/self/exe —
# which is not mounted yet at this point in init. Without it, the install
# writes a symlink from /bin/busybox to itself, and every applet in the image
# becomes ELOOP. What that looks like from outside is init exiting 127 several
# steps later, at whichever command happened to be next.
#
# The initramfs does need it, because there busybox is the only binary in the
# image and nothing else has made the links.

mount -t proc     proc     /proc
mount -t sysfs    sysfs    /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
# The modes udev gives these on any distribution; there is no udev here, and
# devtmpfs leaves both 0600, so a rootless engine inside a container cannot set
# up its network (tun) or fuse-overlayfs (fuse). Docker copies the mode into
# every container that gets the device. Opening either grants nothing alone:
# an interface still takes CAP_NET_ADMIN and a mount still takes a mount.
chmod 0666 /dev/net/tun /dev/fuse 2>/dev/null || true
mount -t tmpfs    tmpfs    /run
mkdir -p /dev/pts /dev/shm
mount -t devpts devpts /dev/pts 2>/dev/null || true
mount -t tmpfs  tmpfs  /dev/shm

# cgroup v2 only. Docker supports both, and offering v1 as well means the engine
# picks one based on what it finds rather than on what we intended.
mount -t cgroup2 cgroup2 /sys/fs/cgroup 2>/dev/null || true

hostname "$(cat /etc/hostname 2>/dev/null || echo lighter)"
ip link set lo up

# The GPU, when the machine has one, as a CDI device: `docker run --device
# lighter.sh/gpu=all` gets the render node. dockerd reads /etc/cdi on its
# own; nothing else is needed for a container to reach Vulkan, its own Mesa
# does the rest.
if [ -e /dev/dri/renderD128 ]; then
	mkdir -p /etc/cdi
	cat > /etc/cdi/lighter.yaml <<-EOF
	cdiVersion: "0.6.0"
	kind: lighter.sh/gpu
	devices:
	  - name: all
	    containerEdits:
	      deviceNodes:
	        - path: /dev/dri/renderD128
	EOF
	echo "INIT gpu=/dev/dri/renderD128"
fi

# The video decoder and encoder, when the machine has them (virtio-media
# devices the kernel registers as V4L2 nodes, the decoder first):
# `docker run --device lighter.sh/video=all` gets /dev/video0 and
# /dev/video1, and stock ffmpeg's h264_v4l2m2m and friends decode and encode
# on the Mac's media engine through them.
if [ -e /dev/video0 ]; then
	mkdir -p /etc/cdi
	nodes=""
	for node in /dev/video*; do
		nodes="$nodes$(printf '\n        - path: %s' "$node")"
	done
	cat > /etc/cdi/lighter-video.yaml <<-EOF
	cdiVersion: "0.6.0"
	kind: lighter.sh/video
	devices:
	  - name: all
	    containerEdits:
	      deviceNodes:$nodes
	EOF
	echo "INIT video=$(echo /dev/video*)"
fi

# The Neural Engine, when the host serves one (`lighter.ane=<port>`): a CDI
# device that gives a container lighter's ONNX Runtime plugin provider and
# the address it forwards to, the Mac's loopback through the streams.
for arg in $(cat /proc/cmdline); do
	case "$arg" in
	lighter.ane=*)
		mkdir -p /etc/cdi
		cat > /etc/cdi/lighter-ane.yaml <<-EOF
		cdiVersion: "0.6.0"
		kind: lighter.sh/ane
		devices:
		  - name: all
		    containerEdits:
		      env:
		        - LIGHTER_ANE=192.168.127.254:${arg#lighter.ane=}
		        - LIGHTER_ANE_EP=/usr/lib/lighter/liblighter_ane_ep.so
		      mounts:
		        - hostPath: /usr/lib/lighter/liblighter_ane_ep.so
		          containerPath: /usr/lib/lighter/liblighter_ane_ep.so
		          options: ["ro", "bind"]
		EOF
		echo "INIT ane=port ${arg#lighter.ane=}"
		;;
	lighter.mps=*)
		mkdir -p /etc/cdi
		cat > /etc/cdi/lighter-mps.yaml <<-EOF
		cdiVersion: "0.6.0"
		kind: lighter.sh/mps
		devices:
		  - name: all
		    containerEdits:
		      env:
		        - LIGHTER_MPS=192.168.127.254:${arg#lighter.mps=}
		        - PIP_FIND_LINKS=/usr/lib/lighter/wheels
		      mounts:
		        - hostPath: /usr/lib/lighter/wheels
		          containerPath: /usr/lib/lighter/wheels
		          options: ["ro", "bind"]
		EOF
		echo "INIT mps=port ${arg#lighter.mps=}"
		;;
	lighter.metal=*)
		mkdir -p /etc/cdi
		cat > /etc/cdi/lighter-metal.yaml <<-EOF
		cdiVersion: "0.6.0"
		kind: lighter.sh/metal
		devices:
		  - name: all
		    containerEdits:
		      env:
		        - LIGHTER_METAL=192.168.127.254:${arg#lighter.metal=}
		        - LLAMA_ARG_RPC=192.168.127.254:${arg#lighter.metal=}
		EOF
		echo "INIT metal=port ${arg#lighter.metal=}"
		;;
	esac
done

# The machine has no RTC, so the guest starts at the epoch. That is not a
# cosmetic problem: every TLS handshake to a registry fails on a certificate
# that is not valid yet, and the error names the certificate rather than the
# clock. The host passes its own time on the command line.
#
# This is a starting point, not timekeeping — it does not survive the host
# sleeping. Resync over vsock is milestone 8's job.
for arg in $(cat /proc/cmdline); do
	case "$arg" in
	lighter.time=*)
		date -s "@${arg#lighter.time=}" >/dev/null 2>&1 \
			&& echo "INIT clock=$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
			|| echo "INIT clock=failed"
		;;
	esac
done

echo "INIT filesystems=ok"

# --- The data disk --------------------------------------------------------
# /dev/vdb is Docker's storage. It is separate from the root disk so that the
# root image can be replaced on upgrade without touching anyone's images, and so
# that the thing that grows is the thing that gets punched back to nothing.
DATA_DEV=/dev/vdb
# The data disk is btrfs, as OrbStack's is: its reflinks make a
# copy_file_range a clone, which is how yarn links a package tree and how cp
# copies one — on ext4 that was a real copy, 1.4 GB per install and its
# writeback, and half of yarn's system time. `lighter.data_fs=ext4|xfs`
# formats a blank disk otherwise, so the alternatives stay measurable.
DATA_FS=btrfs
for arg in $(cat /proc/cmdline); do
	case "$arg" in
	lighter.data_fs=*) DATA_FS="${arg#lighter.data_fs=}" ;;
	esac
done
if [ -b "$DATA_DEV" ]; then
	# A blank disk has no filesystem; making one on first boot is what turns a
	# freshly created sparse file into usable storage with no setup step.
	if ! blkid "$DATA_DEV" >/dev/null 2>&1; then
		# `lighter.data_mkfs=` on the kernel command line adds options to
		# the format — a journal left out, say — for the same reason as the
		# mount options below: to be measured, not guessed at.
		DATA_MKFS=""
		for arg in $(cat /proc/cmdline); do
			case "$arg" in
			lighter.data_mkfs=*) DATA_MKFS="${arg#lighter.data_mkfs=}" ;;
			esac
		done
		echo "INIT formatting=$DATA_DEV fs=$DATA_FS mkfs=$DATA_MKFS"
		if [ "$DATA_FS" = btrfs ]; then
			# Single metadata: the default duplicates it against a bad
			# sector, and this disk is a file whose sectors are the
			# Mac's to lose or keep.
			# shellcheck disable=SC2086
			mkfs.btrfs -q -f -L lighter-data -m single $(echo "$DATA_MKFS" | tr ',' ' ') "$DATA_DEV"
		elif [ "$DATA_FS" = xfs ]; then
			# shellcheck disable=SC2086
			mkfs.xfs -q -f -L lighter-data $(echo "$DATA_MKFS" | tr ',' ' ') "$DATA_DEV"
		else
			# shellcheck disable=SC2086
			mke2fs -q -t ext4 -L lighter-data $(echo "$DATA_MKFS" | tr ',' ' ') "$DATA_DEV"
		fi
	fi
	# Journaling on Docker's disk is metadata-only, with no write barriers
	# and a thirty-second commit — the same crash semantics as OrbStack's
	# nodatacow btrfs, chosen to match it: after a VMM crash a file written
	# in the last moments may hold stale blocks rather than be short. The
	# barrier costs nothing here (the guest's flush is a host fsync into the
	# Mac's page cache either way) and ordered data cost yarn twelve percent
	# on its own disk. Anything that must survive a crash fsyncs, and fsync
	# is honored.
	#
	# Discard is deliberately not a mount option. Online discard is issued
	# from the journal commit, and in writeback mode that turned deleting a
	# package tree from a third of a second into three: the trim is batched
	# instead, by the fstrim loop below, which is what makes deleting an
	# image give space back to macOS at all — each trimmed range reaches
	# virtio-blk as a discard and becomes a hole punch in the host file.
	#
	# `lighter.data_opts=` on the kernel command line replaces these
	# outright, so a different setting can be measured without a rebuild of
	# this image.
	# The options follow the filesystem the disk actually carries, not the
	# one a blank disk would be given: a disk formatted before the default
	# changed is still ext4, and mounting it with btrfs's options fails —
	# after which dockerd starts on the root filesystem and dies there.
	DATA_TYPE="$(blkid -o value -s TYPE "$DATA_DEV" 2>/dev/null || echo "$DATA_FS")"
	echo "INIT data_fs=${DATA_TYPE:-unknown}"
	DATA_OPTS=noatime,nobarrier,commit=30,data=writeback
	case "$DATA_TYPE" in
	# nodatacow, as OrbStack mounts it: data is written in place and not
	# checksummed, which keeps a database's file from fragmenting into a
	# thousand extents and gives the crash semantics described above.
	# Clones still share extents; the first write to a shared one copies.
	btrfs) DATA_OPTS=noatime,nodatacow,commit=30,thread_pool=1 ;;
	xfs) DATA_OPTS=noatime ;;
	esac
	for arg in $(cat /proc/cmdline); do
		case "$arg" in
		lighter.data_opts=*) DATA_OPTS="${arg#lighter.data_opts=}" ;;
		esac
	done
	echo "INIT data_opts=$DATA_OPTS"
	# No I/O scheduler on a virtual disk: the host's page cache is behind it
	# and there is nothing to reorder for. mq-deadline, the kernel's default
	# for a single-queue virtio-blk, cost a sync of twenty thousand fresh
	# files twice its time (330 ms to 160).
	echo none > "/sys/block/${DATA_DEV#/dev/}/queue/scheduler" 2>/dev/null
	if mount -o "$DATA_OPTS" "$DATA_DEV" /mnt/data; then
		echo "INIT data=mounted"
		# The host grows the image when `lighter config --disk` asks for
		# more; the filesystem follows it here, online, and is left alone
		# when it already fills the device.
		# Never fatal: init is `set -e`, and a disk that could not grow still
		# boots at the size it had.
		before=$(df -k /mnt/data 2>/dev/null | awk 'NR==2 {print $2}') || true
		case "$DATA_TYPE" in
		btrfs) btrfs filesystem resize max /mnt/data >/dev/null 2>&1 || echo "INIT data_grow=failed" ;;
		xfs) xfs_growfs /mnt/data >/dev/null 2>&1 || echo "INIT data_grow=failed" ;;
		ext4) resize2fs "$DATA_DEV" >/dev/null 2>&1 || echo "INIT data_grow=failed" ;;
		esac
		after=$(df -k /mnt/data 2>/dev/null | awk 'NR==2 {print $2}') || true
		if [ "$before" != "$after" ]; then
			echo "INIT data_grown=${before}KiB->${after}KiB"
		fi
		# `lighter.data_warm=<GiB>`: an experiment's knob. btrfs allocates
		# its block groups on first use, a gigabyte of data at a time with
		# the chunk, device and free-space trees written for each; a file
		# preallocated and removed leaves the groups behind, so a first
		# write onto never-used space costs what a write onto used space
		# does. Measured against the first-touch cost of the guest's disk.
		for arg in $(cat /proc/cmdline); do
			case "$arg" in
			lighter.data_warm=*)
				warm="${arg#lighter.data_warm=}"
				fallocate -l "${warm}G" /mnt/data/.warm 2>/dev/null && rm -f /mnt/data/.warm && sync && echo "INIT data_warm=${warm}G"
				;;
			esac
		done
		mkdir -p /mnt/data/docker
		mount --bind /mnt/data/docker /var/lib/docker
		# The first trim after a mount covers every free block group, so
		# it is done here, before Docker has anything in flight, and timed
		# into the boot log. Trimmed ranges are cheap to re-trim (ext4
		# remembers which groups it has done), so the short period after
		# that costs nothing on an idle machine and a deleted image is back
		# with macOS within minutes rather than at the next reboot.
		T0=$(cut -d' ' -f1 /proc/uptime)
		fstrim /mnt/data >/dev/null 2>&1 || true
		T1=$(cut -d' ' -f1 /proc/uptime)
		echo "INIT fstrim=$(echo "$T1 $T0" | awk '{printf "%dms", ($1-$2)*1000}')"
		# `lighter.fstrim_period=` (seconds; 0 disables the loop) is for
		# measuring the loop's cost against a run.
		FSTRIM_PERIOD=300
		for arg in $(cat /proc/cmdline); do
			case "$arg" in
			lighter.fstrim_period=*) FSTRIM_PERIOD="${arg#lighter.fstrim_period=}" ;;
			esac
		done
		if [ "$FSTRIM_PERIOD" -gt 0 ]; then
			(while sleep "$FSTRIM_PERIOD"; do fstrim /mnt/data >/dev/null 2>&1; done) &
		fi
	else
		echo "INIT data=mount-failed"
	fi
else
	echo "INIT data=absent"
fi

# --- zram ------------------------------------------------------------------
# Swap into compressed RAM, for a guest with nothing left: the kernel
# reaches for it only under real pressure (vm.swappiness is zero below), and
# a guest sized by virtio-mem rarely sees any. The agent's trims never swap:
# moving dockerd and containerd here at idle was measured at 60 MiB less and
# a second on the next docker command. `lighter.zram=0` leaves it out.
if [ -e /sys/block/zram0/disksize ] && ! grep -qw lighter.zram=0 /proc/cmdline; then
	echo 2G > /sys/block/zram0/disksize 2>/dev/null \
		&& mkswap /dev/zram0 >/dev/null 2>&1 \
		&& swapon -p 100 /dev/zram0 2>/dev/null \
		&& echo "INIT zram=on" || echo "INIT zram=off"
	# Swap is for the agent's trims and for a guest with nothing left, not
	# for the kernel's ordinary reclaim: an install's working set is its
	# cache, and a kernel that swapped a little of node's heap to keep
	# more of it read yarn a tenth slower on the M1 and npm on its own
	# disk half as fast again on the M5.
	sysctl -q -w vm.swappiness=0 2>/dev/null || true
fi

# --- Limits ---------------------------------------------------------------
# threads-max is set at boot from the RAM there is then, and a cooperative
# machine boots with 2 GiB of what grows to tens: its 15,793 threads ran out
# under a browser test and took the agent's outbound proxy with them (0.10.4).
# Memory, the cgroups and each container's pids.max decide instead, as on any
# server.
sysctl -q -w kernel.threads-max=4194304 kernel.pid_max=4194304 2>/dev/null || true
# The inotify limits are sized the same way, from the boot RAM: 15,783 watches
# on a cooperative machine, which two Next.js dev servers on a monorepo use up
# (issue #49), and a container cannot raise them for itself. A watch costs
# kernel memory only once something makes it.
sysctl -q -w fs.inotify.max_user_watches=524288 fs.inotify.max_user_instances=1024 2>/dev/null || true

# --- containerd -----------------------------------------------------------
# Started here, the moment the data disk is there, rather than by dockerd.
# dockerd's own managed containerd is started and then polled once a second,
# and the first poll always missed, so every boot carried a second of waiting
# for a process that was up in twenty milliseconds (dockerd's log: 1041 ms
# between "started new containerd process" and the graph driver). Here it
# comes up while the network and the shares are being set up, and dockerd
# finds it ready. The same root dockerd would have given it, so either
# arrangement finds the other's content. Without the CRI plugin, which is
# Kubernetes' door and a tenth of a second of start-up nobody here uses.
#
# The engine's cgroup is made here because containerd is the first of the
# engine's processes: the page cache a process fills is charged to its
# cgroup, and the root cgroup cannot be asked to reclaim, so both daemons
# live in one the agent can trim (see its bound_container_cache).
# Establish the containers' parent before the first container runs, so the
# agent can distinguish an empty hierarchy from unavailable population data.
mkdir -p /var/log /run/containerd /sys/fs/cgroup/engine /sys/fs/cgroup/docker
echo +memory > /sys/fs/cgroup/cgroup.subtree_control 2>/dev/null || true
# RCU grace periods expedited from here on. A container's start and stop
# wait on several (cgroups, netfilter rules, namespaces), each a few jiffies
# at HZ=250; expedited they are microseconds. `docker run --rm alpine true`
# 150 to 110 ms on the M5, with installs and idle unchanged (2026-09-05).
echo 1 > /sys/kernel/rcu_expedited 2>/dev/null || true
# Not every wait is a synchronize_rcu: taking a network device down ends in
# rcu_barrier, twice, and those are normal grace periods whatever the switch
# above says. The grace-period thread sleeps one jiffy before its first
# scan for quiescent CPUs; with most vCPUs idle there is nothing to wait
# for, and told not to it finds them at once. A/B/A on the M5: a container
# run 150 → 131–140 → 149–158 ms, veth delete 45 → 31 ms, idle unchanged.
# The next-scan interval stays at its default: zero there would spin the
# thread through a long grace period.
echo 0 > /sys/module/rcutree/parameters/jiffies_till_first_fqs 2>/dev/null || true
# containerd 2 splits CRI into three plugins, and with only the gRPC one
# off the runtime plugin still ran its event monitor's one-second
# back-off ticker: with Go's sysmon and poller behind each firing, a fifth
# of the wakeups an idle guest made were a Kubernetes shim in a Docker
# guest. NRI exists for CRI. The optional plugins beyond these (the
# cgroup monitor and metrics, tracing, the restart monitor) were measured
# and cost nothing; the health-check plugin must stay, since dockerd polls
# it and reconnects in a storm without it.
# The garbage collector's scheduler (plugins/gc/scheduler.go) collects once
# at start-up, then, whenever its timer fires with nothing to collect,
# re-arms it for its interval and waits again — for the life of the
# process. The interval after a collection is the average collection time
# over the pause threshold, 5 ms over 0.02: a quarter of a second. That
# loop was every one of containerd's idle wakeups (135 in 8 s against 5
# with it off) and a third of an idle guest's timer interrupts. No
# start-up delay means no start-up collection, so the loop never arms on a
# machine that runs nothing; a pause threshold of zero leaves the interval
# at a second for after the first collection a deletion does trigger. The
# fix that belongs upstream is the scheduler not re-arming when there is
# nothing to do.
cat > /run/containerd.toml <<'TOML'
version = 2
disabled_plugins = ["io.containerd.grpc.v1.cri", "io.containerd.cri.v1.runtime", "io.containerd.cri.v1.images", "io.containerd.nri.v1.nri"]
[plugins."io.containerd.gc.v1.scheduler"]
  startup_delay = "0s"
  pause_threshold = 0.0
TOML
# A fresh shell rather than a subshell: in a subshell `$$` is still the
# parent's pid, and the engine ran in the root cgroup for a day.
# The engine is shielded from the OOM killer (-900; the agent is -1000):
# a container filling memory faster than the guest can grow had the killer
# take dockerd, containerd and the agent by their size before it took the
# writer, and the machine with them. Containers themselves stay at zero.
sh -c '
	echo $$ > /sys/fs/cgroup/engine/cgroup.procs 2>/dev/null
	echo -900 > /proc/self/oom_score_adj 2>/dev/null
	exec containerd \
		--config /run/containerd.toml \
		--address /run/containerd/containerd.sock \
		--root /var/lib/docker/containerd \
		--state /run/containerd/state \
		>/var/log/containerd.log 2>&1' engine &
CONTAINERD_PID=$!

# --- Running x86-64 containers --------------------------------------------
# `binfmt_misc` is how Linux learns that an ELF it cannot execute should be
# handed to an interpreter instead. With this registered, `docker run
# --platform linux/amd64` works with no further arrangement: the kernel sees an
# x86-64 header and runs the interpreter against it.
#
# The interpreter is Rosetta when the host attached its share (the command
# line says `lighter.rosetta`). Rosetta runs x86-64 at about two thirds of
# native speed and asks the kernel for x86 memory ordering on its own threads
# (PR_SET_MEM_MODEL, kernel patch 0023); nothing here has to. There is no
# emulator behind it: qemu ran the same programs at a tenth of native speed,
# which is slow enough to read as broken, and shipped an emulator in every
# image for the Macs that had not installed Rosetta. Without the share, the
# handler is a copy of the agent that says what to install and exits, so an
# amd64 image fails with the fix in its output rather than "exec format
# error".
#
# The `F` flag is the load-bearing one. Without it the kernel resolves the
# interpreter path at exec time — inside the container's mount namespace, where
# neither path exists. With it, the interpreter is opened once, here, and the
# open file is what every later exec uses. That is the difference between this
# working everywhere and working only outside containers. `O` and `C` open the
# binary itself with the caller's credentials, which is what lets a setuid
# program inside a container behave.
if mount -t binfmt_misc binfmt_misc /proc/sys/fs/binfmt_misc 2>/dev/null; then
	interpreter=/sbin/lighter-noamd64
	via=hint
	flags=F
	if grep -qw lighter.rosetta /proc/cmdline; then
		mkdir -p /mnt/rosetta
		if mount -t virtiofs rosetta /mnt/rosetta 2>/dev/null && [ -x /mnt/rosetta/rosetta ]; then
			interpreter=/mnt/rosetta/rosetta
			via=rosetta
			flags=OCF
		else
			echo "INIT rosetta=unmountable"
		fi
	fi
	# `%s` and not a bare format string, because the escapes must reach the
	# kernel *as text*: binfmt_misc unquotes `\xHH` itself. Letting the shell
	# expand them first writes real NUL bytes, `write` stops at the first one,
	# and the kernel registers a truncated magic — which then matches every
	# 64-bit ELF, hands each one to an x86 emulator, and turns the next
	# command in this script into `exit 127`.
	printf '%s\n' ":x86_64:M::\x7fELF\x02\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\x3e\x00:\xff\xff\xff\xff\xff\xfe\xfe\x00\xff\xff\xff\xff\xff\xff\xff\xff\xfe\xff\xff\xff:$interpreter:$flags" \
		> /proc/sys/fs/binfmt_misc/register 2>/dev/null || true
	# Checked by looking, not by the exit status of a redirect into procfs,
	# which is not a reliable report of whether the kernel accepted the entry.
	if [ -f /proc/sys/fs/binfmt_misc/x86_64 ]; then
		echo "INIT binfmt=x86_64 via=$via"
	else
		echo "INIT binfmt=failed"
	fi
else
	echo "INIT binfmt=unavailable"
fi

# --- Shared directories ---------------------------------------------------
# Mounted before dockerd, because a container's bind mount resolves against
# this namespace and a share that appears later is a path the engine already
# decided did not exist.
#
# The tag is the only handle the guest has on a virtio-fs device — nothing
# enumerates them — so the host names each one on the command line.
devagent=""
for arg in $(cat /proc/cmdline); do
	case "$arg" in
	lighter.devagent=*)
		# A development copy of the agent, read from a share once mounted:
		# an agent change is then a 30-second build and a reboot, not a
		# rootfs image. Only ever passed by the developer's own command
		# line; nothing in the product sets it.
		devagent=${arg#lighter.devagent=}
		;;
	lighter.share=*)
		spec=${arg#lighter.share=}
		tag=${spec%%:*}
		at=${spec#*:}
		mkdir -p "$at"
		if mount -t virtiofs "$tag" "$at"; then
			echo "INIT share=$tag at=$at"
		else
			echo "INIT share=$tag at=$at failed"
		fi
		;;
	esac
done
AGENT=/sbin/lighter-agent
if [ -n "$devagent" ] && [ -f "$devagent" ]; then
	if cp "$devagent" /run/lighter-agent && chmod +x /run/lighter-agent; then
		AGENT=/run/lighter-agent
		echo "INIT devagent=$devagent"
	else
		echo "INIT devagent=$devagent unusable; the built-in agent runs"
	fi
fi

# Every agent is restarted if it exits. Each one is a whole feature (the
# Docker socket, the Mac's control, containers' TCP, DNS), and the one that
# died in 0.10.3 took containers' egress with it until the machine restarted.
# A restart is on the console and in /run/lighter/agent-restarts, which the
# control channel reports.
supervise() {
	(
		# Not `set -e` in here: an agent's exit is what this loop is for.
		set +e
		pause=1
		while :; do
			started=$(cut -d. -f1 /proc/uptime)
			"$AGENT" "$@"
			status=$?
			if [ $(( $(cut -d. -f1 /proc/uptime) - started )) -ge 60 ]; then
				pause=1
			fi
			echo "INIT agent exited: $* status=$status; restarting in ${pause}s"
			mkdir -p /run/lighter && echo "$*" >> /run/lighter/agent-restarts
			sleep "$pause"
			pause=$(( pause * 2 ))
			if [ "$pause" -gt 30 ]; then
				pause=30
			fi
		done
	) &
}

# --- Networking -----------------------------------------------------------
# A socket may ask for a send buffer up to this; the agent asks for 8 MiB
# on every stream, because a vsock packet's memory stays charged to its
# socket until the host has taken it off the ring, and the default ceiling
# is under one packet.
sysctl -q -w net.core.wmem_max=16777216 net.core.rmem_max=16777216 fs.pipe-max-size=16777216 2>/dev/null || true
# Keep the allocator's default defrag_mode=0. Forcing fragmentation
# avoidance refused ordinary allocation fallbacks on a small guest even
# with ample free memory, reclaiming package metadata thousands of times.
# The virtio-mem movable zone already separates memory that must unplug;
# normal allocator fallback and the idle compaction passes handle the rest.
# The per-CPU vm statistics fold once a second by default, a work item on
# every vCPU whose counters moved: on an idle 9-vCPU guest, 4 of its 38
# wakeups a second. Once every ten seconds is soon enough for /proc/vmstat;
# the kernel's own reclaim decisions read the counters directly.
sysctl -q -w vm.stat_interval=10 2>/dev/null || true
# khugepaged scans for pages to collapse every ten seconds and drains every
# CPU's LRU lists first — nine kworkers woken for a scan of an idle guest
# that finds nothing. Once a minute is plenty for a machine whose memory
# turns over between commands anyway.
echo 60000 > /sys/kernel/mm/transparent_hugepage/khugepaged/scan_sleep_millisecs 2>/dev/null || true
# TCP inside the guest carries a container's stream to the agent; its
# windows are what lets that leg run ahead of the vsock leg behind it. The
# defaults top out at 4 and 6 MB.
sysctl -q -w net.ipv4.tcp_wmem="4096 262144 16777216" net.ipv4.tcp_rmem="4096 1048576 16777216" 2>/dev/null || true
if [ -e /sys/class/net/eth0 ]; then
	# IPv6 on the link is static, like the lease with no expiry: no router
	# advertisements to accept, a forwarding host (dockerd would turn that
	# on anyway, and a forwarding host ignores advertisements), the
	# gateway's link-layer address pinned so nothing is solicited.
	sysctl -q -w net.ipv6.conf.eth0.accept_ra=0 net.ipv6.conf.all.forwarding=1 2>/dev/null || true
	ip link set eth0 up
	udhcpc -i eth0 -n -q -t 8 -T 2 >/dev/null 2>&1 && echo "INIT dhcp=ok t=$(cut -d' ' -f1 /proc/uptime)" || echo "INIT dhcp=failed"
	ip -6 addr add fd6c:6967:6874::2/64 dev eth0 nodad 2>/dev/null \
		&& ip -6 neigh replace fd6c:6967:6874::1 lladdr 5a:94:ef:e4:0c:dd dev eth0 nud permanent 2>/dev/null \
		&& ip -6 route add default via fd6c:6967:6874::1 dev eth0 2>/dev/null \
		&& echo "INIT ipv6=ok" || echo "INIT ipv6=failed"
fi

# --- The engine -----------------------------------------------------------
# dockerd is pointed at the containerd started above. It connects at once
# when the socket is there, and gives up in a way that reads as "containerd
# is never coming" when it is not, so the socket is waited for first — a few
# milliseconds normally, since containerd has had the network's whole set-up
# to come up in.
# --iptables is left on: Docker's own bridge networking needs it, and the
# kernel carries the netfilter modules for exactly this.
#
# The userland proxy stays on (Alpine 3.22 ships docker-proxy). Off, Docker
# 28 insists on br_netfilter for hairpin traffic and will not start without
# it, and br_netfilter is the one thing this guest must not have: it runs the
# IP prerouting hooks in bridge context for a container's frames, where the
# socket TPROXY assigns does not survive into routing, so a container's UDP
# never reached the agent while it was on — and Docker turns it on at every
# bridge network it makes, so a knob turned off here did not stay off. The
# kernel does not carry it. Published ports still reach a container by DNAT
# (the agent connects to the guest's own address, which Docker's nat OUTPUT
# chain rewrites); docker-proxy only carries what DNAT cannot, one container
# reaching another's published port through the host's own address.
#
# --mtu is the link's own, read back from eth0: the host terminates every
# flow on its side of the link, so the only thing the number decides is how
# many frames a byte costs between here and there, and a bridge left at 1500
# would have every container segment at 1460 whatever the link could carry.
#
# --seccomp-profile is Docker's own default with Podman's rule for the NUMA
# memory-policy calls (scripts/seccomp-profile.py, which says why): Docker's
# left x265 without a thread pool, 2.7 times slower.
link_mtu=$(cat /sys/class/net/eth0/mtu 2>/dev/null || echo 1500)
waited=0
while [ ! -S /run/containerd/containerd.sock ] && [ "$waited" -lt 200 ]; do
	kill -0 "$CONTAINERD_PID" 2>/dev/null || break
	sleep 0.01
	waited=$((waited + 1))
done
[ -S /run/containerd/containerd.sock ] || echo "INIT containerd=missing after=$((waited * 10))ms"
# Background preparation can reach Docker before all RAM is online.
# Docker restores containers internally, bypassing the host API inspector.
# Conservatively wait if any saved container exists, including stopped ones;
# do not parse Docker's private restart-policy metadata or change its semantics.
boot_ram_mib=""
for arg in $(cat /proc/cmdline); do
    case "$arg" in lighter.boot_ram_mib=*) boot_ram_mib="${arg#lighter.boot_ram_mib=}";; esac
done
if [ -n "$boot_ram_mib" ]; then
    for saved in /var/lib/docker/containers/*/config.v2.json; do
        if [ -f "$saved" ]; then
            /sbin/lighter-boot-memory "$boot_ram_mib"
            break
        fi
    done
fi
# USB devices the Mac attaches, each on its own stream to vhci-hcd: started
# before dockerd rather than with the other agents, because dockerd waits for
# the held ones (`lighter.usb_expect=`, at most fifteen seconds). A container
# whose `devices:` names a stick not there yet fails to start, and Docker
# never retries a start that failed: Zigbee2MQTT stayed down after every
# restart, its stick attached four seconds after dockerd was up.
supervise --usb 2384
if grep -q lighter.usb_expect= /proc/cmdline; then
	"$AGENT" --usb-expect
fi
# A port published on one of the Mac's own addresses (`-p 192.168.1.20:9000:9000`,
# a Tailscale address) is bound by dockerd on that address, which the guest
# does not have: refused, and the container never started, where Docker Desktop
# and OrbStack bind exactly that address on the Mac. The Mac side already binds
# what Docker reports; dockerd only needs to be allowed the bind. How the
# Mac's connections then reach the container is the output chain's (below).
sysctl -q -w net.ipv4.ip_nonlocal_bind=1 net.ipv6.ip_nonlocal_bind=1 2>/dev/null || true
# `lighter.dockerd_debug` on the command line: dockerd's debug log, whose
# timestamps are how a container start is taken apart.
dockerd_debug=""
grep -qw lighter.dockerd_debug /proc/cmdline && dockerd_debug="-D"
# `lighter.registry_mirror=<url>`: Docker Hub pulls through a cache. For the
# gates, which boot a machine with an empty image store each time and spent
# Docker Hub's anonymous pull limit for the whole network (2026-10-06).
registry_mirror=""
for arg in $(cat /proc/cmdline); do
	case "$arg" in lighter.registry_mirror=*) registry_mirror="--registry-mirror=${arg#lighter.registry_mirror=}" ;; esac
done
# --host-gateway-ip is what `--add-host name:host-gateway` writes. Left unset it
# is docker0's address in this guest, where nothing of the Mac's listens; it
# must be HOST_ALIAS (crates/lighter-vmm/src/dns.rs), what host.docker.internal
# answers and the streams carry to the Mac's loopback.
sh -c '
	echo $$ > /sys/fs/cgroup/engine/cgroup.procs 2>/dev/null
	echo -900 > /proc/self/oom_score_adj 2>/dev/null
	# BuildKit workers have no explicit OCI OOM score. Their runtime resets
	# inherited protection so a large build cannot evict all normal containers.
	export DOCKER_BUILDKIT_RUNC_COMMAND=/sbin/lighter-build-runc
	exec dockerd $2 $3 \
		--host=unix:///run/docker.sock \
		--containerd=/run/containerd/containerd.sock \
		--data-root=/var/lib/docker \
		--storage-driver=overlay2 \
		--mtu="$1" \
		--ipv6 --fixed-cidr-v6 fd6c:6967:6874:d0c::/64 --ip6tables \
		--host-gateway-ip=192.168.127.254 \
		--seccomp-profile=/etc/docker/seccomp.json \
		>/var/log/dockerd.log 2>&1' engine "$link_mtu" "$dockerd_debug" "$registry_mirror" &
DOCKERD_PID=$!

# Waiting for the socket rather than sleeping: dockerd's start time depends on
# what it finds on the data disk, so a fixed sleep is either too short on a full
# disk or wasted on an empty one.
#
# The liveness check is not belt-and-braces. dockerd creates its socket early
# and can die during later setup, leaving a socket file that accepts nothing —
# so waiting on the file alone reports "ready" for a daemon that is already
# gone, and the failure resurfaces much later as a bare ECONNREFUSED.
# Polled every 50 ms, not every second: the daemon is up in a few hundred
# milliseconds and a one-second poll made a machine wait most of a second
# for a socket that was already there.
waited=0
dockerd_state=timeout
while [ "$waited" -lt 1200 ]; do
	if ! kill -0 "$DOCKERD_PID" 2>/dev/null; then
		dockerd_state=died
		break
	fi
	if [ -S /run/docker.sock ]; then
		dockerd_state=ready
		break
	fi
	sleep 0.05
	waited=$((waited + 1))
done

echo "INIT dockerd=$dockerd_state after=$((waited * 50))ms t=$(cut -d' ' -f1 /proc/uptime)"
if [ "$dockerd_state" != ready ]; then
	echo "--- dockerd log ---"
	tail -30 /var/log/dockerd.log
	echo "--- end ---"
fi

# --- The agent ------------------------------------------------------------
# Started last, on purpose: it is what the host connects to, and advertising it
# before dockerd answers turns a slow start into a connection refused.
supervise --port 2375 --to /run/docker.sock

# The control channel, on its own port. The host uses it to put the clock right
# after the Mac has slept: the machine has no real-time clock, so a guest whose
# host suspended for an hour wakes an hour behind, and everything that checks a
# certificate starts failing with an error about the certificate.
supervise --port 2376 --control

# --- Streams --------------------------------------------------------------
# Every TCP connection that would leave through eth0 — from a container or
# from this machine — is redirected to the agent, which carries it to the
# host as a vsock stream; the host's kernel makes the real connection. UDP
# goes the same way by TPROXY. Only ARP, DHCP and ICMP still go out the
# network device, where the VMM answers them itself. `fib daddr oif` is the
# routing decision itself, so anything bound for a container, this machine,
# or a bridge is left alone without listing subnets that Docker changes at
# will. A container's traffic for the LAN card (eth1, LAN mode) is carried
# the same way, as a stream: its source is a bridge address nothing on the
# LAN could answer. Only the guest's own namespace, which host-network
# containers share, reaches the LAN directly.
{
	supervise --tcp-proxy 15201
	supervise --udp-proxy 15202
	supervise --inbound 2378
	supervise --udp-inbound
	# DNS answered by the Mac's resolver over the same channel. On eth0's
	# address rather than loopback: Docker copies this file into every
	# container and drops loopback nameservers on the way. The agent listens
	# on 15353, and the nat rules below send 192.168.127.2:53 to it, so the
	# guest's port 53 stays free for a container to publish (Pi-hole); a
	# query the Mac forwards to that published port carries the inbound mark
	# and is left for Docker.
	supervise --dns 192.168.127.2
	printf 'nameserver 192.168.127.2\n' > /etc/resolv.conf
	# The ruleset goes through a file: busybox's shell does not take a
	# heredoc on an `if` line the way bash does, and the rule that had
	# worked by hand failed at every boot.
	cat > /run/lighter.nft <<'EOF'
table inet lighter {
	chain prerouting {
		type nat hook prerouting priority dstnat - 10; policy accept;
		meta l4proto tcp iifname != "eth1" fib daddr oifname { "eth0", "eth1" } redirect to :15201
		ip daddr 192.168.127.2 udp dport 53 dnat ip to 192.168.127.2:15353
	}
	chain output {
		type nat hook output priority dstnat - 10; policy accept;
		# The agent's own connections for the Mac's (the inbound mark) are
		# never the guest's outbound: one to a port published on a Mac
		# address leaves by eth0 as far as routing knows, and redirected
		# here it went back to the Mac instead of to Docker.
		meta mark 0x4c494e42 return
		meta l4proto tcp oifname "eth0" redirect to :15201
		ip daddr 192.168.127.2 udp dport 53 meta mark != 0x4c494e42 dnat ip to 192.168.127.2:15353
	}
	# UDP by TPROXY rather than REDIRECT: a redirected datagram reaches the
	# agent with its destination already rewritten and no way back to the
	# original (the socket option that names it reports the rewritten
	# header; conntrack answers only for a connected socket). TPROXY hands
	# the datagram over untouched — the agent's socket is transparent — and
	# the policy route below is what makes a foreign destination deliverable
	# locally. DHCP excepted (the VMM answers it on the device); DNS is not:
	# the agent's resolver is on eth0's own address, which is never `oif
	# eth0`, and a container that names a resolver of its own (`--dns
	# 8.8.8.8`, `dig @1.1.1.1`) is a flow like any other. With 53 excepted
	# those datagrams reached the card and were dropped.
	chain divert {
		type filter hook prerouting priority mangle; policy accept;
		# A container's reply to a client of a published port: the agent
		# connected as that client (its inbound mark), so the reply is
		# addressed to the client, and goes back to the agent's socket by
		# the policy route below instead of out as outbound traffic. A mark
		# of its own for the route: the agent's socket carries 0x4c494e42,
		# and a route on that would send its own packets to lo too.
		ct direction reply ct mark 0x4c494e42 meta mark set 0x4c494e43 accept
		meta l4proto udp udp dport != { 67, 68 } iifname != "eth1" fib daddr oifname { "eth0", "eth1" } tproxy ip to :15202 meta mark set 0x1 accept
		meta l4proto udp udp dport != { 546, 547 } iifname != "eth1" fib daddr oifname { "eth0", "eth1" } tproxy ip6 to :15202 meta mark set 0x1 accept
	}
	chain inbound {
		type route hook output priority mangle; policy accept;
		meta mark 0x4c494e42 ct mark set meta mark
		# The same for a host-network container's reply: its server is in
		# this namespace, so the reply is local output rather than
		# prerouting, and left by eth0 for a client the agent was standing
		# in for. The mark set here re-routes it, by the same policy route.
		ct direction reply ct mark 0x4c494e42 meta mark set 0x4c494e43
	}
}
EOF
	ip rule add fwmark 0x1 lookup 100 2>/dev/null
	ip rule add fwmark 0x4c494e43 lookup 100 2>/dev/null
	ip route add local 0.0.0.0/0 dev lo table 100 2>/dev/null
	# The same for v6, which needs the kernel's v6 policy routing; a kernel
	# without it must not take init down with the rule (init is `set -e`).
	{ ip -6 rule add fwmark 0x1 lookup 100 && ip -6 rule add fwmark 0x4c494e43 lookup 100 && ip -6 route add local ::/0 dev lo table 100; } 2>/dev/null \
		|| echo "INIT ipv6_policy=failed"
	if nft -f /run/lighter.nft 2>/dev/console; then
		echo "INIT streams=on"
	else
		echo "INIT streams=failed"
	fi
	# And into Docker's own rules: Docker sends locally made connections to
	# its port DNATs only when the destination is one of the guest's
	# addresses (`--dst-type LOCAL`), and a Mac address is not, so the
	# agent's connection to a port published there would match none. The
	# agent's connections all carry the inbound mark; Docker's rules decide
	# where each goes, as for every published port. Loopback is left out as
	# Docker leaves it out: a port published on 127.0.0.1 is its userland
	# proxy's, and DNATed from loopback to a container the connection is
	# dropped (every loopback publish in m3's burst test, until excluded).
	# In the background, once Docker has made its chain: the v6 one comes
	# later than the v4, after the rules above are loaded.
	to_docker() {
		(
			tries=0
			until "$1" -t nat -L DOCKER -n >/dev/null 2>&1; do
				tries=$((tries + 1))
				[ "$tries" -ge 120 ] && { echo "INIT published-on-mac=$1-no-chain"; exit 0; }
				sleep 0.5
			done
			"$1" -t nat -C OUTPUT ! -d "$2" -m mark --mark 0x4c494e42 -j DOCKER 2>/dev/null \
				|| "$1" -t nat -I OUTPUT 1 ! -d "$2" -m mark --mark 0x4c494e42 -j DOCKER 2>/dev/console \
				|| echo "INIT published-on-mac=$1-failed"
		) &
	}
	to_docker iptables 127.0.0.0/8
	to_docker ip6tables ::1/128
}

# --- The LAN (0.12) ---------------------------------------------------------
# With `lighter config --lan on`, the VMM adds a second card bridged to one
# of the Mac's own (crates/lighter-vmm/src/lan.rs): eth1, on the user's
# network. It carries the LAN's own subnet, on-link, and multicast, and
# nothing else: the default route, DNS and published ports stay on eth0 and
# the streams, so the Mac's VPN and proxies still apply to everything bound
# for the internet. A multicast route through eth1 is also what makes Home
# Assistant pick eth1 as its default adapter, since it chooses by the source
# address towards 224.0.0.251, and advertise an address devices can reach.
lan="" lan_avoid="" publish="lan"
for arg in $(cat /proc/cmdline); do
	case "$arg" in
	lighter.lan=*) lan="${arg#lighter.lan=}" ;;
	lighter.lan_avoid=*) lan_avoid="${arg#lighter.lan_avoid=}" ;;
	lighter.publish=*) publish="${arg#lighter.publish=}" ;;
	esac
done
if [ -n "$lan" ] && [ -e /sys/class/net/eth1 ]; then
	mkdir -p /run/lighter
	# The LAN's router advertisements give eth1 its IPv6 addresses (the
	# guest forwards, so 2 rather than 1), but not a default route.
	sysctl -q -w net.ipv6.conf.eth1.accept_ra=2 net.ipv6.conf.eth1.accept_ra_defrtr=0 \
		net.ipv4.conf.eth1.rp_filter=0 2>/dev/null || true
	# A machine on the network is reachable from it, and the guest listens
	# on more than a container's ports: new connections reach only what
	# host-network containers listen on (the agent keeps the two sets from
	# the same scan that forwards them from the Mac). Multicast and
	# broadcast are discovery's, and UDP to the ephemeral range reaches
	# only clients' own sockets, which is where an SSDP or LIFX reply goes.
	# Docker's published ports, which its DNAT also applies on eth1, pass
	# only when the publish scope is the LAN.
	forwarded=drop
	[ "$publish" = lan ] && forwarded=accept
	cat > /run/lighter-lan.nft <<NFT
table inet lighter_lan {
	set tcp_ports { type inet_service; }
	set udp_ports { type inet_service; }
	chain input {
		type filter hook input priority filter - 10; policy accept;
		iifname != "eth1" accept
		ct state established,related accept
		meta l4proto { icmp, ipv6-icmp } accept
		udp dport 68 accept
		meta pkttype { broadcast, multicast } accept
		udp dport 32768-60999 accept
		tcp dport @tcp_ports accept
		udp dport @udp_ports accept
		counter drop
	}
	chain forward {
		type filter hook forward priority filter - 10; policy accept;
		iifname "eth1" ct status dnat $forwarded
		iifname "eth1" counter drop
	}
}
NFT
	if nft -f /run/lighter-lan.nft 2>/dev/console; then
		ip link set eth1 up
		ip route add 224.0.0.0/4 dev eth1 2>/dev/null
		if [ "$lan" = dhcp ]; then
			# The address only: routes, DNS and the default are the
			# streams'. An offer of the Mac's own address (Wi-Fi bridges
			# by translating the guest's MAC to the Mac's, and a router
			# that keys leases on it offers the Mac's) is refused.
			cat > /run/lighter/lan-dhcp <<'DHCP'
#!/bin/sh
state=/run/lighter/lan-state
case "$1" in
deconfig|leasefail|nak)
	ip -4 addr flush dev eth1
	echo waiting > "$state"
	;;
bound|renew)
	if [ -n "$LAN_AVOID" ] && [ "$ip" = "$LAN_AVOID" ]; then
		ip -4 addr flush dev eth1
		echo "declined $ip" > "$state"
		exit 0
	fi
	if ! ip -4 addr show dev eth1 | grep -q "inet $ip/"; then
		ip -4 addr flush dev eth1
		ip addr add "$ip/$mask" dev eth1
	fi
	echo "address $ip/$mask" > "$state"
	;;
esac
DHCP
			chmod +x /run/lighter/lan-dhcp
			echo waiting > /run/lighter/lan-state
			(
				while true; do
					LAN_AVOID="$lan_avoid" udhcpc -i eth1 -f -a -R -x hostname:lighter -s /run/lighter/lan-dhcp >/dev/null 2>&1
					sleep 5
				done
			) &
		else
			ip addr add "$lan" dev eth1 && echo "address $lan" > /run/lighter/lan-state
			# Announced, so that the LAN forgets whoever had it last.
			arping -U -c 2 -I eth1 "${lan%/*}" >/dev/null 2>&1 &
		fi
		echo "INIT lan=on mode=$lan"
	else
		echo "INIT lan=failed firewall"
	fi
fi

# `t=` is seconds since the kernel started, for reading a boot's timeline
# off the console (the host's log has no clock for these lines).
echo "INIT ready t=$(cut -d' ' -f1 /proc/uptime)"

# dockerd can die long after it started — containerd failing, a storage driver
# rejecting the data disk — and from outside that is indistinguishable from a
# broken transport: the socket file is still there, and connections are simply
# refused. Saying so, with the log, turns half an hour of bisecting into one
# line on the console.
(
	while kill -0 "$DOCKERD_PID" 2>/dev/null; do
		sleep 5
	done
	echo "INIT dockerd=exited"
	echo "--- dockerd log ---"
	tail -40 /var/log/dockerd.log
	echo "--- end ---"
) &

# PID 1 must not exit. Reaping matters here: dockerd forks, and an unreaped
# child on PID 1 is a zombie that never goes away.
while true; do
	wait || true
	sleep 1
done
