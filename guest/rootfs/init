#!/bin/sh
# PID 1 in the lighter guest.
#
# Not openrc, not systemd. There are four things to do in a fixed order, none of
# them conditional on hardware we might or might not have, and a service manager
# here would add a second of boot and a layer of indirection over a sequence
# that fits on one screen.
#
# The order matters:
#   1. pseudo-filesystems, because everything below reads them
#   2. the data disk, because dockerd's storage driver needs it mounted first
#   3. dockerd, which takes a moment to come up
#   4. the agent, which must not advertise a socket dockerd is not answering yet
set -eu

# The kernel hands init an environment of exactly HOME and TERM — there is no
# PATH. busybox's shell falls back to a default for its own lookups, but never
# exports one, so every child process inherits an environment with no PATH at
# all. dockerd then starts, fails to find containerd, and reports "executable
# file not found in $PATH" about a binary sitting in /usr/bin.
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export HOME=/root

# No `busybox --install -s` here, and it matters. Alpine already ships every
# applet symlink, and busybox resolves its own path through /proc/self/exe —
# which is not mounted yet at this point in init. Without it, the install
# writes a symlink from /bin/busybox to itself, and every applet in the image
# becomes ELOOP. What that looks like from outside is init exiting 127 several
# steps later, at whichever command happened to be next.
#
# The initramfs does need it, because there busybox is the only binary in the
# image and nothing else has made the links.

mount -t proc     proc     /proc
mount -t sysfs    sysfs    /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
mount -t tmpfs    tmpfs    /run
mkdir -p /dev/pts /dev/shm
mount -t devpts devpts /dev/pts 2>/dev/null || true
mount -t tmpfs  tmpfs  /dev/shm

# cgroup v2 only. Docker supports both, and offering v1 as well means the engine
# picks one based on what it finds rather than on what we intended.
mount -t cgroup2 cgroup2 /sys/fs/cgroup 2>/dev/null || true

hostname "$(cat /etc/hostname 2>/dev/null || echo lighter)"
ip link set lo up

# The machine has no RTC, so the guest starts at the epoch. That is not a
# cosmetic problem: every TLS handshake to a registry fails on a certificate
# that is not valid yet, and the error names the certificate rather than the
# clock. The host passes its own time on the command line.
#
# This is a starting point, not timekeeping — it does not survive the host
# sleeping. Resync over vsock is milestone 8's job.
for arg in $(cat /proc/cmdline); do
	case "$arg" in
	lighter.time=*)
		date -s "@${arg#lighter.time=}" >/dev/null 2>&1 \
			&& echo "INIT clock=$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
			|| echo "INIT clock=failed"
		;;
	esac
done

echo "INIT filesystems=ok"

# --- The data disk --------------------------------------------------------
# /dev/vdb is Docker's storage. It is separate from the root disk so that the
# root image can be replaced on upgrade without touching anyone's images, and so
# that the thing that grows is the thing that gets punched back to nothing.
DATA_DEV=/dev/vdb
# The data disk is btrfs, as OrbStack's is: its reflinks make a
# copy_file_range a clone, which is how yarn links a package tree and how cp
# copies one — on ext4 that was a real copy, 1.4 GB per install and its
# writeback, and half of yarn's system time. `lighter.data_fs=ext4|xfs`
# formats a blank disk otherwise, so the alternatives stay measurable.
DATA_FS=btrfs
for arg in $(cat /proc/cmdline); do
	case "$arg" in
	lighter.data_fs=*) DATA_FS="${arg#lighter.data_fs=}" ;;
	esac
done
if [ -b "$DATA_DEV" ]; then
	# A blank disk has no filesystem; making one on first boot is what turns a
	# freshly created sparse file into usable storage with no setup step.
	if ! blkid "$DATA_DEV" >/dev/null 2>&1; then
		# `lighter.data_mkfs=` on the kernel command line adds options to
		# the format — a journal left out, say — for the same reason as the
		# mount options below: to be measured, not guessed at.
		DATA_MKFS=""
		for arg in $(cat /proc/cmdline); do
			case "$arg" in
			lighter.data_mkfs=*) DATA_MKFS="${arg#lighter.data_mkfs=}" ;;
			esac
		done
		echo "INIT formatting=$DATA_DEV fs=$DATA_FS mkfs=$DATA_MKFS"
		if [ "$DATA_FS" = btrfs ]; then
			# Single metadata: the default duplicates it against a bad
			# sector, and this disk is a file whose sectors are the
			# Mac's to lose or keep.
			# shellcheck disable=SC2086
			mkfs.btrfs -q -f -L lighter-data -m single $(echo "$DATA_MKFS" | tr ',' ' ') "$DATA_DEV"
		elif [ "$DATA_FS" = xfs ]; then
			# shellcheck disable=SC2086
			mkfs.xfs -q -f -L lighter-data $(echo "$DATA_MKFS" | tr ',' ' ') "$DATA_DEV"
		else
			# shellcheck disable=SC2086
			mke2fs -q -t ext4 -L lighter-data $(echo "$DATA_MKFS" | tr ',' ' ') "$DATA_DEV"
		fi
	fi
	# Journaling on Docker's disk is metadata-only, with no write barriers
	# and a thirty-second commit — the same crash semantics as OrbStack's
	# nodatacow btrfs, chosen to match it: after a VMM crash a file written
	# in the last moments may hold stale blocks rather than be short. The
	# barrier costs nothing here (the guest's flush is a host fsync into the
	# Mac's page cache either way) and ordered data cost yarn twelve percent
	# on its own disk. Anything that must survive a crash fsyncs, and fsync
	# is honored.
	#
	# Discard is deliberately not a mount option. Online discard is issued
	# from the journal commit, and in writeback mode that turned deleting a
	# package tree from a third of a second into three: the trim is batched
	# instead, by the fstrim loop below, which is what makes deleting an
	# image give space back to macOS at all — each trimmed range reaches
	# virtio-blk as a discard and becomes a hole punch in the host file.
	#
	# `lighter.data_opts=` on the kernel command line replaces these
	# outright, so a different setting can be measured without a rebuild of
	# this image.
	# The options follow the filesystem the disk actually carries, not the
	# one a blank disk would be given: a disk formatted before the default
	# changed is still ext4, and mounting it with btrfs's options fails —
	# after which dockerd starts on the root filesystem and dies there.
	DATA_TYPE="$(blkid -o value -s TYPE "$DATA_DEV" 2>/dev/null || echo "$DATA_FS")"
	echo "INIT data_fs=${DATA_TYPE:-unknown}"
	DATA_OPTS=noatime,nobarrier,commit=30,data=writeback
	case "$DATA_TYPE" in
	# nodatacow, as OrbStack mounts it: data is written in place and not
	# checksummed, which keeps a database's file from fragmenting into a
	# thousand extents and gives the crash semantics described above.
	# Clones still share extents; the first write to a shared one copies.
	btrfs) DATA_OPTS=noatime,nodatacow,commit=30,thread_pool=1 ;;
	xfs) DATA_OPTS=noatime ;;
	esac
	for arg in $(cat /proc/cmdline); do
		case "$arg" in
		lighter.data_opts=*) DATA_OPTS="${arg#lighter.data_opts=}" ;;
		esac
	done
	echo "INIT data_opts=$DATA_OPTS"
	# No I/O scheduler on a virtual disk: the host's page cache is behind it
	# and there is nothing to reorder for. mq-deadline, the kernel's default
	# for a single-queue virtio-blk, cost a sync of twenty thousand fresh
	# files twice its time (330 ms to 160).
	echo none > "/sys/block/${DATA_DEV#/dev/}/queue/scheduler" 2>/dev/null
	if mount -o "$DATA_OPTS" "$DATA_DEV" /mnt/data; then
		echo "INIT data=mounted"
		mkdir -p /mnt/data/docker
		mount --bind /mnt/data/docker /var/lib/docker
		# The first trim after a mount covers every free block group, so
		# it is done here, before Docker has anything in flight, and timed
		# into the boot log. Trimmed ranges are cheap to re-trim (ext4
		# remembers which groups it has done), so the short period after
		# that costs nothing on an idle machine and a deleted image is back
		# with macOS within minutes rather than at the next reboot.
		T0=$(cut -d' ' -f1 /proc/uptime)
		fstrim /mnt/data >/dev/null 2>&1 || true
		T1=$(cut -d' ' -f1 /proc/uptime)
		echo "INIT fstrim=$(echo "$T1 $T0" | awk '{printf "%dms", ($1-$2)*1000}')"
		# `lighter.fstrim_period=` (seconds; 0 disables the loop) is for
		# measuring the loop's cost against a run.
		FSTRIM_PERIOD=300
		for arg in $(cat /proc/cmdline); do
			case "$arg" in
			lighter.fstrim_period=*) FSTRIM_PERIOD="${arg#lighter.fstrim_period=}" ;;
			esac
		done
		if [ "$FSTRIM_PERIOD" -gt 0 ]; then
			(while sleep "$FSTRIM_PERIOD"; do fstrim /mnt/data >/dev/null 2>&1; done) &
		fi
	else
		echo "INIT data=mount-failed"
	fi
else
	echo "INIT data=absent"
fi

# --- Running x86-64 containers --------------------------------------------
# `binfmt_misc` is how Linux learns that an ELF it cannot execute should be
# handed to an interpreter instead. With this registered, `docker run
# --platform linux/amd64` works with no further arrangement: the kernel sees an
# x86-64 header, and runs qemu against it.
#
# The `F` flag is the load-bearing one. Without it the kernel resolves the
# interpreter path at exec time — inside the container's mount namespace, where
# /usr/bin/qemu-x86_64 does not exist. With it, the interpreter is opened once,
# here, and the open file is what every later exec uses. That is the difference
# between this working everywhere and working only outside containers.
if mount -t binfmt_misc binfmt_misc /proc/sys/fs/binfmt_misc 2>/dev/null; then
	# `%s` and not a bare format string, because the escapes must reach the
	# kernel *as text*: binfmt_misc unquotes `\xHH` itself. Letting the shell
	# expand them first writes real NUL bytes, `write` stops at the first one,
	# and the kernel registers a truncated magic — which then matches every
	# 64-bit ELF, hands each one to an x86 emulator, and turns the next
	# command in this script into `exit 127`.
	printf '%s\n' ':qemu-x86_64:M::\x7fELF\x02\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\x3e\x00:\xff\xff\xff\xff\xff\xfe\xfe\x00\xff\xff\xff\xff\xff\xff\xff\xff\xfe\xff\xff\xff:/usr/bin/qemu-x86_64:FP' \
		> /proc/sys/fs/binfmt_misc/register 2>/dev/null || true
	# Checked by looking, not by the exit status of a redirect into procfs,
	# which is not a reliable report of whether the kernel accepted the entry.
	if [ -f /proc/sys/fs/binfmt_misc/qemu-x86_64 ]; then
		echo "INIT binfmt=x86_64"
	else
		echo "INIT binfmt=failed"
	fi
else
	echo "INIT binfmt=unavailable"
fi

# --- Shared directories ---------------------------------------------------
# Mounted before dockerd, because a container's bind mount resolves against
# this namespace and a share that appears later is a path the engine already
# decided did not exist.
#
# The tag is the only handle the guest has on a virtio-fs device — nothing
# enumerates them — so the host names each one on the command line.
for arg in $(cat /proc/cmdline); do
	case "$arg" in
	lighter.share=*)
		spec=${arg#lighter.share=}
		tag=${spec%%:*}
		at=${spec#*:}
		mkdir -p "$at"
		if mount -t virtiofs "$tag" "$at"; then
			echo "INIT share=$tag at=$at"
		else
			echo "INIT share=$tag at=$at failed"
		fi
		;;
	esac
done

# --- Networking -----------------------------------------------------------
# A socket may ask for a send buffer up to this; the agent asks for 8 MiB
# on every stream, because a vsock packet's memory stays charged to its
# socket until the host has taken it off the ring, and the default ceiling
# is under one packet.
sysctl -q -w net.core.wmem_max=16777216 net.core.rmem_max=16777216 2>/dev/null || true
if [ -e /sys/class/net/eth0 ]; then
	ip link set eth0 up
	udhcpc -i eth0 -n -q -t 8 -T 2 >/dev/null 2>&1 && echo "INIT dhcp=ok" || echo "INIT dhcp=failed"
fi

# --- The engine -----------------------------------------------------------
# dockerd starts and supervises its own containerd. Naming one with
# --containerd instead points it at a socket nothing is listening on, and it
# waits for a daemon that is never coming.
# --iptables is left on: Docker's own bridge networking needs it, and the
# kernel carries the netfilter modules for exactly this.
#
# --userland-proxy=false because Alpine's docker-engine ships no docker-proxy
# binary, and dockerd refuses to start rather than degrade ("userland-proxy is
# enabled, but userland-proxy-path is not set"). Turning it off is the right
# answer regardless: publishing a port then rests on netfilter DNAT alone, and
# the host side of the journey is gvproxy's job, not a hairpin process here.
#
# --mtu is the link's own, read back from eth0: the host terminates every
# flow on its side of the link, so the only thing the number decides is how
# many frames a byte costs between here and there, and a bridge left at 1500
# would have every container segment at 1460 whatever the link could carry.
mkdir -p /var/log
link_mtu=$(cat /sys/class/net/eth0/mtu 2>/dev/null || echo 1500)
dockerd \
	--host=unix:///run/docker.sock \
	--data-root=/var/lib/docker \
	--storage-driver=overlay2 \
	--userland-proxy=false \
	--mtu="$link_mtu" \
	>/var/log/dockerd.log 2>&1 &
DOCKERD_PID=$!

# Waiting for the socket rather than sleeping: dockerd's start time depends on
# what it finds on the data disk, so a fixed sleep is either too short on a full
# disk or wasted on an empty one.
#
# The liveness check is not belt-and-braces. dockerd creates its socket early
# and can die during later setup, leaving a socket file that accepts nothing —
# so waiting on the file alone reports "ready" for a daemon that is already
# gone, and the failure resurfaces much later as a bare ECONNREFUSED.
waited=0
dockerd_state=timeout
while [ "$waited" -lt 60 ]; do
	if ! kill -0 "$DOCKERD_PID" 2>/dev/null; then
		dockerd_state=died
		break
	fi
	if [ -S /run/docker.sock ]; then
		dockerd_state=ready
		break
	fi
	sleep 1
	waited=$((waited + 1))
done

echo "INIT dockerd=$dockerd_state after=${waited}s"
if [ "$dockerd_state" != ready ]; then
	echo "--- dockerd log ---"
	tail -30 /var/log/dockerd.log
	echo "--- end ---"
fi

# --- The agent ------------------------------------------------------------
# Started last, on purpose: it is what the host connects to, and advertising it
# before dockerd answers turns a slow start into a connection refused.
/sbin/lighter-agent --port 2375 --to /run/docker.sock &

# The control channel, on its own port. The host uses it to put the clock right
# after the Mac has slept: the machine has no real-time clock, so a guest whose
# host suspended for an hour wakes an hour behind, and everything that checks a
# certificate starts failing with an error about the certificate.
/sbin/lighter-agent --port 2376 --control &

# --- Streams --------------------------------------------------------------
# With `lighter.streams` on the command line, every TCP connection that
# would leave through eth0 — from a container or from this machine — is
# redirected to the agent, which carries it to the host as a vsock stream;
# the host's kernel makes the real connection. TCP only: UDP and ICMP keep
# going out the network device. `fib daddr oif` is the routing decision
# itself, so anything bound for a container, this machine, or a bridge is
# left alone without listing subnets that Docker changes at will.
if grep -qw "lighter.streams" /proc/cmdline; then
	/sbin/lighter-agent --tcp-proxy 15201 &
	/sbin/lighter-agent --inbound 2378 &
	# The ruleset goes through a file: busybox's shell does not take a
	# heredoc on an `if` line the way bash does, and the rule that had
	# worked by hand failed at every boot.
	cat > /run/lighter.nft <<'EOF'
table inet lighter {
	chain prerouting {
		type nat hook prerouting priority dstnat - 10; policy accept;
		meta l4proto tcp fib daddr oif "eth0" redirect to :15201
	}
	chain output {
		type nat hook output priority dstnat - 10; policy accept;
		meta l4proto tcp oifname "eth0" redirect to :15201
	}
}
EOF
	if nft -f /run/lighter.nft 2>/dev/console; then
		echo "INIT streams=on"
	else
		echo "INIT streams=failed"
	fi
fi

echo "INIT ready"

# dockerd can die long after it started — containerd failing, a storage driver
# rejecting the data disk — and from outside that is indistinguishable from a
# broken transport: the socket file is still there, and connections are simply
# refused. Saying so, with the log, turns half an hour of bisecting into one
# line on the console.
(
	while kill -0 "$DOCKERD_PID" 2>/dev/null; do
		sleep 5
	done
	echo "INIT dockerd=exited"
	echo "--- dockerd log ---"
	tail -40 /var/log/dockerd.log
	echo "--- end ---"
) &

# PID 1 must not exit. Reaping matters here: dockerd forks, and an unreaped
# child on PID 1 is a zombie that never goes away.
while true; do
	wait || true
	sleep 1
done
