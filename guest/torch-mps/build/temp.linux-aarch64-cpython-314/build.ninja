ninja_required_version = 1.3
cxx = c++

cflags = -fno-strict-overflow -Wsign-compare -DNDEBUG -g -O2 -Wall -fPIC -I/home/nick/venv/lib/python3.14/site-packages/torch/include -I/home/nick/venv/lib/python3.14/site-packages/torch/include/torch/csrc/api/include -I/home/nick/venv/include -I/usr/include/python3.14 -c
post_cflags = -O2 -DTORCH_API_INCLUDE_EXTENSION_H -DTORCH_EXTENSION_NAME=_lighter_mps -std=c++20
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc







build /home/nick/lighter/guest/torch-mps/build/temp.linux-aarch64-cpython-314/csrc/lighter_mps.o: compile /home/nick/lighter/guest/torch-mps/csrc/lighter_mps.cpp








