#!/bin/busybox sh
# PID 1 for the lighter boot initramfs.
#
# The interpreter is busybox by absolute path, not /bin/sh: this script *is*
# what creates /bin/sh, on the line below. A `#!/bin/sh` shebang here means
# execve fails with ENOENT and the kernel panics with "No working init found",
# which reads like a missing initramfs rather than a missing symlink.
#
# Modes are chosen from the kernel command line so one image serves all of them,
# and the milestone gates exercise the same guest a human gets interactively.

/bin/busybox --install -s /bin 2>/dev/null

mount -t proc     proc     /proc
mount -t sysfs    sysfs    /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null

cmdline=$(cat /proc/cmdline)

# 64 MiB of a fixed byte, regenerated identically on any boot, so a later boot
# can verify what an earlier one wrote.
PATTERN_MIB=64
make_pattern() {
	dd if=/dev/zero bs=1M count=$PATTERN_MIB 2>/dev/null | tr '\000' '\125' > "$1"
}

# Mounts every share the host described on the command line.
#
# The tag is the only thing that identifies a virtio-fs device to the guest, and
# nothing enumerates them: the driver binds a device, and a mount by tag is how
# you reach it. Passing the list on the command line rather than probing keeps
# the guest from having to guess which of several shares is which.
mount_shares() {
	for arg in $cmdline; do
		case "$arg" in
		lighter.share=*)
			spec=${arg#lighter.share=}
			tag=${spec%%:*}
			at=${spec#*:}
			mkdir -p "$at"
			if mount -t virtiofs "$tag" "$at"; then
				echo "SHARE tag=$tag at=$at mounted"
			else
				echo "SHARE tag=$tag at=$at FAILED"
			fi
			;;
		esac
	done
}

case "$cmdline" in
*lighter.fstest=*)
	mode=${cmdline#*lighter.fstest=}
	mode=${mode%% *}
	echo "FSTEST mode=$mode"
	mount_shares
	/sbin/lighter-fstest "$mode" /mnt/share
	status=$?
	echo "FSTEST exit=$status"
	# The durability mode never returns: the host kills the VMM mid-flight,
	# which is the whole point of it. Every other mode powers off cleanly so
	# the gate does not have to.
	sync
	poweroff -f
	;;

*lighter.disktest=write*)
	echo "DISKTEST mode=write"
	make_pattern /tmp/pattern
	if dd if=/tmp/pattern of=/dev/vda bs=1M conv=fsync 2>/dev/null; then
		echo "DISKTEST wrote_mib=$PATTERN_MIB"
	else
		echo "DISKTEST write=failed"
	fi
	sync
	poweroff -f
	;;

*lighter.disktest=discard*)
	echo "DISKTEST mode=discard"

	# The disk was written by a previous boot of this same image. If the bytes
	# are still there, virtio-blk persisted them to the host file and read them
	# back across a full machine restart.
	make_pattern /tmp/pattern
	dd if=/dev/vda of=/tmp/readback bs=1M count=$PATTERN_MIB 2>/dev/null
	if cmp -s /tmp/pattern /tmp/readback; then
		echo "DISKTEST persisted=ok"
	else
		echo "DISKTEST persisted=corrupt"
	fi

	# Hand the blocks back. This becomes a hole punch on the host image, which
	# is the entire point: a disk that only ever grows is the thing lighter
	# exists to avoid.
	if blkdiscard /dev/vda 2>/dev/null; then
		echo "DISKTEST discard=ok"
	else
		echo "DISKTEST discard=failed"
	fi
	sync
	poweroff -f
	;;

*lighter.vsocktest*)
	echo "VSOCKTEST mode=start"

	# The driver binds to the virtio-vsock slot and creates this; without it
	# nothing below can even be attempted.
	if [ -e /dev/vsock ]; then
		echo "VSOCKTEST device=ok"
	else
		echo "VSOCKTEST device=missing"
		poweroff -f
	fi

	# The agent prints its own listening line once the port is bound, which is
	# what the host waits for before connecting. Backgrounded because it serves
	# until the machine stops.
	/sbin/lighter-agent --port 2375 --echo &

	# The host runs its checks against the agent; the guest's part is just to
	# stay up long enough. Bounded rather than forever, so a host that never
	# connects fails the gate instead of hanging it.
	sleep 90
	echo "VSOCKTEST done"
	poweroff -f
	;;

*lighter.nettest*)
	echo "NETTEST mode=start"

	# The device tree named a virtio-net slot; this is where we find out whether
	# the driver bound to it.
	if [ -e /sys/class/net/eth0 ]; then
		echo "NETTEST link=eth0 mac=$(cat /sys/class/net/eth0/address)"
	else
		echo "NETTEST link=missing"
		poweroff -f
	fi

	ip link set eth0 up
	ip link set lo up

	# DHCP rather than a static address, because it is the honest end-to-end
	# test: a broadcast out through the transmit queue, a unicast reply back
	# through the receive queue, and a userspace stack that agreed to both.
	if udhcpc -i eth0 -n -q -t 8 -T 2 >/dev/null 2>&1; then
		echo "NETTEST dhcp=ok addr=$(ip -4 -o addr show eth0 | awk '{print $4}')"
	else
		echo "NETTEST dhcp=failed"
	fi

	echo "NETTEST route=$(ip route show default | head -1)"

	# The gateway is gvproxy itself, so this proves frames make the round trip
	# without depending on anything outside the host.
	if ping -c 3 -W 2 192.168.127.1 >/dev/null 2>&1; then
		echo "NETTEST gateway_ping=ok"
	else
		echo "NETTEST gateway_ping=failed"
	fi

	# Name resolution goes to gvproxy's resolver, which follows the Mac's own
	# DNS configuration — including whatever a VPN has done to it.
	if nslookup example.com >/dev/null 2>&1; then
		echo "NETTEST dns=ok"
	else
		echo "NETTEST dns=failed"
	fi

	# Real egress: a TCP connection terminated on a host socket and back.
	if wget -q -T 15 -O /tmp/egress http://example.com/ 2>/dev/null; then
		echo "NETTEST egress=ok bytes=$(wc -c < /tmp/egress)"
	else
		echo "NETTEST egress=failed"
	fi

	# A listener for the host to reach through a port forward. The gate connects
	# to it from macOS while this is running, which is the other direction.
	case "$cmdline" in
	*lighter.nettest=listen*)
		echo "NETTEST listening=8000"
		# One connection, then done: the gate makes exactly one request, and a
		# guest that never exits is a gate that hangs instead of failing.
		echo "hello from lighter" | nc -l -p 8000 >/dev/null 2>&1
		echo "NETTEST served=ok"
		;;
	esac

	echo "NETTEST done"
	poweroff -f
	;;

*lighter.selftest*)
	echo
	echo "  lighter guest"
	echo "  $(uname -srm)"
	echo

	# Each line is checked by a milestone gate. The point is not that the
	# kernel booted — the banner already proved that — but that the machine we
	# described in the device tree is the machine it found.
	echo "SELFTEST cpus=$(grep -c ^processor /proc/cpuinfo)"
	echo "SELFTEST memtotal_kb=$(awk '/MemTotal/ {print $2}' /proc/meminfo)"

	if [ -d /proc/device-tree ]; then
		echo "SELFTEST dt=ok"
	else
		echo "SELFTEST dt=missing"
	fi

	# A PL011 the driver actually bound to, not just an earlycon: if amba-pl011
	# had failed to probe, output would have stopped when the kernel handed over.
	if [ -e /sys/class/tty/ttyAMA0 ]; then
		echo "SELFTEST console=ttyAMA0"
	else
		echo "SELFTEST console=missing"
	fi

	# A timer that never ticks is the classic silent VMM bug: everything works
	# until something sleeps.
	before=$(cut -d' ' -f1 /proc/uptime)
	sleep 1
	after=$(cut -d' ' -f1 /proc/uptime)
	echo "SELFTEST uptime_before=$before uptime_after=$after"
	if [ "$before" != "$after" ]; then
		echo "SELFTEST timer=ok"
	else
		echo "SELFTEST timer=stopped"
	fi

	# virtio: every device that probed leaves a bound driver behind.
	for dev in /sys/bus/virtio/devices/virtio*; do
		[ -e "$dev" ] || continue
		id=$(cat "$dev/device" 2>/dev/null)
		drv=$(basename "$(readlink "$dev/driver" 2>/dev/null)" 2>/dev/null)
		echo "SELFTEST virtio id=$id driver=${drv:-none}"
	done

	if [ -b /dev/vda ]; then
		echo "SELFTEST blockdev=vda size_sectors=$(cat /sys/block/vda/size)"

		# Exercise the disk for real rather than trusting that it appeared.
		dd if=/dev/urandom of=/tmp/pattern bs=4096 count=64 2>/dev/null
		dd if=/tmp/pattern of=/dev/vda bs=4096 count=64 conv=fsync 2>/dev/null
		dd if=/dev/vda of=/tmp/readback bs=4096 count=64 2>/dev/null
		if cmp -s /tmp/pattern /tmp/readback; then
			echo "SELFTEST blockio=ok"
		else
			echo "SELFTEST blockio=corrupt"
		fi
	else
		echo "SELFTEST blockdev=missing"
	fi

	# Without virtio-rng this either blocks or reports a nearly empty pool.
	echo "SELFTEST entropy_avail=$(cat /proc/sys/kernel/random/entropy_avail 2>/dev/null)"

	echo "SELFTEST done"
	poweroff -f
	;;
esac

echo "Type 'poweroff -f' to stop the machine."
echo
exec setsid cttyhack /bin/sh
